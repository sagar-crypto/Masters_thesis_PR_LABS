   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Assumes `work` exists from the previous notebook analysis.\n",
    "# If it does not, rerun your CSV loading/filtering cell first.\n",
    "\n",
    "p_col = \"d_mod_takagi_tf_only_p_both_mean_pct\"\n",
    "m_col = \"d_mod_takagi_tf_only_m_both_mean_pct\"\n",
    "\n",
    "diag = work.copy()\n",
    "\n",
    "# Same fair one-row-per-sample selection.\n",
    "if \"status\" in diag.columns and (diag[\"status\"] == \"fault_start\").any():\n",
    "    diag = diag.loc[diag[\"status\"].eq(\"fault_start\")].copy()\n",
    "\n",
    "sort_cols = [c for c in [\"sample_id\", \"window_idx\", \"dt_start\"] if c in diag.columns]\n",
    "if sort_cols:\n",
    "    diag = diag.sort_values(sort_cols)\n",
    "\n",
    "diag = diag.drop_duplicates(subset=[\"sample_id\"], keep=\"first\").copy()\n",
    "\n",
    "for col in [\"y_fault_location\", p_col, m_col]:\n",
    "    diag[col] = pd.to_numeric(diag[col], errors=\"coerce\")\n",
    "\n",
    "# Only SLG samples where both signs produced a finite output.\n",
    "slg = diag.loc[\n",
    "    diag[\"case\"].isin([\"slg_a\", \"slg_b\", \"slg_c\"])\n",
    "].copy()\n",
    "\n",
    "slg[\"p_abs_error_pp\"] = (\n",
    "    slg[p_col] - slg[\"y_fault_location\"]\n",
    ").abs()\n",
    "\n",
    "slg[\"m_abs_error_pp\"] = (\n",
    "    slg[m_col] - slg[\"y_fault_location\"]\n",
    ").abs()\n",
    "\n",
    "slg[\"best_sign\"] = np.where(\n",
    "    slg[\"p_abs_error_pp\"] <= slg[\"m_abs_error_pp\"],\n",
    "    \"+T\",\n",
    "    \"-T\",\n",
    ")\n",
    "\n",
    "summary = (\n",
    "    slg.groupby(\"case\", observed=True)\n",
    "    .agg(\n",
    "        n=(\"sample_id\", \"size\"),\n",
    "        p_mae_pp=(\"p_abs_error_pp\", \"mean\"),\n",
    "        m_mae_pp=(\"m_abs_error_pp\", \"mean\"),\n",
    "        p_median_pp=(\"p_abs_error_pp\", \"median\"),\n",
    "        m_median_pp=(\"m_abs_error_pp\", \"median\"),\n",
    "        p_better_rate_pct=(\n",
    "            \"best_sign\",\n",
    "            lambda s: 100.0 * (s == \"+T\").mean(),\n",
    "        ),\n",
    "        m_better_rate_pct=(\n",
    "            \"best_sign\",\n",
    "            lambda s: 100.0 * (s == \"-T\").mean(),\n",
    "        ),\n",
    "    )\n",
    ")\n",
    "\n",
    "summary[\"best_mae_if_casewise_sign_selected\"] = summary[\n",
    "    [\"p_mae_pp\", \"m_mae_pp\"]\n",
    "].min(axis=1)\n",
    "\n",
    "summary[\"recommended_sign\"] = np.where(\n",
    "    summary[\"p_mae_pp\"] <= summary[\"m_mae_pp\"],\n",
    "    \"+T\",\n",
    "    \"-T\",\n",
    ")\n",
    "\n",
    "print(\"Modified Takagi angle-sign comparison by SLG phase:\")\n",
    "display(summary.round(3))\n",
    "\n",
    "# Inspect samples where +T and -T give materially different outcomes.\n",
    "slg[\"error_improvement_if_minus_t\"] = (\n",
    "    slg[\"p_abs_error_pp\"] - slg[\"m_abs_error_pp\"]\n",
    ")\n",
    "\n",
    "print(\"\\nSamples where -T is much better than +T:\")\n",
    "display(\n",
    "    slg.sort_values(\"error_improvement_if_minus_t\", ascending=False)[\n",
    "        [\n",
    "            \"sample_id\",\n",
    "            \"case\",\n",
    "            \"y_fault_location\",\n",
    "            p_col,\n",
    "            m_col,\n",
    "            \"p_abs_error_pp\",\n",
    "            \"m_abs_error_pp\",\n",
    "            \"error_improvement_if_minus_t\",\n",
    "        ]\n",
    "    ].head(25)\n",
    ")\n",
    "\n",
    "print(\"\\nSamples where +T is much better than -T:\")\n",
    "display(\n",
    "    slg.sort_values(\"error_improvement_if_minus_t\", ascending=True)[\n",
    "        [\n",
    "            \"sample_id\",\n",
    "            \"case\",\n",
    "            \"y_fault_location\",\n",
    "            p_col,\n",
    "            m_col,\n",
    "            \"p_abs_error_pp\",\n",
    "            \"m_abs_error_pp\",\n",
    "            \"error_improvement_if_minus_t\",\n",
    "        ]\n",
    "    ].head(25)\n",
    ")\n",
    "\n",
    "# Plot only the case-wise MAEs.\n",
    "plot_df = summary.reset_index()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(7, 4))\n",
    "x = np.arange(len(plot_df))\n",
    "width = 0.35\n",
    "\n",
    "ax.bar(x - width / 2, plot_df[\"p_mae_pp\"], width, label=\"+T\")\n",
    "ax.bar(x + width / 2, plot_df[\"m_mae_pp\"], width, label=\"-T\")\n",
    "\n",
    "ax.set_xticks(x)\n",
    "ax.set_xticklabels(plot_df[\"case\"])\n",
    "ax.set_ylabel(\"MAE (percentage points)\")\n",
    "ax.set_title(\"Modified Takagi sign choice by SLG fault phase\")\n",
    "ax.grid(axis=\"y\", alpha=0.3)\n",
    "ax.legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
