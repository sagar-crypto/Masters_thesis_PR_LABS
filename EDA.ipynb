   "source": [
    "prior_names = list(available_priors.keys())\n",
    "prior_cols = list(available_priors.values())\n",
    "\n",
    "err_mat = np.stack(\n",
    "    [(df4[target_col] - df4[col]).abs().to_numpy() for col in prior_cols],\n",
    "    axis=1,\n",
    ")\n",
    "\n",
    "oracle_err = err_mat.min(axis=1)\n",
    "oracle_idx = err_mat.argmin(axis=1)\n",
    "\n",
    "df4[\"oracle_prior_abs_err_pp\"] = 100 * oracle_err\n",
    "df4[\"oracle_prior_name\"] = [prior_names[i] for i in oracle_idx]\n",
    "\n",
    "oracle_line_summary = (\n",
    "    df4.groupby(line_col)\n",
    "       .agg(\n",
    "           n=(line_col, \"size\"),\n",
    "           selected_caseaware_mae_pp=(\"d_phys_real_pct\", lambda x: 100 * (df4.loc[x.index, target_col] - x).abs().mean()),\n",
    "           oracle_prior_mae_pp=(\"oracle_prior_abs_err_pp\", \"mean\"),\n",
    "       )\n",
    "       .reset_index()\n",
    ")\n",
    "\n",
    "oracle_line_summary[\"possible_prior_selection_gain_pp\"] = (\n",
    "    oracle_line_summary[\"selected_caseaware_mae_pp\"]\n",
    "    - oracle_line_summary[\"oracle_prior_mae_pp\"]\n",
    ")\n",
    "\n",
    "oracle_line_summary.round(2)"
   ]
  },
