    "def find_col(df, possible_names, contains_all=None):\n",
    "    for name in possible_names:\n",
    "        if name in df.columns:\n",
    "            return name\n",
    "    \n",
    "    if contains_all is not None:\n",
    "        for c in df.columns:\n",
    "            cl = c.lower()\n",
    "            if all(x.lower() in cl for x in contains_all):\n",
    "                return c\n",
    "    \n",
    "    return None\n",
    "\n",
    "case_col_old = find_col(old_case_raw, [\"case\", \"group\", \"subgroup\", \"fault_case\"])\n",
    "case_col_new = find_col(new_case_raw, [\"case\", \"group\", \"subgroup\", \"fault_case\"])\n",
    "\n",
    "n_col_old = find_col(old_case_raw, [\"n\", \"count\", \"support\"])\n",
    "n_col_new = find_col(new_case_raw, [\"n\", \"count\", \"support\"])\n",
    "\n",
    "old_mae_cols = [c for c in old_case_raw.columns if \"mae\" in c.lower()]\n",
    "new_mae_cols = [c for c in new_case_raw.columns if \"mae\" in c.lower()]\n",
    "\n",
    "print(\"case_col_old:\", case_col_old)\n",
    "print(\"case_col_new:\", case_col_new)\n",
    "print(\"n_col_old:\", n_col_old)\n",
    "print(\"n_col_new:\", n_col_new)\n",
    "\n",
    "print(\"\\nOld MAE columns:\", old_mae_cols)\n",
    "print(\"New MAE columns:\", new_mae_cols)"
   ]
