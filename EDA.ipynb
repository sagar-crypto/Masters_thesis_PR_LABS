    "\n",
    "print(\"\\nAvailability by case:\")\n",
    "print(\n",
    "    df.groupby(\"case\")[\"is_mod_takagi_tf_only_available\"]\n",
    "      .mean()\n",
    "      .rename(\"available_rate\")\n",
    ")\n",
    "\n",
    "df.to_csv(out_csv, index=False)\n",
