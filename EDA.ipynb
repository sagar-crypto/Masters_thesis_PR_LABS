    "operator_csv = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_line_caseaware_takagi_prior.csv\"\n",
    "op = pd.read_csv(operator_csv)\n",
    "\n",
    "op_lines = (\n",
    "    op[[\"y_fault_line\", \"r1\", \"x1\", \"r0\", \"x0\", \"line_len_km\"]]\n",
    "    .drop_duplicates()\n",
    "    .sort_values(\"y_fault_line\")\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "graph_line_rows = []\n",
    "for u, v, key, attr in G.edges(keys=True, data=True):\n",
    "    pdict = attr.get(f\"{key}_param_dict\", {})\n",
    "    if \"rline\" not in pdict:\n",
    "        continue\n",
    "    \n",
    "    if str(key).startswith(\"MainLn\"):\n",
    "        graph_line_rows.append({\n",
    "            \"y_fault_line\": key,\n",
    "            \"graph_r1\": float(pdict[\"rline\"]),\n",
    "            \"graph_x1\": float(pdict[\"xline\"]),\n",
    "            \"graph_r0\": float(pdict[\"rline0\"]),\n",
    "            \"graph_x0\": float(pdict[\"xline0\"]),\n",
    "            \"graph_length\": float(pdict[\"length\"]),\n",
    "        })\n",
    "\n",
    "graph_lines = pd.DataFrame(graph_line_rows).sort_values(\"y_fault_line\").reset_index(drop=True)\n",
    "\n",
    "cmp = op_lines.merge(graph_lines, on=\"y_fault_line\", how=\"inner\")\n",
    "\n",
    "for a, b in [\n",
    "    (\"r1\", \"graph_r1\"),\n",
    "    (\"x1\", \"graph_x1\"),\n",
    "    (\"r0\", \"graph_r0\"),\n",
    "    (\"x0\", \"graph_x0\"),\n",
    "]:\n",
    "    cmp[f\"diff_{a}\"] = cmp[a] - cmp[b]\n",
    "\n",
    "display(cmp)\n",
    "\n",
    "print(\"Max absolute differences:\")\n",
    "for c in [\"diff_r1\", \"diff_x1\", \"diff_r0\", \"diff_x0\"]:\n",
    "    print(c, cmp[c].abs().max())"
   ]
  },
