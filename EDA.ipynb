    ")\n",
    "\n",
    "df = pd.read_csv(csv_path, low_memory=False)\n",
    "\n",
    "print(\"Loaded:\", csv_path.name)\n",
    "print(\"Shape:\", df.shape)\n",
    "\n",
    "two_ended_cols = [c for c in df.columns if \"two_ended\" in c.lower()]\n",
    "print(\"\\nTwo-ended columns:\")\n",
    "print(two_ended_cols)\n",
    "\n",
    "print(\"\\nReason counts:\")\n",
    "for col in [\n",
    "    \"two_ended_posseq_plus_reason\",\n",
    "    \"two_ended_posseq_minus_reason\",\n",
    "]:\n",
    "    if col in df.columns:\n",
    "        print(f\"\\n{col}\")\n",
    "        print(df[col].value_counts(dropna=False))\n",
    "\n",
    "print(\"\\nFirst rows:\")\n",
    "preview_cols = [\n",
    "    c for c in [\n",
    "        \"sample_id\",\n",
