   "source": [
    "SAMPLE_ALIASES = {\n",
    "    \"sample_id\",\n",
    "    \"event_id\",\n",
    "    \"physical_event_id\",\n",
    "    \"fault_event_id\",\n",
    "}\n",
    "\n",
    "TARGET_ALIASES = {\n",
    "    \"y_true_pct\",\n",
    "    \"y_true\",\n",
    "    \"target\",\n",
    "    \"target_pct\",\n",
    "    \"y_fault_location\",\n",
    "}\n",
    "\n",
    "PREDICTION_ALIASES = {\n",
    "    \"y_pred_pct\",\n",
    "    \"y_pred\",\n",
    "    \"prediction\",\n",
    "    \"prediction_pct\",\n",
    "    \"pred\",\n",
    "    \"final_prediction_pct\",\n",
    "    \"model_prediction_pct\",\n",
    "}\n",
    "\n",
    "FOLD_ALIASES = {\n",
    "    \"fold\",\n",
    "    \"outer_fold\",\n",
    "    \"test_fold\",\n",
    "    \"cv_fold\",\n",
    "    \"fold_idx\",\n",
    "}\n",
    "\n",
    "\n",
    "def normalized_columns(path: Path) -> dict[str, str]:\n",
    "    columns = pq.ParquetFile(\n",
    "        path\n",
    "    ).schema_arrow.names\n",
    "\n",
    "    return {\n",
    "        normalize_name(column): column\n",
    "        for column in columns\n",
    "    }\n",
    "\n",
    "\n",
    "def contains_alias(\n",
    "    normalized_column_map: dict[str, str],\n",
    "    aliases: set[str],\n",
    ") -> bool:\n",
    "    normalized_aliases = {\n",
    "        normalize_name(alias)\n",
    "        for alias in aliases\n",
    "    }\n",
    "\n",
    "    return bool(\n",
    "        set(normalized_column_map)\n",
    "        & normalized_aliases\n",
    "    )\n",
    "\n",
    "\n",
    "double_parquets = sorted(\n",
    "    DOUBLE_RUN_ROOT.rglob(\"*.parquet\")\n",
    ")\n",
    "\n",
    "prediction_candidate_rows = []\n",
    "\n",
    "for path in double_parquets:\n",
    "    try:\n",
    "        parquet_file = pq.ParquetFile(path)\n",
    "\n",
    "        normalized_map = normalized_columns(path)\n",
    "\n",
    "        has_sample = contains_alias(\n",
    "            normalized_map,\n",
    "            SAMPLE_ALIASES,\n",
    "        )\n",
    "\n",
    "        has_target = contains_alias(\n",
    "            normalized_map,\n",
    "            TARGET_ALIASES,\n",
    "        )\n",
    "\n",
    "        has_prediction = contains_alias(\n",
    "            normalized_map,\n",
    "            PREDICTION_ALIASES,\n",
    "        )\n",
    "\n",
    "        has_fold = contains_alias(\n",
    "            normalized_map,\n",
    "            FOLD_ALIASES,\n",
    "        )\n",
    "\n",
    "        if not (\n",
    "            has_sample\n",
    "            and has_target\n",
    "            and has_prediction\n",
    "        ):\n",
    "            continue\n",
    "\n",
    "        prediction_candidate_rows.append(\n",
    "            {\n",
    "                \"path\": str(path),\n",
    "                \"row_count\": int(\n",
    "                    parquet_file.metadata.num_rows\n",
    "                ),\n",
    "                \"column_count\": len(normalized_map),\n",
    "                \"has_sample\": has_sample,\n",
