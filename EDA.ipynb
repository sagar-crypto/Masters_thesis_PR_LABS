    "in_csv = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_takagi_local_prior.csv\"\n",
    "\n",
    "out_csv = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_caseaware_family_takagi_prior.csv\"\n",
    "\n",
    "df = pd.read_csv(in_csv)\n",
    "\n",
    "required_cols = [\n",
    "    \"case\",\n",
    "    \"y_fault_location\",\n",
    "    \"d_phys_real_pct_original\",\n",
    "    \"d_takagi_local_pct\",\n",
    "]\n",
    "\n",
    "missing = [c for c in required_cols if c not in df.columns]\n",
    "if missing:\n",
    "    raise ValueError(f\"Missing required columns: {missing}\")\n",
    "\n",
    "takagi_cases = {\n",
    "    \"3ph\",\n",
    "    \"ll_ab\", \"ll_bc\", \"ll_ca\",\n",
    "    \"llg_ab\", \"llg_bc\", \"llg_ca\",\n",
    "}\n",
    "\n",
    "# Keep a copy of whatever d_phys_real_pct currently contains in this CSV.\n",
    "# In your takagi_local_prior CSV, this is probably already Takagi.\n",
    "df[\"d_phys_real_pct_before_caseaware\"] = df[\"d_phys_real_pct\"]\n",
    "\n",
    "# Select prior:\n",
    "# - Takagi for 3ph, LL, LLG\n",
    "# - old original prior for SLG\n",
    "df[\"d_phys_real_pct\"] = np.where(\n",
    "    df[\"case\"].isin(takagi_cases),\n",
    "    df[\"d_takagi_local_pct\"],\n",
    "    df[\"d_phys_real_pct_original\"],\n",
    ")\n",
    "\n",
    "df[\"d_phys_real_strategy\"] = np.where(\n",
    "    df[\"case\"].isin(takagi_cases),\n",
    "    \"takagi_local_for_3ph_ll_llg\",\n",
    "    \"old_prior_for_slg\",\n",
    ")\n",
    "\n",
    "df[\"prior_selected_is_takagi\"] = df[\"case\"].isin(takagi_cases).astype(int)\n",
    "df[\"prior_selected_abs_err\"] = (\n",
    "    df[\"y_fault_location\"] - df[\"d_phys_real_pct\"]\n",
    ").abs()\n",
    "\n",
    "print(\"Rows:\", len(df))\n",
    "print(\"Old original prior MAE:\", (df[\"y_fault_location\"] - df[\"d_phys_real_pct_original\"]).abs().mean())\n",
    "print(\"Takagi local prior MAE:\", (df[\"y_fault_location\"] - df[\"d_takagi_local_pct\"]).abs().mean())\n",
    "print(\"Case-aware selected prior MAE:\", df[\"prior_selected_abs_err\"].mean())\n",
    "\n",
    "print(\"\\nPer-case selected prior MAE:\")\n",
    "print(\n",
    "    df.groupby(\"case\")\n",
    "      .agg(\n",
    "          n=(\"case\", \"size\"),\n",
    "          selected_prior_mae=(\"prior_selected_abs_err\", \"mean\"),\n",
    "          strategy=(\"d_phys_real_strategy\", \"first\"),\n",
    "      )\n",
    "      .reset_index()\n",
    "      .sort_values(\"selected_prior_mae\")\n",
    "      .to_string(index=False)\n",
    ")\n",
    "\n",
    "df.to_csv(out_csv, index=False)\n",
    "print(\"\\nSaved:\", out_csv)"
   ]
