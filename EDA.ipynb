   "source": [
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "csv_path = Path(\n",
    "    \"/home/vault/iwi5/iwi5305h/\"\n",
    "    \"kol_operator_features_hv_double_line_110kv_\"\n",
    "    \"both_all_fault_start_k0fixed_twoended_audit.csv\"\n",
    ")\n",
    "\n",
    "df = pd.read_csv(csv_path, low_memory=False)\n",
    "\n",
    "df = df.loc[df[\"status\"].eq(\"fault_start\")].copy()\n",
    "\n",
    "protocols = {\n",
    "    \"all_fault_start_windows\": df,\n",
    "    \"latest_window_per_sample\": (\n",
    "        df.sort_values([\"sample_id\", \"window_idx\"])\n",
    "          .groupby(\"sample_id\", as_index=False)\n",
    "          .tail(1)\n",
    "    ),\n",
    "}\n",
    "\n",
    "prediction_columns = {\n",
    "    \"sign_plus\": \"d_two_ended_posseq_plus_pct\",\n",
    "    \"sign_minus\": \"d_two_ended_posseq_minus_pct\",\n",
    "}\n",
    "\n",
    "rows = []\n",
    "\n",
    "for protocol_name, subset in protocols.items():\n",
    "    for sign_name, prediction_col in prediction_columns.items():\n",
    "        for reference_name, prediction in {\n",
    "            \"default_terminal\": subset[prediction_col],\n",
    "            \"reversed_terminal\": 100.0 - subset[prediction_col],\n",
    "        }.items():\n",
    "            work = subset.copy()\n",
    "            work[\"prediction_pct\"] = pd.to_numeric(\n",
    "                prediction,\n",
    "                errors=\"coerce\",\n",
    "            )\n",
    "\n",
    "            work = work.dropna(subset=[\"prediction_pct\"]).copy()\n",
    "            work[\"abs_error_pp\"] = (\n",
    "                work[\"prediction_pct\"] - work[\"y_fault_location\"]\n",
    "            ).abs()\n",
    "\n",
    "            for line, group in work.groupby(\"y_fault_line\"):\n",
    "                rows.append(\n",
    "                    {\n",
    "                        \"protocol\": protocol_name,\n",
    "                        \"line\": line,\n",
    "                        \"sign\": sign_name,\n",
    "                        \"reference\": reference_name,\n",
    "                        \"n_valid\": len(group),\n",
    "                        \"mae_pp\": group[\"abs_error_pp\"].mean(),\n",
    "                        \"median_pp\": group[\"abs_error_pp\"].median(),\n",
    "                        \"p90_pp\": group[\"abs_error_pp\"].quantile(0.90),\n",
    "                    }\n",
    "                )\n",
    "\n",
    "results = pd.DataFrame(rows)\n",
    "\n",
    "display(\n",
    "    results.sort_values(\n",
    "        [\"line\", \"mae_pp\", \"median_pp\"]\n",
    "    ).round(3)\n",
    ")"
   ]
  },
