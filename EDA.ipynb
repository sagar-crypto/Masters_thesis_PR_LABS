    "analysis_df[\"abs_error_pp\"] = analysis_df[\"signed_error_pp\"].abs()\n",
    "\n",
    "print(\"\\nPer faulted line\")\n",
    "display(\n",
    "    analysis_df.groupby(\"y_fault_line\")[\"abs_error_pp\"]\n",
