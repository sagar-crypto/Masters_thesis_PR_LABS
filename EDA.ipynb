    "    Iab = abs(Iph[0] - Iph[1])\n",
    "    Ibc = abs(Iph[1] - Iph[2])\n",
    "    Ica = abs(Iph[2] - Iph[0])\n",
    "\n",
    "    Zloop = [Zab, Zbc, Zca][np.argmax([Iab, Ibc, Ica])]\n",
    "    return Zloop\n"
