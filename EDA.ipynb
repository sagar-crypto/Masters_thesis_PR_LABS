    "    / \"posthoc_combination_diagnostic_availability.csv\"\n",
    ")\n",
    "\n",
    "diagnostic_availability.to_csv(\n",
    "    diagnostic_availability_path,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "print(\"Saved:\", diagnostic_availability_path)\n",
    "\n",
    "display(diagnostic_availability)"
