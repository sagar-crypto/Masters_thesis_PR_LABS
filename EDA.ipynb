    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "csv_path = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_line_caseaware_takagi_prior.csv\"\n",
    "df = pd.read_csv(csv_path)\n",
    "\n",
    "df[\"residual\"] = df[\"y_fault_location\"] - df[\"d_phys_real_pct\"]\n",
    "df[\"abs_residual\"] = df[\"residual\"].abs()\n",
    "\n",
    "summary = (\n",
    "    df.groupby(\"y_fault_line\")\n",
    "      .agg(\n",
    "          n=(\"abs_residual\", \"size\"),\n",
    "          mean_abs_residual=(\"abs_residual\", \"mean\"),\n",
    "          median_abs_residual=(\"abs_residual\", \"median\"),\n",
    "          p75_abs_residual=(\"abs_residual\", lambda x: np.quantile(x, 0.75)),\n",
    "          p90_abs_residual=(\"abs_residual\", lambda x: np.quantile(x, 0.90)),\n",
    "          p95_abs_residual=(\"abs_residual\", lambda x: np.quantile(x, 0.95)),\n",
    "          max_abs_residual=(\"abs_residual\", \"max\"),\n",
    "      )\n",
    "      .reset_index()\n",
    ")\n",
    "\n",
    "summary"
   ]
