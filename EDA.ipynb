    "        check_name=\"saved_model_abs_error_identity\",\n",
    "        observed=float(\n",
    "            model_error_difference.max()\n",
    "        ),\n",
    "        expected=f\"<= {NUMERIC_TOLERANCE}\",\n",
    "        passed=bool(\n",
    "            (\n",
    "                model_error_difference\n",
    "                <= NUMERIC_TOLERANCE\n",
    "            ).all()\n",
    "        ),\n",
    "    )\n",
    "\n",
    "    add_check(\n",
    "        experiment_id=experiment_id,\n",
    "        category=\"numerical_identity\",\n",
    "        check_name=\"saved_prior_abs_error_identity\",\n",
    "        observed=float(\n",
    "            prior_error_difference.max()\n",
    "        ),\n",
    "        expected=f\"<= {NUMERIC_TOLERANCE}\",\n",
    "        passed=bool(\n",
    "            (\n",
    "                prior_error_difference\n",
    "                <= NUMERIC_TOLERANCE\n",
    "            ).all()\n",
    "        ),\n",
    "    )\n",
    "\n",
    "    # -------------------------------------------------------------\n",
    "    # Optional clipping, fallback, gate and residual columns\n",
    "    # -------------------------------------------------------------\n",
    "\n",
    "    for optional_column in [\n",
    "        \"clipped\",\n",
    "        \"is_clipped\",\n",
    "        \"clip_flag\",\n",
    "        \"fallback\",\n",
    "        \"fallback_used\",\n",
    "        \"fallback_flag\",\n",
    "        \"alpha\",\n",
    "        \"residual\",\n",
    "    ]:\n",
    "        add_check(\n",
    "            experiment_id=experiment_id,\n",
    "            category=\"optional_diagnostics\",\n",
    "            check_name=(\n",
    "                f\"{optional_column}_column_available\"\n",
    "            ),\n",
    "            observed=(\n",
    "                optional_column\n",
    "                in window_frame.columns\n",
    "            ),\n",
    "            expected=True,\n",
    "            passed=(\n",
    "                optional_column\n",
    "                in window_frame.columns\n",
    "            ),\n",
    "            mandatory=False,\n",
    "        )"
   ]
  },
  {
   "cell_type": "code",
