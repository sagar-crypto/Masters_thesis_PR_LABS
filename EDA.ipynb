    "import pandas as pd\n",
    "\n",
    "csv_path = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_selective_slg_b_mod_takagi_prior.csv\"\n",
    "df = pd.read_csv(csv_path)\n",
    "\n",
    "line = \"MainLn1-2A\"\n",
    "tmp = df[df[\"y_fault_line\"] == line].copy()\n",
    "\n",
    "print(\"Strategy counts:\")\n",
    "print(tmp[\"d_phys_real_strategy\"].value_counts())\n",
    "\n",
    "print(\"\\nLine-wise prior MAE:\")\n",
    "print((tmp[\"y_fault_location\"] - tmp[\"d_phys_real_pct\"]).abs().mean())\n",
    "\n",
    "print(\"\\nCase-wise prior MAE:\")\n",
    "case_prior = (\n",
    "    tmp.groupby([\"case\", \"d_phys_real_strategy\"])\n",
    "       .apply(lambda g: (g[\"y_fault_location\"] - g[\"d_phys_real_pct\"]).abs().mean())\n",
    "       .rename(\"prior_mae\")\n",
    "       .reset_index()\n",
    "       .sort_values(\"case\")\n",
    ")\n",
    "display(case_prior.round(4))"
   ]
