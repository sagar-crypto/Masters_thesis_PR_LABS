   "source": [
    "REQUIRED_COMMON_FIELDS = [\n",
    "    \"sample_id\",\n",
    "    \"fold\",\n",
    "    \"y_true_pct\",\n",
    "    \"y_pred_pct\",\n",
    "    \"y_prior_pct\",\n",
    "    \"y_fault_line\",\n",
    "    \"case\",\n",
    "]\n",
    "\n",
    "OPTIONAL_FIELDS = [\n",
    "    \"event_type\",\n",
    "    \"fault_location_pct\",\n",
    "    \"clipped\",\n",
    "    \"fallback\",\n",
    "    \"valid\",\n",
    "    \"gate_value\",\n",
    "    \"raw_residual\",\n",
    "    \"bounded_residual\",\n",
    "    \"effective_correction\",\n",
    "    \"preclip_prediction\",\n",
    "    \"postclip_prediction\",\n",
    "]\n",
    "\n",
    "\n",
    "schema_record_by_path = {\n",
    "    record[\"path\"]: record\n",
    "    for record in schema_records\n",
    "}\n",
    "\n",
    "\n",
    "field_mapping_rows: list[dict[str, Any]] = []\n",
    "\n",
    "\n",
    "for experiment_id, experiment_manifest in (\n",
    "    manifest[\"experiments\"].items()\n",
    "):\n",
    "    selected_path = experiment_manifest[\n",
    "        \"selected_prediction_artifact\"\n",
    "    ]\n",
    "\n",
    "    if selected_path is None:\n",
    "        continue\n",
    "\n",
    "    record = schema_record_by_path[\n",
    "        selected_path\n",
    "    ]\n",
    "\n",
    "    expected_topology = experiment_manifest[\n",
    "        \"expected\"\n",
    "    ][\"topology\"]\n",
    "\n",
    "    required_fields = list(\n",
    "        REQUIRED_COMMON_FIELDS\n",
    "    )\n",
    "\n",
    "    if expected_topology == \"110kv\":\n",
    "        required_fields.append(\"window_idx\")\n",
    "\n",
    "    for canonical_field in (\n",
    "        required_fields + OPTIONAL_FIELDS\n",
    "    ):\n",
    "        resolution = (\n",
    "            record\n",
    "            .get(\"alias_resolution\", {})\n",
    "            .get(\n",
    "                canonical_field,\n",
    "                {\n",
    "                    \"status\": \"missing\",\n",
    "                    \"matches\": [],\n",
    "                },\n",
    "            )\n",
    "        )\n",
    "\n",
    "        is_required = (\n",
    "            canonical_field in required_fields\n",
    "        )\n",
    "\n",
    "        field_mapping_rows.append(\n",
    "            {\n",
    "                \"experiment_id\": experiment_id,\n",
    "                \"artifact_path\": selected_path,\n",
    "                \"canonical_field\": canonical_field,\n",
    "                \"required\": is_required,\n",
    "                \"status\": resolution[\"status\"],\n",
    "                \"matches\": \"|\".join(\n",
    "                    resolution[\"matches\"]\n",
    "                ),\n",
    "            }\n",
    "        )\n",
    "\n",
    "        if (\n",
    "            is_required\n",
    "            and resolution[\"status\"] != \"resolved\"\n",
    "        ):\n",
    "            unresolved_rows.append(\n",
    "                {\n",
    "                    \"experiment_id\": experiment_id,\n",
    "                    \"mapping_type\": \"required_column\",\n",
    "                    \"issue\": resolution[\"status\"],\n",
    "                    \"details\": (\n",
    "                        f\"Required canonical field \"\n",
    "                        f\"{canonical_field!r} has status \"\n",
    "                        f\"{resolution['status']!r}.\"\n",
    "                    ),\n",
    "                    \"candidate_paths\": selected_path,\n",
    "                    \"candidate_columns\": \"|\".join(\n",
    "                        resolution[\"matches\"]\n",
    "                    ),\n",
    "                }\n",
    "            )\n",
    "\n",
    "\n",
    "field_mapping_df = pd.DataFrame(\n",
    "    field_mapping_rows\n",
    ")\n",
    "\n",
    "field_mapping_path = (\n",
    "    FINAL_DIR\n",
    "    / \"provisional_prediction_field_mappings.csv\"\n",
    ")\n",
    "\n",
    "field_mapping_df.to_csv(\n",
    "    field_mapping_path,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "print(\"Saved:\", field_mapping_path)\n",
    "\n",
    "display(field_mapping_df.head(100))"
   ]
  },
