    "prediction_cols = [\n",
    "    col for col in prediction_cols\n",
    "    if col in df.columns\n",
    "]\n",
    "\n",
    "if not prediction_cols:\n",
    "    raise ValueError(\n",
    "        \"No two-ended prediction columns found. \"\n",
    "        \"Print df.columns and inspect the export.\"\n",
    "    )\n",
    "\n",
    "required_cols = [\n",
    "    \"sample_id\",\n",
    "    \"window_idx\",\n",
    "    \"status\",\n",
    "    \"y_fault_line\",\n",
    "    \"y_fault_location\",\n",
    "    \"case\",\n",
    "]\n",
    "\n",
    "missing = [col for col in required_cols if col not in df.columns]\n",
    "if missing:\n",
    "    raise ValueError(f\"Missing required columns: {missing}\")\n",
    "\n",
    "# Use only post-fault windows selected by the export pipeline.\n",
    "fault_df = df.loc[df[\"status\"].eq(\"fault_start\")].copy()\n",
    "\n",
    "if fault_df.empty:\n",
    "    raise ValueError(\"No rows with status == 'fault_start' found.\")\n",
    "\n",
    "fault_df[\"y_fault_location\"] = pd.to_numeric(\n",
    "    fault_df[\"y_fault_location\"],\n",
    "    errors=\"coerce\",\n",
    ")\n",
    "\n",
    "for pred_col in prediction_cols:\n",
    "    fault_df[pred_col] = pd.to_numeric(\n",
    "        fault_df[pred_col],\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    "# Last selected fault-start window per physical simulation event.\n",
    "latest_df = (\n",
    "    fault_df\n",
    "    .sort_values([\"sample_id\", \"window_idx\"])\n",
    "    .groupby(\"sample_id\", as_index=False)\n",
    "    .tail(1)\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "def summarize_prediction(\n",
    "    data: pd.DataFrame,\n",
    "    pred_col: str,\n",
    "    protocol: str,\n",
    ") -> pd.DataFrame:\n",
    "    eval_df = data.dropna(\n",
    "        subset=[\"y_fault_location\", pred_col]\n",
    "    ).copy()\n",
    "\n",
    "    eval_df[\"signed_error_pp\"] = (\n",
    "        eval_df[pred_col] - eval_df[\"y_fault_location\"]\n",
    "    )\n",
    "    eval_df[\"abs_error_pp\"] = eval_df[\"signed_error_pp\"].abs()\n",
    "\n",
    "    return pd.DataFrame(\n",
    "        [{\n",
    "            \"protocol\": protocol,\n",
    "            \"prediction_col\": pred_col,\n",
