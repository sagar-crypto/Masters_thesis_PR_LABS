    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "csv_path = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_line_caseaware_takagi_prior.csv\"\n",
    "df = pd.read_csv(csv_path)\n",
    "print(df.columns.tolist())\n",
    "\n",
    "slg = df[df[\"case\"].isin([\"slg_a\", \"slg_b\", \"slg_c\"])].copy()\n",
    "\n",
    "# If values are already in percentage scale, do NOT multiply by 100\n",
    "slg[\"prior_abs_err_pp\"] = (slg[\"y_fault_location\"] - slg[\"d_phys_real_pct\"]).abs()\n",
    "slg[\"old_abs_err_pp\"] = (slg[\"y_fault_location\"] - slg[\"d_phys_real_pct_original\"]).abs()\n",
    "slg[\"takagi_local_abs_err_pp\"] = (slg[\"y_fault_location\"] - slg[\"d_takagi_local_pct\"]).abs()\n",
    "slg[\"takagi_remote_flipped_abs_err_pp\"] = (slg[\"y_fault_location\"] - slg[\"d_takagi_remote_flipped_pct\"]).abs()\n",
    "slg[\"takagi_both_mean_abs_err_pp\"] = (slg[\"y_fault_location\"] - slg[\"d_takagi_both_mean_pct\"]).abs()\n",
    "\n",
    "slg_prior_summary = (\n",
    "    slg.groupby([\"y_fault_line\", \"case\"])\n",
    "       .agg(\n",
    "           n=(\"case\", \"size\"),\n",
    "           selected_prior_mae=(\"prior_abs_err_pp\", \"mean\"),\n",
    "           old_mae=(\"old_abs_err_pp\", \"mean\"),\n",
    "           takagi_local_mae=(\"takagi_local_abs_err_pp\", \"mean\"),\n",
    "           remote_flipped_mae=(\"takagi_remote_flipped_abs_err_pp\", \"mean\"),\n",
    "           both_mean_mae=(\"takagi_both_mean_abs_err_pp\", \"mean\"),\n",
    "       )\n",
    "       .reset_index()\n",
    "       .sort_values([\"y_fault_line\", \"case\"])\n",
    ")\n",
    "\n",
    "slg_prior_summary.round(2)"
   ]
  },
