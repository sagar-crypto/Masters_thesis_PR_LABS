      "Saved: /home/hpc/iwi5/iwi5305h/Masters_thesis_PR_LABS/outputs/chapter4/posthoc_final/experiment_artifact_manifest.json\n"
     ]
    }
   ],
   "source": [
    "manifest: dict[str, Any] = {\n",
    "    \"generated_utc\": datetime.now(\n",
    "        timezone.utc\n",
    "    ).isoformat(),\n",
    "    \"chapter4_root\": str(CHAPTER4_ROOT),\n",
    "    \"single_run_root\": str(SINGLE_RUN_ROOT),\n",
    "    \"double_run_root\": str(DOUBLE_RUN_ROOT),\n",
    "    \"double_model_input_root\": str(\n",
    "        DOUBLE_MODEL_INPUT_ROOT\n",
    "    ),\n",
    "    \"output_directory\": str(FINAL_DIR),\n",
    "    \"prediction_mode\": PREDICTION_MODE,\n",
    "    \"known_two_ended_prepared_prior_column\": (\n",
    "        KNOWN_TWO_ENDED_PREPARED_PRIOR_COLUMN\n",
    "    ),\n",
    "    \"experiments\": {},\n",
    "}\n",
    "\n",
    "\n",
    "unresolved_rows: list[dict[str, Any]] = []\n",
    "\n",
    "\n",
    "for experiment_id, expected in EXPERIMENTS.items():\n",
    "    candidates: list[dict[str, Any]] = []\n",
    "\n",
    "    for record in schema_records:\n",
    "        score, reasons = prediction_candidate_score(\n",
    "            record,\n",
    "            experiment_id,\n",
    "        )\n",
    "\n",
    "        if score <= 0:\n",
    "            continue\n",
    "\n",
    "        candidates.append(\n",
    "            {\n",
    "                \"path\": record[\"path\"],\n",
    "                \"format\": record.get(\"format\"),\n",
    "                \"row_count\": record.get(\n",
    "                    \"row_count\"\n",
    "                ),\n",
    "                \"score\": score,\n",
    "                \"reasons\": reasons,\n",
    "                \"experiment_detection\": record.get(\n",
    "                    \"experiment_detection\"\n",
    "                ),\n",
    "                \"columns\": record.get(\n",
    "                    \"columns\",\n",
    "                    [],\n",
    "                ),\n",
    "                \"alias_resolution\": record.get(\n",
    "                    \"alias_resolution\",\n",
    "                    {},\n",
    "                ),\n",
    "                \"probe_values\": record.get(\n",
    "                    \"probe_values\",\n",
    "                    {},\n",
    "                ),\n",
    "                \"artifact_roles\": record.get(\n",
    "                    \"artifact_roles\",\n",
    "                ),\n",
    "            }\n",
    "        )\n",
    "\n",
    "    candidates = sorted(\n",
    "        candidates,\n",
    "        key=lambda item: (\n",
    "            -item[\"score\"],\n",
    "            item[\"path\"],\n",
    "        ),\n",
    "    )\n",
    "\n",
    "    # Only candidates that actually resemble prediction tables are\n",
    "    # eligible for automatic provisional selection.\n",
    "    eligible_candidates = [\n",
    "        candidate\n",
    "        for candidate in candidates\n",
    "        if all(\n",
    "            candidate[\"alias_resolution\"]\n",
    "            .get(field, {})\n",
    "            .get(\"status\") == \"resolved\"\n",
    "            for field in [\n",
    "                \"sample_id\",\n",
    "                \"y_true_pct\",\n",
    "                \"y_pred_pct\",\n",
    "            ]\n",
    "        )\n",
    "    ]\n",
    "\n",
    "    selected_prediction_artifact = None\n",
    "    selection_status = \"unresolved\"\n",
    "\n",
    "    if not eligible_candidates:\n",
    "        unresolved_rows.append(\n",
    "            {\n",
    "                \"experiment_id\": experiment_id,\n",
    "                \"mapping_type\": \"prediction_artifact\",\n",
    "                \"issue\": \"no_eligible_prediction_candidate\",\n",
    "                \"details\": (\n",
    "                    \"No discovered table had an unambiguous \"\n",
    "                    \"sample ID, target and prediction.\"\n",
    "                ),\n",
    "                \"candidate_paths\": \"\",\n",
    "            }\n",
    "        )\n",
    "\n",
    "    else:\n",
    "        highest_score = eligible_candidates[0][\"score\"]\n",
    "\n",
    "        highest_candidates = [\n",
    "            candidate\n",
    "            for candidate in eligible_candidates\n",
    "            if candidate[\"score\"] == highest_score\n",
    "        ]\n",
    "\n",
    "        if len(highest_candidates) == 1:\n",
    "            selected_prediction_artifact = (\n",
    "                highest_candidates[0][\"path\"]\n",
    "            )\n",
    "            selection_status = \"provisionally_selected\"\n",
    "\n",
    "        else:\n",
    "            unresolved_rows.append(\n",
    "                {\n",
    "                    \"experiment_id\": experiment_id,\n",
    "                    \"mapping_type\": \"prediction_artifact\",\n",
    "                    \"issue\": \"multiple_equal_best_candidates\",\n",
    "                    \"details\": (\n",
    "                        f\"{len(highest_candidates)} candidates \"\n",
    "                        f\"share the highest score {highest_score}.\"\n",
    "                    ),\n",
    "                    \"candidate_paths\": \"|\".join(\n",
    "                        candidate[\"path\"]\n",
    "                        for candidate in highest_candidates\n",
    "                    ),\n",
    "                }\n",
    "            )\n",
    "\n",
    "    manifest[\"experiments\"][experiment_id] = {\n",
    "        \"expected\": expected,\n",
    "        \"expected_cohort\": EXPECTED_COHORTS[\n",
    "            expected[\"topology\"]\n",
    "        ],\n",
    "        \"prediction_selection_status\": (\n",
    "            selection_status\n",
    "        ),\n",
    "        \"selected_prediction_artifact\": (\n",
    "            selected_prediction_artifact\n",
    "        ),\n",
    "        \"prediction_candidates\": candidates,\n",
    "    }\n",
    "\n",
    "\n",
    "manifest_path = (\n",
    "    FINAL_DIR / \"experiment_artifact_manifest.json\"\n",
    ")\n",
    "\n",
    "with manifest_path.open(\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    json.dump(\n",
    "        manifest,\n",
    "        file,\n",
    "        indent=2,\n",
    "        ensure_ascii=False,\n",
    "        default=str,\n",
    "    )\n",
    "\n",
    "print(\"Saved:\", manifest_path)"
   ]
  },
