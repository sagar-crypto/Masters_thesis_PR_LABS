   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Assumes `work` still exists from the previous analysis cell.\n",
    "# If not, rerun the previous loading/filtering cell first.\n",
    "\n",
    "old_prior_col = \"d_phys_real_pct_original\"\n",
    "modified_prior_col = \"d_mod_takagi_tf_only_p_both_mean_pct_filled\"\n",
    "availability_col = \"is_mod_takagi_tf_only_available\"\n",
    "\n",
    "compare = work.copy()\n",
    "\n",
    "# Keep the same selection used in your prior analysis.\n",
    "if \"status\" in compare.columns and (compare[\"status\"] == \"fault_start\").any():\n",
    "    compare = compare.loc[compare[\"status\"].eq(\"fault_start\")].copy()\n",
    "\n",
    "sort_cols = [c for c in [\"sample_id\", \"window_idx\", \"dt_start\"] if c in compare.columns]\n",
    "if sort_cols:\n",
    "    compare = compare.sort_values(sort_cols)\n",
    "\n",
    "compare = compare.drop_duplicates(subset=[\"sample_id\"], keep=\"first\").copy()\n",
    "\n",
    "numeric_cols = [\n",
    "    \"y_fault_location\",\n",
    "    old_prior_col,\n",
    "    modified_prior_col,\n",
    "    availability_col,\n",
    "]\n",
    "\n",
    "for col in numeric_cols:\n",
    "    if col in compare.columns:\n",
    "        compare[col] = pd.to_numeric(compare[col], errors=\"coerce\")\n",
    "\n",
    "compare = compare.dropna(\n",
    "    subset=[\"y_fault_location\", old_prior_col, modified_prior_col]\n",
    ").copy()\n",
    "\n",
    "compare[\"old_abs_error_pp\"] = (\n",
    "    compare[old_prior_col] - compare[\"y_fault_location\"]\n",
    ").abs()\n",
    "\n",
    "compare[\"modified_abs_error_pp\"] = (\n",
    "    compare[modified_prior_col] - compare[\"y_fault_location\"]\n",
    ").abs()\n",
    "\n",
    "compare[\"mae_change_pp\"] = (\n",
    "    compare[\"modified_abs_error_pp\"] - compare[\"old_abs_error_pp\"]\n",
    ")\n",
    "\n",
    "compare[\"modified_better\"] = compare[\"mae_change_pp\"] < 0\n",
    "\n",
    "# ------------------------------------------------------------------\n",
    "# Case-wise comparison\n",
    "# ------------------------------------------------------------------\n",
    "case_comparison = (\n",
    "    compare.groupby(\"case\", observed=True)\n",
    "    .agg(\n",
    "        n=(\"sample_id\", \"size\"),\n",
    "        old_mae_pp=(\"old_abs_error_pp\", \"mean\"),\n",
    "        modified_mae_pp=(\"modified_abs_error_pp\", \"mean\"),\n",
    "        mean_change_pp=(\"mae_change_pp\", \"mean\"),\n",
    "        median_change_pp=(\"mae_change_pp\", \"median\"),\n",
    "        modified_better_rate_pct=(\n",
    "            \"modified_better\",\n",
    "            lambda s: 100.0 * s.mean(),\n",
    "        ),\n",
    "        modified_available_rate_pct=(\n",
    "            availability_col,\n",
    "            lambda s: 100.0 * s.mean(),\n",
    "        ),\n",
    "    )\n",
    ")\n",
    "\n",
    "case_comparison[\"improvement_pp\"] = (\n",
    "    case_comparison[\"old_mae_pp\"] - case_comparison[\"modified_mae_pp\"]\n",
    ")\n",
    "\n",
    "case_comparison = case_comparison.sort_values(\n",
    "    \"improvement_pp\",\n",
    "    ascending=False,\n",
    ")\n",
    "\n",
    "print(\"Old physics prior vs. modified final prior — per fault case\")\n",
    "display(case_comparison.round(3))\n",
    "\n",
    "# ------------------------------------------------------------------\n",
    "# SLG-only sample-level comparison\n",
    "# ------------------------------------------------------------------\n",
    "slg_compare = compare.loc[\n",
    "    compare[\"case\"].isin([\"slg_a\", \"slg_b\", \"slg_c\"])\n",
    "].copy()\n",
    "\n",
    "print(\"\\nSLG samples where the modified prior improved the error most:\")\n",
    "display(\n",
    "    slg_compare.sort_values(\"mae_change_pp\", ascending=True)[\n",
    "        [\n",
    "            \"sample_id\",\n",
    "            \"case\",\n",
    "            \"y_fault_location\",\n",
    "            old_prior_col,\n",
    "            modified_prior_col,\n",
    "            \"old_abs_error_pp\",\n",
    "            \"modified_abs_error_pp\",\n",
    "            \"mae_change_pp\",\n",
    "        ]\n",
    "    ].head(20)\n",
    ")\n",
    "\n",
    "print(\"\\nSLG samples where the modified prior became worse:\")\n",
    "display(\n",
    "    slg_compare.sort_values(\"mae_change_pp\", ascending=False)[\n",
    "        [\n",
    "            \"sample_id\",\n",
    "            \"case\",\n",
    "            \"y_fault_location\",\n",
    "            old_prior_col,\n",
    "            modified_prior_col,\n",
    "            \"old_abs_error_pp\",\n",
    "            \"modified_abs_error_pp\",\n",
    "            \"mae_change_pp\",\n",
    "        ]\n",
    "    ].head(20)\n",
    ")\n",
    "\n",
    "# ------------------------------------------------------------------\n",
    "# Plot: old vs modified MAE by fault case\n",
    "# ------------------------------------------------------------------\n",
    "plot_df = case_comparison.reset_index()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(11, 5))\n",
    "\n",
    "x = np.arange(len(plot_df))\n",
    "width = 0.38\n",
    "\n",
    "ax.bar(\n",
    "    x - width / 2,\n",
    "    plot_df[\"old_mae_pp\"],\n",
    "    width,\n",
    "    label=\"Old physics prior\",\n",
    ")\n",
    "\n",
    "ax.bar(\n",
    "    x + width / 2,\n",
    "    plot_df[\"modified_mae_pp\"],\n",
    "    width,\n",
    "    label=\"Modified final prior\",\n",
    ")\n",
    "\n",
    "ax.set_xticks(x)\n",
    "ax.set_xticklabels(plot_df[\"case\"], rotation=45, ha=\"right\")\n",
    "ax.set_ylabel(\"MAE (percentage points)\")\n",
    "ax.set_title(\"Old physics prior vs. modified prior by fault type\")\n",
    "ax.grid(axis=\"y\", alpha=0.3)\n",
    "ax.legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
