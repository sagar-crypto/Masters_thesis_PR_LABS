    "ops = pd.read_csv(operator_csv)\n",
    "\n",
    "merge_keys = [\"sample_id\"]\n",
    "if \"window_idx\" in ops.columns:\n",
    "    merge_keys.append(\"window_idx\")\n",
    "\n",
    "# keep only useful columns if available\n",
    "wanted_op_cols = [\n",
    "    \"sample_id\",\n",
    "    \"window_idx\",\n",
    "    \"case\",\n",
    "    \"d_phys_real_pct\",\n",
    "    \"d_local_real_pct\",\n",
    "    \"d_remote_real_flipped_pct\",\n",
    "    \"d_both_mean_real_pct\",\n",
    "    \"d_both_diff_real_pct\",\n",
    "]\n",
    "wanted_op_cols = [c for c in wanted_op_cols if c in ops.columns]\n",
    "ops_small = ops[wanted_op_cols].copy()\n",
    "\n",
    "all_views = []\n",
    "\n",
    "for fold_idx, cases in targets.items():\n",
    "    pred_path = pred_dir / f\"fold{fold_idx}.parquet\"\n",
    "    if not pred_path.exists():\n",
    "        print(f\"Missing prediction file: {pred_path}\")\n",
    "        continue\n",
    "\n",
    "    pred_df = pd.read_parquet(pred_path).copy()\n",
    "    pred_df[\"fold\"] = fold_idx\n",
    "\n",
    "    print(f\"\\n=== fold {fold_idx} raw prediction columns ===\")\n",
    "    print(pred_df.columns.tolist())\n",
    "\n",
    "    # try to standardize names\n",
    "    rename_map = {}\n",
    "    if \"prediction\" in pred_df.columns and \"y_pred\" not in pred_df.columns:\n",
    "        rename_map[\"prediction\"] = \"y_pred\"\n",
    "    if \"target\" in pred_df.columns and \"y_true\" not in pred_df.columns:\n",
    "        rename_map[\"target\"] = \"y_true\"\n",
    "    pred_df = pred_df.rename(columns=rename_map)\n",
    "\n",
    "    # merge operator info\n",
    "    common_keys = [k for k in merge_keys if k in pred_df.columns and k in ops_small.columns]\n",
    "    merged = pred_df.merge(ops_small, on=common_keys, how=\"left\", suffixes=(\"\", \"_op\"))\n",
    "\n",
    "    # create / standardize case\n",
    "    if \"case\" not in merged.columns and \"case_op\" in merged.columns:\n",
    "        merged[\"case\"] = merged[\"case_op\"]\n",
    "\n",
    "    # create prior in normalized and pp units\n",
    "    if \"d_phys_real_pct\" in merged.columns:\n",
    "        merged[\"prior_pct\"] = merged[\"d_phys_real_pct\"]\n",
    "        merged[\"prior_norm\"] = merged[\"d_phys_real_pct\"] / 100.0\n",
    "    else:\n",
    "        merged[\"prior_pct\"] = np.nan\n",
    "        merged[\"prior_norm\"] = np.nan\n",
    "\n",
    "    # make sure y_true / y_pred exist\n",
    "    if \"y_true\" not in merged.columns or \"y_pred\" not in merged.columns:\n",
    "        print(f\"fold {fold_idx}: could not find y_true / y_pred columns after load\")\n",
    "        continue\n",
    "\n",
    "    # residual-type diagnostics\n",
    "    merged[\"true_pct\"] = merged[\"y_true\"] * 100.0\n",
    "    merged[\"pred_pct\"] = merged[\"y_pred\"] * 100.0\n",
    "    merged[\"abs_err_pct\"] = (merged[\"y_pred\"] - merged[\"y_true\"]).abs() * 100.0\n",
    "    merged[\"signed_err_pct\"] = (merged[\"y_pred\"] - merged[\"y_true\"]) * 100.0\n",
    "    merged[\"prior_err_pct\"] = (merged[\"prior_norm\"] - merged[\"y_true\"]) * 100.0\n",
    "    merged[\"model_gain_pct\"] = (merged[\"prior_norm\"] - merged[\"y_pred\"]).abs() * 100.0\n",
    "    merged[\"pred_minus_prior_pct\"] = (merged[\"y_pred\"] - merged[\"prior_norm\"]) * 100.0\n",
    "\n",
    "    # inspect target cases\n",
    "    view = merged[merged[\"case\"].isin(cases)].copy()\n",
    "\n",
    "    cols_show = [\n",
    "        c for c in [\n",
    "            \"fold\",\n",
    "            \"sample_id\",\n",
    "            \"window_idx\",\n",
    "            \"case\",\n",
    "            \"event_type\",\n",
    "            \"status\",\n",
    "            \"y_fault_line\",\n",
    "            \"true_pct\",\n",
    "            \"prior_pct\",\n",
    "            \"pred_pct\",\n",
    "            \"signed_err_pct\",\n",
    "            \"abs_err_pct\",\n",
    "            \"prior_err_pct\",\n",
    "            \"pred_minus_prior_pct\",\n",
    "            \"d_local_real_pct\",\n",
    "            \"d_remote_real_flipped_pct\",\n",
    "            \"d_both_mean_real_pct\",\n",
    "            \"d_both_diff_real_pct\",\n",
    "            \"y_true\",\n",
    "            \"y_pred\",\n",
    "            \"prior_norm\",\n",
    "        ] if c in view.columns\n",
    "    ]\n",
    "\n",
    "    print(f\"\\n=== fold {fold_idx} | selected bad cases ===\")\n",
    "    print(view[cols_show].sort_values([\"case\", \"abs_err_pct\"], ascending=[True, False]).to_string(index=False))\n",
    "\n",
    "    print(f\"\\n=== fold {fold_idx} summary by case ===\")\n",
    "    summary = (\n",
    "        view.groupby(\"case\", dropna=False)\n",
    "        .agg(\n",
    "            n=(\"case\", \"size\"),\n",
    "            mean_true_pct=(\"true_pct\", \"mean\"),\n",
    "            mean_prior_pct=(\"prior_pct\", \"mean\"),\n",
    "            mean_pred_pct=(\"pred_pct\", \"mean\"),\n",
    "            mae_pct=(\"abs_err_pct\", \"mean\"),\n",
    "            bias_pct=(\"signed_err_pct\", \"mean\"),\n",
    "            prior_bias_pct=(\"prior_err_pct\", \"mean\"),\n",
    "            mean_pred_minus_prior_pct=(\"pred_minus_prior_pct\", \"mean\"),\n",
    "        )\n",
    "        .reset_index()\n",
    "    )\n",
    "    print(summary.to_string(index=False))\n",
    "\n",
    "    all_views.append(view)\n",
    "\n",
    "# combined view\n",
    "if all_views:\n",
    "    bad_all = pd.concat(all_views, ignore_index=True)\n",
    "\n",
    "    print(\"\\n=== combined bad-case summary ===\")\n",
    "    combo = (\n",
    "        bad_all.groupby([\"fold\", \"case\"], dropna=False)\n",
    "        .agg(\n",
    "            n=(\"case\", \"size\"),\n",
    "            mae_pct=(\"abs_err_pct\", \"mean\"),\n",
    "            bias_pct=(\"signed_err_pct\", \"mean\"),\n",
    "            mean_true_pct=(\"true_pct\", \"mean\"),\n",
    "            mean_prior_pct=(\"prior_pct\", \"mean\"),\n",
    "            mean_pred_pct=(\"pred_pct\", \"mean\"),\n",
    "            mean_pred_minus_prior_pct=(\"pred_minus_prior_pct\", \"mean\"),\n",
    "        )\n",
    "        .reset_index()\n",
    "        .sort_values([\"fold\", \"case\"])\n",
    "    )\n",
    "    print(combo.to_string(index=False))"
   ]
  },
