    "diagnostic_fields = [\n",
    "    \"gate_value\",\n",
    "    \"raw_residual\",\n",
    "    \"bounded_residual\",\n",
    "    \"effective_correction\",\n",
    "    \"preclip_prediction\",\n",
    "    \"postclip_prediction\",\n",
    "]\n",
    "\n",
    "\n",
    "diagnostic_rows: list[dict[str, Any]] = []\n",
    "\n",
    "\n",
    "for experiment_id in [\n",
    "    \"L90-1E\",\n",
    "    \"L110-1E\",\n",
    "    \"L90-2E\",\n",
    "    \"L110-2E\",\n",
    "]:\n",
    "    experiment_manifest = manifest[\n",
    "        \"experiments\"\n",
    "    ][experiment_id]\n",
    "\n",
    "    selected_path = experiment_manifest[\n",
    "        \"selected_prediction_artifact\"\n",
    "    ]\n",
    "\n",
    "    if selected_path is None:\n",
    "        diagnostic_rows.append(\n",
    "            {\n",
    "                \"experiment_id\": experiment_id,\n",
    "                \"artifact_path\": None,\n",
    "                \"diagnostic_field\": None,\n",
    "                \"status\": (\n",
    "                    \"prediction_artifact_unresolved\"\n",
    "                ),\n",
    "                \"matches\": \"\",\n",
    "            }\n",
    "        )\n",
    "        continue\n",
    "\n",
    "    record = schema_record_by_path[\n",
    "        selected_path\n",
    "    ]\n",
    "\n",
    "    for diagnostic_field in diagnostic_fields:\n",
    "        resolution = (\n",
    "            record\n",
    "            .get(\"alias_resolution\", {})\n",
    "            .get(\n",
    "                diagnostic_field,\n",
    "                {\n",
    "                    \"status\": \"missing\",\n",
    "                    \"matches\": [],\n",
    "                },\n",
    "            )\n",
    "        )\n",
    "\n",
    "        diagnostic_rows.append(\n",
    "            {\n",
    "                \"experiment_id\": experiment_id,\n",
    "                \"artifact_path\": selected_path,\n",
    "                \"diagnostic_field\": (\n",
    "                    diagnostic_field\n",
    "                ),\n",
    "                \"status\": resolution[\"status\"],\n",
    "                \"matches\": \"|\".join(\n",
    "                    resolution[\"matches\"]\n",
    "                ),\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "diagnostic_availability = pd.DataFrame(\n",
    "    diagnostic_rows\n",
    ")\n",
    "\n",
    "diagnostic_availability_path = (\n",
