    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# Existing operator dataframe\n",
    "operator_csv = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_line_caseaware_takagi_prior.csv\"\n",
    "df = pd.read_csv(operator_csv)\n",
    "\n",
    "# Settings dataframe\n",
    "settings_path = \"/home/vault/iwi5/iwi5305h/hv_double_line_110kv/labels/settings.csv\"\n",
    "settings = pd.read_csv(settings_path)\n",
    "\n",
    "metadata_cols = [\n",
    "    \"general/sim_idx\",\n",
    "    \"events/event_type\",\n",
    "    \"events/event_target\",\n",
    "    \"events/event_flt_target_line_location\",\n",
    "    \"events/event_flt_shc_resistance\",\n",
    "    \"events/event_flt_hif_resistance\",\n",
    "    \"events/event_phase_select_1ph\",\n",
    "    \"events/event_phase_select_2ph\",\n",
    "    \"events/event_iflt_duration\",\n",
    "    \"arc/arc_tau\",\n",
    "    \"arc/arc_u0\",\n",
    "    \"arc/arc_r0\",\n",
    "    \"events/event_iflt_arc_on\",\n",
    "]\n",
    "\n",
    "metadata_cols = [c for c in metadata_cols if c in settings.columns]\n",
    "\n",
    "settings_small = settings[metadata_cols].drop_duplicates(subset=[\"general/sim_idx\"])\n",
    "\n",
    "df_merged = df.merge(\n",
    "    settings_small,\n",
    "    left_on=\"sample_id\",\n",
    "    right_on=\"general/sim_idx\",\n",
    "    how=\"left\",\n",
    "    validate=\"many_to_one\",\n",
    ")\n",
    "\n",
    "print(\"Operator shape:\", df.shape)\n",
    "print(\"Merged shape:\", df_merged.shape)\n",
    "\n",
    "print(\"Missing metadata rate:\")\n",
    "for c in metadata_cols:\n",
    "    if c != \"general/sim_idx\":\n",
    "        print(c, df_merged[c].isna().mean())"
   ]
  },
