   "source": [
    "experiment_window_frames: dict[str, pd.DataFrame] = {}\n",
    "experiment_saved_event_frames: dict[str, pd.DataFrame] = {}\n",
    "experiment_reconstructed_events: dict[str, pd.DataFrame] = {}\n",
    "\n",
    "\n",
    "for experiment_id, config in EXPERIMENTS.items():\n",
