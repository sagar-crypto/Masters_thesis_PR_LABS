    "PRIOR_EXACT_ALIASES = {\n",
    "    \"d_two_ended_posseq_plus_input_pct\",\n",
    "    \"y_prior_pct\",\n",
    "    \"prior_pct\",\n",
    "    \"prior_prediction_pct\",\n",
    "    \"prior_prediction\",\n",
    "    \"physics_prior_pct\",\n",
    "    \"kol_prior_pct\",\n",
    "    \"model_input_prior_pct\",\n",
    "    \"prepared_prior_pct\",\n",
    "    \"prior_input_pct\",\n",
    "    \"d_prior_input_pct\",\n",
    "    \"d_kol_input_pct\",\n",
    "    \"d_selected_input_pct\",\n",
    "    \"d_selected_prior_pct\",\n",
    "}\n",
    "\n",
    "\n",
    "def exact_prior_alias_matches(\n",
    "    columns: Iterable[str],\n",
    ") -> list[str]:\n",
    "    normalized_aliases = {\n",
    "        normalize_name(alias)\n",
    "        for alias in PRIOR_EXACT_ALIASES\n",
    "    }\n",
    "\n",
    "    return sorted(\n",
    "        column\n",
    "        for column in columns\n",
    "        if normalize_name(column) in normalized_aliases\n",
    "    )\n",
    "\n",
    "\n",
    "def prior_like_columns(\n",
    "    columns: Iterable[str],\n",
    ") -> list[str]:\n",
    "    output = []\n",
    "\n",
    "    keywords = [\n",
    "        \"prior\",\n",
    "        \"physics\",\n",
    "        \"takagi\",\n",
    "        \"operator\",\n",
    "        \"two_ended\",\n",
    "        \"one_ended\",\n",
    "        \"selected\",\n",
    "        \"input_pct\",\n",
    "        \"kol\",\n",
    "    ]\n",
    "\n",
    "    for column in columns:\n",
    "        normalized = normalize_name(column)\n",
    "\n",
    "        if any(\n",
    "            keyword in normalized\n",
    "            for keyword in keywords\n",
    "        ):\n",
    "            output.append(str(column))\n",
    "\n",
    "    return sorted(set(output))\n",
    "\n",
    "\n",
    "prior_candidate_rows = []\n",
    "\n",
    "\n",
    "for experiment_id, experiment_info in EXPERIMENTS.items():\n",
    "    entry = manifest[\"experiments\"][experiment_id]\n",
    "\n",
    "    prediction_path_string = entry.get(\n",
    "        \"selected_prediction_artifact\"\n",
    "    )\n",
    "\n",
    "    if prediction_path_string is None:\n",
    "        prior_candidate_rows.append(\n",
    "            {\n",
    "                \"experiment_id\": experiment_id,\n",
    "                \"candidate_type\": (\n",
    "                    \"prediction_artifact_unresolved\"\n",
    "                ),\n",
    "                \"path\": \"\",\n",
    "                \"exact_prior_matches\": \"\",\n",
    "                \"prior_like_columns\": \"\",\n",
    "                \"row_count\": None,\n",
    "                \"source_log_or_config\": \"\",\n",
    "            }\n",
    "        )\n",
    "        continue\n",
    "\n",
    "    prediction_path = Path(prediction_path_string)\n",
    "    prediction_columns = table_columns(prediction_path)\n",
    "\n",
    "    exact_matches = exact_prior_alias_matches(\n",
    "        prediction_columns\n",
    "    )\n",
    "\n",
    "    prior_candidate_rows.append(\n",
    "        {\n",
    "            \"experiment_id\": experiment_id,\n",
    "            \"candidate_type\": \"prediction_table\",\n",
    "            \"path\": str(prediction_path),\n",
    "            \"exact_prior_matches\": \"|\".join(\n",
    "                exact_matches\n",
    "            ),\n",
    "            \"prior_like_columns\": \"|\".join(\n",
    "                prior_like_columns(prediction_columns)\n",
    "            ),\n",
    "            \"row_count\": table_row_count(prediction_path),\n",
    "            \"source_log_or_config\": \"\",\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "# Add data files referenced by experiment-specific logs or configs.\n",
    "for experiment_id in EXPERIMENTS:\n",
    "    experiment_token = EXPERIMENT_TOKENS[\n",
    "        experiment_id\n",
    "    ]\n",
    "\n",
    "    experiment_references = path_references.loc[\n",
    "        path_references[\"source_path\"]\n",
    "        .astype(str)\n",
    "        .map(compact_token)\n",
    "        .str.contains(\n",
    "            experiment_token,\n",
    "            regex=False,\n",
    "            na=False,\n",
    "        )\n",
    "        & (\n",
    "            path_references[\"exists\"]\n",
    "            .astype(str)\n",
    "            .str.lower()\n",
    "            .isin([\"true\", \"1\"])\n",
    "        )\n",
    "        & (\n",
    "            path_references[\"is_file\"]\n",
    "            .astype(str)\n",
    "            .str.lower()\n",
    "            .isin([\"true\", \"1\"])\n",
    "        )\n",
    "    ].copy()\n",
    "\n",
    "    for _, reference in experiment_references.iterrows():\n",
    "        candidate_path = Path(\n",
    "            reference[\"referenced_path\"]\n",
    "        )\n",
    "\n",
    "        if candidate_path.suffix.lower() not in {\n",
    "            \".csv\",\n",
    "            \".parquet\",\n",
    "        }:\n",
    "            continue\n",
    "\n",
    "        normalized_path = normalize_name(\n",
    "            candidate_path\n",
    "        )\n",
    "\n",
    "        looks_like_input_or_prior = any(\n",
    "            keyword in normalized_path\n",
    "            for keyword in [\n",
    "                \"model_input\",\n",
    "                \"operator_feature\",\n",
    "                \"physics\",\n",
    "                \"prior\",\n",
    "                \"takagi\",\n",
    "                \"two_ended\",\n",
    "                \"oneended\",\n",
    "                \"one_ended\",\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        if not looks_like_input_or_prior:\n",
    "            continue\n",
    "\n",
    "        try:\n",
    "            columns = table_columns(candidate_path)\n",
    "\n",
    "            prior_candidate_rows.append(\n",
    "                {\n",
    "                    \"experiment_id\": experiment_id,\n",
    "                    \"candidate_type\": (\n",
    "                        \"experiment_referenced_data_file\"\n",
    "                    ),\n",
    "                    \"path\": str(candidate_path),\n",
    "                    \"exact_prior_matches\": \"|\".join(\n",
    "                        exact_prior_alias_matches(columns)\n",
    "                    ),\n",
    "                    \"prior_like_columns\": \"|\".join(\n",
    "                        prior_like_columns(columns)\n",
    "                    ),\n",
    "                    \"row_count\": table_row_count(\n",
    "                        candidate_path\n",
    "                    ),\n",
    "                    \"source_log_or_config\": reference[\n",
    "                        \"source_path\"\n",
    "                    ],\n",
    "                }\n",
    "            )\n",
    "\n",
    "        except Exception as exc:\n",
    "            prior_candidate_rows.append(\n",
    "                {\n",
    "                    \"experiment_id\": experiment_id,\n",
    "                    \"candidate_type\": (\n",
    "                        \"experiment_referenced_data_file_error\"\n",
    "                    ),\n",
    "                    \"path\": str(candidate_path),\n",
    "                    \"exact_prior_matches\": \"\",\n",
    "                    \"prior_like_columns\": \"\",\n",
    "                    \"row_count\": None,\n",
    "                    \"source_log_or_config\": reference[\n",
    "                        \"source_path\"\n",
    "                    ],\n",
    "                    \"error\": repr(exc),\n",
    "                }\n",
    "            )\n",
    "\n",
    "\n",
    "prior_candidates = pd.DataFrame(\n",
    "    prior_candidate_rows\n",
    ").drop_duplicates()\n",
    "\n",
    "prior_candidates.to_csv(\n",
    "    PRIOR_CANDIDATES_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "print(\"Saved:\", PRIOR_CANDIDATES_PATH)\n",
    "\n",
    "display(\n",
    "    prior_candidates.sort_values(\n",
    "        [\n",
    "            \"experiment_id\",\n",
    "            \"candidate_type\",\n",
    "            \"path\",\n",
    "        ],\n",
    "        kind=\"stable\",\n",
    "    )\n",
    ")"
   ]
  },
