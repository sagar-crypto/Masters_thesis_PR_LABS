   "source": [
    "def summarize_slg_priors(df, name=\"df\"):\n",
    "    slg = df[df[\"case\"].isin([\"slg_a\", \"slg_b\", \"slg_c\"])].copy()\n",
    "\n",
    "    candidate_cols = {\n",
    "        \"old_default\": \"d_phys_real_pct\",\n",
    "        \"takagi_local\": \"d_takagi_local_pct\",\n",
    "        \"remote_flipped\": \"d_takagi_remote_flipped_pct\",\n",
    "        \"both_mean\": \"d_takagi_both_mean_pct\",\n",
    "    }\n",
    "\n",
    "    # Keep only columns that exist\n",
    "    candidate_cols = {k: v for k, v in candidate_cols.items() if v in slg.columns}\n",
    "\n",
    "    rows = []\n",
    "    for (line, case), g in slg.groupby([\"y_fault_line\", \"case\"]):\n",
    "        row = {\"source\": name, \"line\": line, \"case\": case, \"n\": len(g)}\n",
    "        y = g[\"y_fault_location\"]\n",
    "\n",
    "        for label, col in candidate_cols.items():\n",
    "            err = g[col] - y\n",
    "            row[f\"{label}_mae\"] = err.abs().mean()\n",
    "            row[f\"{label}_bias\"] = err.mean()\n",
    "            row[f\"{label}_std\"] = err.std()\n",
    "\n",
    "        # Find best candidate by MAE\n",
    "        mae_items = {\n",
    "            label: row[f\"{label}_mae\"]\n",
    "            for label in candidate_cols.keys()\n",
    "        }\n",
    "        best_name = min(mae_items, key=mae_items.get)\n",
    "        row[\"best_prior\"] = best_name\n",
    "        row[\"best_prior_mae\"] = mae_items[best_name]\n",
    "\n",
    "        rows.append(row)\n",
    "\n",
    "    return pd.DataFrame(rows).sort_values([\"line\", \"case\"])\n",
    "\n",
    "new_slg_summary = summarize_slg_priors(new_df, name=\"k0fixed_raw\")\n",
    "new_slg_summary.round(2)"
   ]
  },
