   "outputs": [],
   "source": [
    "# Metadata identities\n",
    "for column in [\n",
    "    \"case\",\n",
    "    \"y_fault_line\",\n",
    "    \"event_type\",\n",
    "]:\n",
    "    reconstructed_column = (\n",
    "        f\"{column}_reconstructed\"\n",
    "    )\n",
    "\n",
    "    saved_column = f\"{column}_saved\"\n",
    "\n",
    "    metadata_equal_mask = (\n",
    "        comparison[reconstructed_column]\n",
    "        .fillna(\"<NA>\")\n",
    "        .astype(str)\n",
    "        .eq(\n",
    "            comparison[saved_column]\n",
    "            .fillna(\"<NA>\")\n",
    "            .astype(str)\n",
    "        )\n",
    "    )\n",
    "\n",
    "    metadata_match = bool(\n",
    "        metadata_equal_mask.all()\n",
    "    )\n",
    "\n",
    "    mismatch_count = int(\n",
    "        (~metadata_equal_mask).sum()\n",
    "    )\n",
    "\n",
    "    add_check(\n",
    "        experiment_id=experiment_id,\n",
    "        category=\"event_aggregation\",\n",
    "        check_name=(\n",
    "            f\"saved_{column}_matches_\"\n",
    "            f\"reconstructed\"\n",
    "        ),\n",
    "        observed=mismatch_count,\n",
    "        expected=0,\n",
    "        passed=metadata_match,\n",
    "        mandatory=(\n",
    "            column != \"event_type\"\n",
    "        ),\n",
    "    )"
   ]
  },
