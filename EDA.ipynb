   "source": [
    "dataset_name = \"Double-Line 110 kV Dataset\"\n",
    "\n",
    "out_dir = Path(\"dataset_insights_plots\")\n",
    "out_dir.mkdir(exist_ok=True)\n",
    "\n",
    "df110_plot = df110.copy()\n",
    "\n",
    "# Keep only actual fault events\n",
    "fault_mask = df110_plot[\"events/event_type\"].astype(str).str.startswith(\"flt_\")\n",
    "df110_faults = df110_plot[fault_mask].copy()\n",
    "\n",
    "def map_fault_type_110(event_type: str) -> str:\n",
    "    event_type = str(event_type).strip().lower()\n",
    "\n",
    "    if event_type in {\n",
    "        \"flt_3ph_shc\",\n",
    "    }:\n",
    "        return \"3-phase short-circuit\"\n",
    "\n",
    "    if event_type in {\n",
    "        \"flt_2ph_shc\",\n",
    "    }:\n",
    "        return \"2-phase short-circuit\"\n",
    "\n",
    "    if event_type in {\n",
    "        \"flt_1phg_shc\",\n",
    "        \"flt_1phg_shc_w_arc\",\n",
    "        \"flt_1phg_incipient\",\n",
    "        \"flt_1phg_incipient_w_arc\",\n",
    "    }:\n",
    "        return \"1-phase-to-ground short-circuit\"\n",
    "\n",
    "    if event_type in {\n",
    "        \"flt_2phg_shc\",\n",
    "    }:\n",
    "        return \"2-phase-to-ground short-circuit\"\n",
    "\n",
    "    return \"Other fault\"\n",
    "\n",
    "df110_faults[\"fault_type_readable\"] = df110_faults[\"events/event_type\"].apply(map_fault_type_110)\n",
    "\n",
    "order_110 = [\n",
    "    \"3-phase short-circuit\",\n",
    "    \"2-phase short-circuit\",\n",
    "    \"1-phase-to-ground short-circuit\",\n",
    "    \"2-phase-to-ground short-circuit\",\n",
    "    \"Other fault\",\n",
    "]\n",
    "\n",
    "counts_110 = df110_faults[\"fault_type_readable\"].value_counts()\n",
    "counts_110 = counts_110.reindex([x for x in order_110 if x in counts_110.index])\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(5.98, 4.32))\n",
    "counts_110.plot(kind=\"bar\", ax=ax)\n",
    "\n",
    "ax.set_title(f\"Fault Type Distribution — {dataset_name}\")\n",
    "ax.set_xlabel(\"Fault type\")\n",
    "ax.set_ylabel(\"Number of samples\")\n",
    "plt.xticks(rotation=20, ha=\"right\")\n",
    "plt.tight_layout()\n",
    "\n",
    "fig.savefig(out_dir / \"fault_type_distribution_110kv.svg\", dpi=300, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "\n",
    "counts_110"
   ]
