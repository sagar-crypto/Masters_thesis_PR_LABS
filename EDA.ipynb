    "dataset_name = \"Double-Line 90 kV Dataset\"\n",
    "\n",
    "out_dir = Path(\"dataset_insights_plots\")\n",
    "out_dir.mkdir(exist_ok=True)\n",
    "\n",
    "df_plot = df.copy()\n",
    "\n",
    "fault_type_map_90 = {\n",
    "    0: \"3-phase short-circuit\",\n",
    "    1: \"2-phase short-circuit\",\n",
    "    2: \"1-phase short-circuit\",\n",
    "    3: \"2-phase-to-ground short-circuit\",\n",
    "}\n",
    "\n",
    "df_plot[\"fault_type_readable\"] = df_plot[\"sc_type\"].map(fault_type_map_90)\n",
    "\n",
    "order_90 = [\n",
    "    \"3-phase short-circuit\",\n",
    "    \"2-phase short-circuit\",\n",
    "    \"1-phase short-circuit\",\n",
    "    \"2-phase-to-ground short-circuit\",\n",
    "]\n",
    "\n",
    "counts = df_plot[\"fault_type_readable\"].value_counts()\n",
    "counts = counts.reindex([x for x in order_90 if x in counts.index])\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(5.98, 4.32))\n",
    "counts.plot(kind=\"bar\", ax=ax)\n",
    "\n",
    "ax.set_title(f\"Fault Type Distribution — {dataset_name}\")\n",
    "ax.set_xlabel(\"Fault type\")\n",
    "ax.set_ylabel(\"Number of samples\")\n",
    "plt.xticks(rotation=20, ha=\"right\")\n",
    "plt.tight_layout()\n",
    "\n",
    "fig.savefig(out_dir / \"fault_type_distribution_90kv.svg\", dpi=300, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "\n",
    "counts"
   ]
