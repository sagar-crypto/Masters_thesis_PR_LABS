    "\n",
    "    add_check(\n",
    "        experiment_id=experiment_id,\n",
    "        category=\"identity\",\n",
    "        check_name=\"topology\",\n",
    "        observed=normalized_topologies,\n",
    "        expected=[config[\"topology\"]],\n",
    "        passed=normalized_topologies == [\n",
    "            config[\"topology\"]\n",
    "        ],\n",
    "    )\n",
    "\n",
    "    # -------------------------------------------------------------\n",
    "    # Frozen cohort\n",
    "    # -------------------------------------------------------------\n",
    "\n",
    "    row_count = len(window_frame)\n",
    "\n",
    "    unique_event_count = window_frame[\n",
    "        \"sample_id\"\n",
    "    ].nunique(dropna=False)\n",
    "\n",
    "    add_check(\n",
    "        experiment_id=experiment_id,\n",
