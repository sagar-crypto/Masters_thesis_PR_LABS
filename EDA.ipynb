    "for experiment_id, config in EXPERIMENTS.items():\n",
    "    frame = experiment_frames[experiment_id]\n",
    "\n",
    "    if config[\"prior_view\"] == \"1E\":\n",
    "        run_root = SINGLE_RUN_ROOT\n",
    "    else:\n",
    "        run_root = DOUBLE_RUN_ROOT\n",
    "\n",
    "    per_fold_files = discover_per_fold_prediction_files(\n",
    "        experiment_id,\n",
    "        run_root,\n",
    "    )\n",
    "\n",
    "    consolidated_alpha_present = (\n",
    "        \"alpha\" in frame.columns\n",
    "    )\n",
    "\n",
    "    consolidated_residual_present = (\n",
    "        \"residual\" in frame.columns\n",
    "    )\n",
    "\n",
    "    consolidated_alpha_non_null = (\n",
    "        int(frame[\"alpha\"].notna().sum())\n",
    "        if consolidated_alpha_present\n",
    "        else 0\n",
    "    )\n",
    "\n",
    "    consolidated_residual_non_null = (\n",
    "        int(frame[\"residual\"].notna().sum())\n",
    "        if consolidated_residual_present\n",
    "        else 0\n",
    "    )\n",
    "\n",
    "    per_fold_alpha_files = []\n",
    "    per_fold_residual_files = []\n",
    "    per_fold_row_count = 0\n",
    "\n",
    "    for path in per_fold_files:\n",
    "        parquet_file = pq.ParquetFile(path)\n",
    "\n",
    "        columns = set(\n",
    "            parquet_file.schema_arrow.names\n",
    "        )\n",
    "\n",
    "        per_fold_row_count += int(\n",
    "            parquet_file.metadata.num_rows\n",
    "        )\n",
    "\n",
    "        if \"alpha\" in columns:\n",
    "            per_fold_alpha_files.append(\n",
    "                str(path)\n",
    "            )\n",
    "\n",
    "        if \"residual\" in columns:\n",
    "            per_fold_residual_files.append(\n",
    "                str(path)\n",
    "            )\n",
    "\n",
    "    if consolidated_alpha_non_null > 0:\n",
    "        alpha_source = \"consolidated_oof\"\n",
    "    elif per_fold_alpha_files:\n",
    "        alpha_source = \"per_fold_predictions\"\n",
    "    else:\n",
    "        alpha_source = \"unavailable\"\n",
    "\n",
    "    if consolidated_residual_non_null > 0:\n",
    "        residual_source = \"consolidated_oof\"\n",
    "    elif per_fold_residual_files:\n",
    "        residual_source = \"per_fold_predictions\"\n",
    "    else:\n",
    "        residual_source = \"unavailable\"\n",
