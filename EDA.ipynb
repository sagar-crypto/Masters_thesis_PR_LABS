    "TEXT_SUFFIXES = {\n",
    "    \".json\",\n",
    "    \".yaml\",\n",
    "    \".yml\",\n",
    "    \".txt\",\n",
    "    \".log\",\n",
    "    \".md\",\n",
    "    \".sh\",\n",
    "    \".slurm\",\n",
    "    \".cfg\",\n",
    "    \".ini\",\n",
    "    \".toml\",\n",
    "}\n",
    "\n",
    "\n",
    "ABSOLUTE_CSV_PATTERN = re.compile(\n",
    "    r\"\"\"(/[^\\s\"'<>]+\\.csv)\"\"\"\n",
    ")\n",
    "\n",
    "\n",
    "def compact_token(value: Any) -> str:\n",
    "    return re.sub(\n",
    "        r\"[^A-Z0-9]+\",\n",
    "        \"\",\n",
    "        str(value).upper(),\n",
    "    )\n",
    "\n",
    "\n",
    "single_reference_rows = []\n",
    "\n",
    "\n",
    "for text_path in SINGLE_RUN_ROOT.rglob(\"*\"):\n",
    "    if (\n",
    "        not text_path.is_file()\n",
    "        or text_path.suffix.lower()\n",
    "        not in TEXT_SUFFIXES\n",
    "    ):\n",
    "        continue\n",
    "\n",
    "    try:\n",
    "        if text_path.stat().st_size > 20 * 1024 * 1024:\n",
    "            continue\n",
    "\n",
    "        text = text_path.read_text(\n",
    "            encoding=\"utf-8\",\n",
    "            errors=\"replace\",\n",
    "        )\n",
    "\n",
    "    except OSError:\n",
    "        continue\n",
    "\n",
    "    experiments_in_source = [\n",
    "        experiment_id\n",
    "        for experiment_id in [\n",
    "            \"C90-1E\",\n",
    "            \"L90-1E\",\n",
    "            \"C110-1E\",\n",
    "            \"L110-1E\",\n",
    "        ]\n",
    "        if compact_token(experiment_id)\n",
    "        in compact_token(\n",
    "            str(text_path) + \"\\n\" + text\n",
    "        )\n",
    "    ]\n",
    "\n",
    "    csv_paths = sorted(\n",
    "        set(\n",
    "            match.rstrip(\".,;:)]}\")\n",
    "            for match in ABSOLUTE_CSV_PATTERN.findall(\n",
    "                text\n",
    "            )\n",
    "        )\n",
    "    )\n",
    "\n",
    "    prior_terms = sorted(\n",
    "        set(\n",
    "            token\n",
    "            for token in re.findall(\n",
    "                r\"\\b[A-Za-z_][A-Za-z0-9_]*\"\n",
    "                r\"(?:prior|takagi|input_pct|physics)\"\n",
    "                r\"[A-Za-z0-9_]*\\b\",\n",
    "                text,\n",
    "                flags=re.IGNORECASE,\n",
    "            )\n",
    "        )\n",
    "    )\n",
    "\n",
    "    if not csv_paths and not prior_terms:\n",
    "        continue\n",
    "\n",
    "    for experiment_id in experiments_in_source:\n",
    "        single_reference_rows.append(\n",
    "            {\n",
    "                \"experiment_id\": experiment_id,\n",
    "                \"source_file\": str(text_path),\n",
    "                \"referenced_csv_paths\": \"|\".join(\n",
    "                    csv_paths\n",
    "                ),\n",
    "                \"existing_csv_paths\": \"|\".join(\n",
    "                    path\n",
    "                    for path in csv_paths\n",
    "                    if Path(path).exists()\n",
    "                ),\n",
    "                \"prior_related_terms\": \"|\".join(\n",
    "                    prior_terms\n",
    "                ),\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "single_prior_references = pd.DataFrame(\n",
    "    single_reference_rows\n",
    ").drop_duplicates()\n",
    "\n",
    "\n",
    "display(\n",
    "    single_prior_references.sort_values(\n",
    "        [\"experiment_id\", \"source_file\"],\n",
    "        kind=\"stable\",\n",
    "    )\n",
    ")"
