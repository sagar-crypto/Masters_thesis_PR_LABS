    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Convert MultiGraph to a normal graph for layout only\n",
    "G_simple = nx.Graph()\n",
    "for u, v, key, attr in G.edges(keys=True, data=True):\n",
    "    G_simple.add_edge(u, v)\n",
    "\n",
    "pos = nx.spring_layout(G_simple, seed=7)\n",
    "\n",
    "edge_colors = []\n",
    "edge_labels = {}\n",
    "\n",
    "for u, v, key, attr in G.edges(keys=True, data=True):\n",
    "    pdict = attr.get(f\"{key}_param_dict\", {})\n",
    "    \n",
    "    if \"rline\" in pdict:\n",
    "        color = \"tab:blue\"\n",
    "    elif \"uktr\" in pdict or \"uk0tr\" in pdict:\n",
    "        color = \"tab:red\"\n",
    "    else:\n",
    "        color = \"tab:gray\"\n",
    "    \n",
    "    edge_colors.append(color)\n",
    "    edge_labels[(u, v)] = key\n",
    "\n",
    "plt.figure(figsize=(13, 8))\n",
    "\n",
    "nx.draw_networkx_nodes(G_simple, pos, node_size=1100, node_color=\"lightgray\")\n",
    "nx.draw_networkx_labels(G_simple, pos, font_size=8)\n",
    "\n",
    "# Draw multigraph edges one by one\n",
    "for (u, v, key, attr), color in zip(G.edges(keys=True, data=True), edge_colors):\n",
    "    nx.draw_networkx_edges(\n",
    "        G_simple,\n",
    "        pos,\n",
    "        edgelist=[(u, v)],\n",
    "        edge_color=color,\n",
    "        width=2.5,\n",
    "        alpha=0.85,\n",
    "    )\n",
    "\n",
    "# For labels, MultiGraph parallel edges overlap, so we print key labels manually near midpoint\n",
    "for u, v, key, attr in G.edges(keys=True, data=True):\n",
    "    x_mid = (pos[u][0] + pos[v][0]) / 2\n",
    "    y_mid = (pos[u][1] + pos[v][1]) / 2\n",
    "    plt.text(x_mid, y_mid, str(key), fontsize=7, ha=\"center\", va=\"center\",\n",
    "             bbox=dict(facecolor=\"white\", alpha=0.7, edgecolor=\"none\"))\n",
    "\n",
    "plt.title(\"Graph pickle topology: blue = line, red = transformer, gray = other\")\n",
    "plt.axis(\"off\")\n",
    "plt.show()"
   ]
  },
