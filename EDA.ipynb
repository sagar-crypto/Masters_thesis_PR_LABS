   "source": [
    "# Old selected\n",
    "old_phase = (\n",
    "    old_slg.assign(abs_err=(old_slg[\"d_phys_real_pct\"] - old_slg[\"y_fault_location\"]).abs())\n",
    "           .groupby(\"case\")\n",
    "           .agg(\n",
    "               n=(\"case\", \"size\"),\n",
    "               old_selected_mae=(\"abs_err\", \"mean\"),\n",
    "           )\n",
    "           .reset_index()\n",
    ")\n",
    "\n",
    "# New best among available raw priors\n",
    "new_best_rows = []\n",
    "for case, gcase in new_df[new_df[\"case\"].isin([\"slg_a\", \"slg_b\", \"slg_c\"])].groupby(\"case\"):\n",
    "    for label, col in {\n",
    "        \"old_default\": \"d_phys_real_pct\",\n",
    "        \"takagi_local\": \"d_takagi_local_pct\",\n",
    "        \"remote_flipped\": \"d_takagi_remote_flipped_pct\",\n",
    "        \"both_mean\": \"d_takagi_both_mean_pct\",\n",
    "    }.items():\n",
    "        if col in gcase.columns:\n",
    "            mae = (gcase[col] - gcase[\"y_fault_location\"]).abs().mean()\n",
    "            new_best_rows.append({\n",
    "                \"case\": case,\n",
    "                \"candidate\": label,\n",
    "                \"mae\": mae,\n",
    "            })\n",
    "\n",
    "new_phase_candidates = pd.DataFrame(new_best_rows)\n",
    "\n",
    "new_phase_best = (\n",
    "    new_phase_candidates.sort_values([\"case\", \"mae\"])\n",
    "                        .groupby(\"case\")\n",
    "                        .head(1)\n",
    "                        .rename(columns={\"candidate\": \"new_best_prior\", \"mae\": \"new_best_mae\"})\n",
    ")\n",
    "\n",
    "phase_compare = old_phase.merge(new_phase_best, on=\"case\", how=\"left\")\n",
    "phase_compare[\"gain_vs_old_selected\"] = (\n",
    "    phase_compare[\"old_selected_mae\"] - phase_compare[\"new_best_mae\"]\n",
    ")\n",
    "\n",
    "phase_compare.round(2)"
   ]
