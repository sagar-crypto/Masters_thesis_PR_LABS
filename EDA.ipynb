    "# Make a copy\n",
    "df110_plot = df110.copy()\n",
    "\n",
    "# Column containing the fault location\n",
    "loc_col = \"events/event_flt_target_line_location\"\n",
    "\n",
    "# Convert to numeric\n",
    "loc_vals = pd.to_numeric(df110_plot[loc_col], errors=\"coerce\").dropna()\n",
    "\n",
    "# If values are in [0,1], convert to percentages\n",
    "if loc_vals.max() <= 1.5:\n",
    "    loc_vals = loc_vals * 100.0\n",
    "\n",
    "# Round to avoid float precision issues like 19.999999\n",
    "loc_vals = loc_vals.round(2)\n",
    "\n",
    "# Print unique values to inspect what is actually present\n",
    "print(\"Unique fault-location values (%):\")\n",
    "print(sorted(loc_vals.unique()))\n",
    "\n",
    "# Count exact discrete locations\n",
    "counts_loc = loc_vals.value_counts().sort_index()\n",
    "\n",
    "# Optional: prettier x-axis labels\n",
    "x_labels = [f\"{int(x)}%\" if float(x).is_integer() else f\"{x:g}%\" for x in counts_loc.index]\n",
    "\n",
    "# Plot\n",
    "fig, ax = plt.subplots(figsize=(5.98, 4.32))\n",
    "ax.bar(range(len(counts_loc)), counts_loc.values)\n",
    "\n",
    "ax.set_title(\"Fault Location Distribution — Double-Line 110 kV Dataset\")\n",
    "ax.set_xlabel(\"Fault location (% of line length)\")\n",
    "ax.set_ylabel(\"Number of samples\")\n",
    "ax.set_xticks(range(len(counts_loc)))\n",
    "ax.set_xticklabels(x_labels, rotation=0)\n",
    "\n",
    "plt.tight_layout()\n",
    "fig.savefig(out_dir / \"fault_type_distribution_110kv.svg\", dpi=300, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "\n",
    "counts_loc"
   ]
  },
