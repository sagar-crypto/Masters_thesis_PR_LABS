    "        \"prediction_before_clipping\",\n",
    "        \"unclipped_prediction\",\n",
    "    ],\n",
    "\n",
    "    \"postclip_prediction\": [\n",
    "        \"postclip_prediction\",\n",
    "        \"post_clip_prediction\",\n",
    "        \"prediction_postclip\",\n",
    "        \"prediction_after_clipping\",\n",
    "        \"clipped_prediction\",\n",
    "    ],\n",
    "}\n",
    "\n",
    "\n",
    "def normalize_name(value: Any) -> str:\n",
    "    \"\"\"\n",
    "    Normalize only case and separators.\n",
    "\n",
    "    This is not fuzzy matching. For example:\n",
    "        y-pred-pct\n",
    "        y_pred_pct\n",
    "        Y Pred Pct\n",
    "    all normalize to the same representation.\n",
    "    \"\"\"\n",
    "    return re.sub(r\"[^a-z0-9]+\", \"_\", str(value).strip().lower()).strip(\"_\")\n",
    "\n",
    "\n",
    "def compact_token(value: Any) -> str:\n",
    "    \"\"\"\n",
    "    Compact normalization used only for detecting known experiment IDs.\n",
    "    \"\"\"\n",
    "    return re.sub(r\"[^A-Z0-9]+\", \"\", str(value).upper())\n",
    "\n",
    "\n",
    "EXPERIMENT_COMPACT_TOKENS = {\n",
    "    experiment_id: compact_token(experiment_id)\n",
    "    for experiment_id in EXPERIMENTS\n",
    "}\n",
    "\n",
    "\n",
    "def resolve_schema_aliases(\n",
    "    columns: Iterable[str],\n",
    ") -> dict[str, dict[str, Any]]:\n",
    "    \"\"\"\n",
    "    Resolve canonical fields using exact normalized alias matching.\n",
    "\n",
    "    Returns one of:\n",
    "        missing\n",
    "        resolved\n",
    "        ambiguous\n",
    "    \"\"\"\n",
    "    original_columns = [str(column) for column in columns]\n",
    "\n",
    "    normalized_to_original: dict[str, list[str]] = defaultdict(list)\n",
    "\n",
    "    for column in original_columns:\n",
    "        normalized_to_original[normalize_name(column)].append(column)\n",
    "\n",
    "    results: dict[str, dict[str, Any]] = {}\n",
    "\n",
    "    for canonical_field, aliases in COLUMN_ALIASES.items():\n",
    "        normalized_aliases = {\n",
    "            normalize_name(alias)\n",
    "            for alias in aliases\n",
    "        }\n",
    "\n",
    "        matches: list[str] = []\n",
    "\n",
    "        for normalized_alias in normalized_aliases:\n",
    "            matches.extend(\n",
    "                normalized_to_original.get(normalized_alias, [])\n",
    "            )\n",
    "\n",
    "        matches = sorted(set(matches))\n",
    "\n",
    "        if len(matches) == 0:\n",
    "            status = \"missing\"\n",
    "        elif len(matches) == 1:\n",
    "            status = \"resolved\"\n",
    "        else:\n",
    "            status = \"ambiguous\"\n",
    "\n",
    "        results[canonical_field] = {\n",
    "            \"status\": status,\n",
    "            \"matches\": matches,\n",
    "        }\n",
    "\n",
    "    return results"
   ]
