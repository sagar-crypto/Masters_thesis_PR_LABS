    "import pandas as pd\n",
    "import numpy as np\n",
    "import re\n",
    "from pathlib import Path\n",
    "\n",
    "run_dir = Path(\n",
    "    \"outputs/MainLn1-2A__kol_operator_features_hv_double_line_110kv_both_all_fault_start_i0res_seq_bothfix__threeph_add_ground_mul__all_fault_start__run_2026-04-26T18:38:36.828121Z\"\n",
    ")\n",
    "\n",
    "ops_path = Path(\n",
    "    \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_both_all_fault_start_i0res_seq_bothfix.csv\"\n",
    ")\n",
    "\n",
    "# Find prediction files robustly\n",
    "pred_files = []\n",
    "for pattern in [\n",
    "    \"fold*_predictions.parquet\",\n",
    "    \"fold*_predictions.csv\",\n",
    "    \"**/fold*_predictions.parquet\",\n",
    "    \"**/fold*_predictions.csv\",\n",
    "]:\n",
    "    pred_files.extend(run_dir.glob(pattern))\n",
    "\n",
    "pred_files = sorted(set(pred_files))\n",
    "\n",
    "print(\"Prediction files found:\")\n",
    "for p in pred_files:\n",
    "    print(\" \", p)\n",
    "\n",
    "if len(pred_files) == 0:\n",
    "    raise FileNotFoundError(\n",
