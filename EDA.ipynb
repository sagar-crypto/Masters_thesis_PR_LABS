   "source": [
    "double_root_string = str(DOUBLE_RUN_ROOT)\n",
    "\n",
    "double_inventory = artifact_inventory.loc[\n",
    "    artifact_inventory[\"path\"].astype(str).str.startswith(\n",
    "        double_root_string\n",
    "    )\n",
    "    & artifact_inventory[\"suffix\"].isin(\n",
    "        [\".parquet\", \".csv\"]\n",
    "    )\n",
    "].copy()\n",
    "\n",
    "\n",
    "prediction_name_mask = (\n",
    "    double_inventory[\"filename\"]\n",
    "    .astype(str)\n",
    "    .str.lower()\n",
    "    .str.contains(\n",
    "        \"oof|prediction|predictions\",\n",
    "        regex=True,\n",
    "        na=False,\n",
    "    )\n",
    ")\n",
    "\n",
    "prediction_role_mask = (\n",
    "    double_inventory[\"artifact_roles\"]\n",
    "    .astype(str)\n",
    "    .str.contains(\n",
    "        \"prediction_candidate\",\n",
    "        na=False,\n",
    "    )\n",
    ")\n",
    "\n",
    "double_prediction_files = double_inventory.loc[\n",
    "    prediction_name_mask | prediction_role_mask\n",
    "].copy()\n",
    "\n",
    "\n",
    "print(\n",
    "    \"Double-ended prediction-like files:\",\n",
    "    len(double_prediction_files),\n",
    ")\n",
    "\n",
    "display(\n",
    "    double_prediction_files[\n",
    "        [\n",
    "            \"path\",\n",
    "            \"suffix\",\n",
    "            \"size_bytes\",\n",
    "            \"artifact_roles\",\n",
    "        ]\n",
    "    ].sort_values(\n",
    "        \"path\",\n",
    "        kind=\"stable\",\n",
    "    )\n",
    ")"
   ]
