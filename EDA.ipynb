    "def json_safe_scalar(value: Any) -> Any:\n",
    "    if value is None:\n",
    "        return None\n",
    "\n",
    "    if isinstance(value, (str, int, float, bool)):\n",
    "        if isinstance(value, float) and not np.isfinite(value):\n",
    "            return str(value)\n",
    "        return value\n",
    "\n",
    "    if isinstance(value, np.generic):\n",
    "        return json_safe_scalar(value.item())\n",
    "\n",
    "    if isinstance(value, pd.Timestamp):\n",
    "        return value.isoformat()\n",
    "\n",
    "    return str(value)\n",
    "\n",
    "\n",
    "def safe_unique_values(\n",
    "    series: pd.Series,\n",
    "    maximum: int = 50,\n",
    ") -> list[Any]:\n",
    "    non_null = series.dropna()\n",
    "\n",
    "    if non_null.empty:\n",
    "        return []\n",
    "\n",
    "    unique_values = pd.unique(non_null)\n",
    "\n",
    "    cleaned = [\n",
    "        json_safe_scalar(value)\n",
    "        for value in unique_values[:maximum]\n",
    "    ]\n",
    "\n",
    "    return cleaned\n",
    "\n",
    "\n",
    "def read_csv_sample(\n",
    "    path: Path,\n",
    "    nrows: int = MAX_CSV_SCHEMA_SAMPLE_ROWS,\n",
    ") -> tuple[pd.DataFrame, str]:\n",
    "    \"\"\"\n",
    "    Read a small CSV sample.\n",
    "\n",
    "    First use delimiter inference. If that fails, fall back to comma.\n",
    "    \"\"\"\n",
    "    first_error: Exception | None = None\n",
    "\n",
    "    try:\n",
    "        sample = pd.read_csv(\n",
    "            path,\n",
    "            sep=None,\n",
    "            engine=\"python\",\n",
    "            nrows=nrows,\n",
    "            low_memory=False,\n",
    "        )\n",
    "        return sample, \"inferred\"\n",
    "\n",
    "    except Exception as exc:\n",
    "        first_error = exc\n",
    "\n",
    "    try:\n",
    "        sample = pd.read_csv(\n",
    "            path,\n",
    "            sep=\",\",\n",
    "            nrows=nrows,\n",
    "            low_memory=False,\n",
    "        )\n",
    "        return sample, \"comma_fallback\"\n",
    "\n",
    "    except Exception as second_error:\n",
    "        raise RuntimeError(\n",
    "            f\"CSV sample read failed. \"\n",
    "            f\"Inference error={first_error!r}; \"\n",
    "            f\"comma error={second_error!r}\"\n",
    "        ) from second_error\n",
    "\n",
    "\n",
    "PROBE_CANONICAL_FIELDS = [\n",
    "    \"experiment_id\",\n",
    "    \"topology\",\n",
    "    \"prior_view\",\n",
    "    \"model_family\",\n",
    "    \"prediction_level\",\n",
    "    \"fold\",\n",
    "    \"window_idx\",\n",
    "]\n",
    "\n",
    "\n",
    "def build_probe_values(\n",
    "    sample: pd.DataFrame,\n",
    "    alias_resolution: dict[str, dict[str, Any]],\n",
    ") -> dict[str, list[Any]]:\n",
    "    probe_values: dict[str, list[Any]] = {}\n",
    "\n",
    "    for canonical_field in PROBE_CANONICAL_FIELDS:\n",
    "        resolution = alias_resolution.get(\n",
    "            canonical_field,\n",
    "            {},\n",
    "        )\n",
    "\n",
    "        matches = resolution.get(\"matches\", [])\n",
    "\n",
    "        if len(matches) != 1:\n",
    "            continue\n",
    "\n",
    "        column = matches[0]\n",
    "\n",
    "        if column not in sample.columns:\n",
    "            continue\n",
    "\n",
    "        probe_values[canonical_field] = safe_unique_values(\n",
    "            sample[column],\n",
    "            maximum=50,\n",
    "        )\n",
    "\n",
    "    return probe_values\n",
    "\n",
    "\n",
    "def inspect_parquet_schema(path: Path) -> dict[str, Any]:\n",
    "    parquet_file = pq.ParquetFile(path)\n",
    "\n",
    "    columns = parquet_file.schema_arrow.names\n",
    "\n",
    "    alias_resolution = resolve_schema_aliases(columns)\n",
    "\n",
    "    probe_columns: list[str] = []\n",
    "\n",
    "    for canonical_field in PROBE_CANONICAL_FIELDS:\n",
    "        matches = alias_resolution[\n",
    "            canonical_field\n",
    "        ][\"matches\"]\n",
    "\n",
    "        if len(matches) == 1:\n",
    "            probe_columns.append(matches[0])\n",
    "\n",
    "    probe_columns = sorted(set(probe_columns))\n",
    "\n",
    "    if probe_columns:\n",
    "        # Only selected metadata columns are read, not waveform arrays or\n",
    "        # all numeric prediction columns.\n",
    "        probe_table = parquet_file.read(\n",
    "            columns=probe_columns,\n",
    "            use_threads=True,\n",
    "        )\n",
    "\n",
    "        probe_sample = probe_table.to_pandas()\n",
    "    else:\n",
    "        probe_sample = pd.DataFrame()\n",
    "\n",
    "    return {\n",
    "        \"path\": str(path),\n",
    "        \"format\": \"parquet\",\n",
    "        \"size_bytes\": int(path.stat().st_size),\n",
    "        \"row_count\": int(\n",
    "            parquet_file.metadata.num_rows\n",
    "        ),\n",
    "        \"row_group_count\": int(\n",
    "            parquet_file.metadata.num_row_groups\n",
    "        ),\n",
    "        \"columns\": [str(column) for column in columns],\n",
    "        \"column_count\": len(columns),\n",
    "        \"alias_resolution\": alias_resolution,\n",
    "        \"probe_values\": build_probe_values(\n",
    "            probe_sample,\n",
    "            alias_resolution,\n",
    "        ),\n",
    "        \"schema_error\": None,\n",
    "    }\n",
    "\n",
    "\n",
    "def inspect_csv_schema(path: Path) -> dict[str, Any]:\n",
    "    sample, delimiter_mode = read_csv_sample(path)\n",
    "\n",
    "    columns = [str(column) for column in sample.columns]\n",
    "\n",
    "    alias_resolution = resolve_schema_aliases(columns)\n",
    "\n",
    "    return {\n",
    "        \"path\": str(path),\n",
    "        \"format\": \"csv\",\n",
    "        \"size_bytes\": int(path.stat().st_size),\n",
    "        # Full CSV row counting is intentionally deferred.\n",
    "        \"row_count\": None,\n",
    "        \"sample_row_count\": int(len(sample)),\n",
    "        \"delimiter_mode\": delimiter_mode,\n",
    "        \"columns\": columns,\n",
    "        \"column_count\": len(columns),\n",
    "        \"alias_resolution\": alias_resolution,\n",
    "        \"probe_values\": build_probe_values(\n",
    "            sample,\n",
    "            alias_resolution,\n",
    "        ),\n",
    "        \"schema_error\": None,\n",
    "    }"
   ]
  },
