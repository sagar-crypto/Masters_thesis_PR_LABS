   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "in_csv = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_caseaware_family_takagi_prior.csv\"\n",
    "\n",
    "out_csv = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_line_caseaware_takagi_prior.csv\"\n",
    "\n",
    "df = pd.read_csv(in_csv)\n",
    "\n",
    "line_col = \"y_fault_line\"\n",
    "case_col = \"case\"\n",
    "\n",
    "required_cols = [\n",
    "    line_col,\n",
    "    case_col,\n",
    "    \"d_phys_real_pct_original\",\n",
    "    \"d_takagi_local_pct\",\n",
    "    \"d_takagi_remote_flipped_pct\",\n",
    "    \"d_takagi_both_mean_pct\",\n",
    "    \"d_phys_real_pct\",\n",
    "]\n",
    "\n",
    "missing = [c for c in required_cols if c not in df.columns]\n",
    "if missing:\n",
    "    raise ValueError(f\"Missing columns: {missing}\")\n",
    "\n",
    "# Keep previous selected prior for comparison\n",
    "df[\"d_phys_real_pct_before_line_caseaware\"] = df[\"d_phys_real_pct\"]\n",
    "\n",
    "# Start with old prior as default\n",
    "df[\"d_phys_real_pct\"] = df[\"d_phys_real_pct_original\"]\n",
    "df[\"d_phys_real_strategy\"] = \"old_default\"\n",
    "\n",
    "# Case groups\n",
    "main12_lines = [\"MainLn1-2A\", \"MainLn1-2B\"]\n",
    "main23_lines = [\"MainLn2-3A\", \"MainLn2-3B\"]\n",
    "\n",
    "takagi_cases = [\n",
    "    \"3ph\",\n",
    "    \"ll_ab\", \"ll_bc\", \"ll_ca\",\n",
    "    \"llg_ab\", \"llg_bc\", \"llg_ca\",\n",
    "]\n",
    "\n",
    "# MainLn1-2A/B: local Takagi is best for 3ph, LL, LLG\n",
    "mask_main12_takagi = (\n",
    "    df[line_col].isin(main12_lines)\n",
    "    & df[case_col].isin(takagi_cases)\n",
    ")\n",
    "\n",
    "df.loc[mask_main12_takagi, \"d_phys_real_pct\"] = df.loc[\n",
    "    mask_main12_takagi, \"d_takagi_local_pct\"\n",
    "]\n",
    "df.loc[mask_main12_takagi, \"d_phys_real_strategy\"] = \"takagi_local_main12_3ph_ll_llg\"\n",
    "\n",
    "# MainLn2-3A/B: remote flipped Takagi is best for 3ph, LL, LLG\n",
    "mask_main23_takagi = (\n",
    "    df[line_col].isin(main23_lines)\n",
    "    & df[case_col].isin(takagi_cases)\n",
    ")\n",
    "\n",
    "df.loc[mask_main23_takagi, \"d_phys_real_pct\"] = df.loc[\n",
    "    mask_main23_takagi, \"d_takagi_remote_flipped_pct\"\n",
    "]\n",
    "df.loc[mask_main23_takagi, \"d_phys_real_strategy\"] = \"takagi_remote_flipped_main23_3ph_ll_llg\"\n",
    "\n",
    "# SLG-B and SLG-C: both-side mean is better across lines\n",
    "mask_slg_bc = df[case_col].isin([\"slg_b\", \"slg_c\"])\n",
    "\n",
    "df.loc[mask_slg_bc, \"d_phys_real_pct\"] = df.loc[\n",
    "    mask_slg_bc, \"d_takagi_both_mean_pct\"\n",
    "]\n",
    "df.loc[mask_slg_bc, \"d_phys_real_strategy\"] = \"takagi_both_mean_slg_b_c\"\n",
    "\n",
    "# SLG-A remains old prior by default\n",
    "mask_slg_a = df[case_col].eq(\"slg_a\")\n",
    "df.loc[mask_slg_a, \"d_phys_real_strategy\"] = \"old_prior_slg_a\"\n",
    "\n",
    "# Diagnostics\n",
    "df[\"line_caseaware_abs_err\"] = (\n",
    "    df[\"y_fault_location\"] - df[\"d_phys_real_pct\"]\n",
    ").abs()\n",
    "\n",
    "print(\"Previous selected prior MAE:\")\n",
    "print((df[\"y_fault_location\"] - df[\"d_phys_real_pct_before_line_caseaware\"]).abs().mean())\n",
    "\n",
    "print(\"New line-case-aware prior MAE:\")\n",
    "print(df[\"line_caseaware_abs_err\"].mean())\n",
    "\n",
    "print(\"\\nLine-wise new selected prior MAE:\")\n",
    "print(\n",
    "    df.groupby(line_col)\n",
    "      .apply(lambda g: (g[\"y_fault_location\"] - g[\"d_phys_real_pct\"]).abs().mean())\n",
    "      .rename(\"mae\")\n",
    "      .reset_index()\n",
    "      .to_string(index=False)\n",
    ")\n",
    "\n",
    "print(\"\\nLine + case strategy table:\")\n",
    "print(\n",
    "    df.groupby([line_col, case_col])\n",
    "      .agg(\n",
    "          n=(case_col, \"size\"),\n",
    "          strategy=(\"d_phys_real_strategy\", \"first\"),\n",
    "          mae=(\"line_caseaware_abs_err\", \"mean\"),\n",
    "      )\n",
    "      .reset_index()\n",
    "      .sort_values([line_col, \"mae\"], ascending=[True, False])\n",
    "      .to_string(index=False)\n",
    ")\n",
    "\n",
    "df.to_csv(out_csv, index=False)\n",
    "print(\"\\nSaved:\", out_csv)"
   ]
