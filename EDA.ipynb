  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_table(path: str, delimeter: str) -> pd.DataFrame:\n",
    "    if path.endswith(\".csv\"):\n",
    "        return pd.read_csv(path, delimiter = delimeter)\n",
    "    elif path.endswith(\".parquet\"):\n",
    "        return pd.read_parquet(path)\n",
    "    else:\n",
    "        raise ValueError(f\"Unsupported file type: {path}\")\n",
    "\n",
    "\n",
    "def find_first_existing_column(df: pd.DataFrame, candidates: list[str]) -> Optional[str]:\n",
    "    for col in candidates:\n",
    "        if col in df.columns:\n",
    "            return col\n",
    "    return None\n",
    "\n",
    "\n",
    "def normalize_phase_text(x) -> str:\n",
    "    if pd.isna(x):\n",
    "        return \"\"\n",
    "    s = str(x).strip().lower()\n",
    "    s = s.replace(\"-\", \"\").replace(\"_\", \"\").replace(\" \", \"\")\n",
    "    s = s.replace(\"phase\", \"\").replace(\"phases\", \"\")\n",
    "    mapping = {\n",
    "        \"l1\": \"a\",\n",
    "        \"l2\": \"b\",\n",
    "        \"l3\": \"c\",\n",
    "        \"ac\": \"ca\",\n",
    "    }\n",
    "    return mapping.get(s, s)\n",
    "\n",
    "\n",
    "def infer_fault_case(row: pd.Series, sc_type_col: str, phase_col: Optional[str]) -> str:\n",
    "    sc_type_raw = str(row[sc_type_col]).strip().lower()\n",
    "    phase_raw = normalize_phase_text(row[phase_col]) if phase_col else \"\"\n",
    "\n",
    "    if sc_type_raw in {\"3ph\", \"3-phase\", \"3_phase\", \"three_phase\", \"abc\"}:\n",
    "        return \"3ph\"\n",
    "\n",
    "    if sc_type_raw in {\"1phg\", \"slg\", \"lg\", \"single_line_to_ground\", \"single_phase_ground\"}:\n",
    "        if phase_raw in {\"a\", \"b\", \"c\"}:\n",
    "            return f\"slg_{phase_raw}\"\n",
    "        return \"slg_unknown\"\n",
    "\n",
    "    if sc_type_raw in {\"2ph\", \"ll\", \"line_to_line\", \"line-line\"}:\n",
    "        if phase_raw in {\"ab\", \"bc\", \"ca\"}:\n",
    "            return f\"ll_{phase_raw}\"\n",
    "        return \"ll_unknown\"\n",
    "\n",
    "    if sc_type_raw in {\"2phg\", \"llg\", \"double_line_to_ground\", \"line_line_ground\"}:\n",
    "        if phase_raw in {\"ab\", \"bc\", \"ca\"}:\n",
    "            return f\"llg_{phase_raw}\"\n",
    "        return \"llg_unknown\"\n",
    "\n",
    "    return sc_type_raw\n",
    "\n",
    "\n",
    "def detect_fault_location_column(df: pd.DataFrame) -> str:\n",
    "    candidates = [\n",
    "        \"sc_location\",\n",
    "        \"fault_location\",\n",
    "        \"fault_target\",\n",
    "        \"fault_distance\",\n",
    "        \"distance_to_fault\",\n",
    "        \"target\",\n",
    "        \"y\",\n",
    "    ]\n",
    "    col = find_first_existing_column(df, candidates)\n",
    "    if col is None:\n",
    "        raise ValueError(f\"Could not find a fault-location column. Available columns: {list(df.columns)}\")\n",
    "    return col\n",
    "\n",
    "\n",
    "def maybe_convert_fault_location_to_percent(series: pd.Series) -> pd.Series:\n",
    "    s = pd.to_numeric(series, errors=\"coerce\")\n",
    "    valid = s.dropna()\n",
    "\n",
    "    if len(valid) == 0:\n",
    "        return s\n",
    "\n",
    "    if valid.min() >= 0 and valid.max() <= 1.5:\n",
    "        return s * 100.0\n",
    "\n",
    "    return s"
   ]
