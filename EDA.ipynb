    "        prior_bias=(\"prior_err_pp\", \"mean\"),\n",
    "        pred_bias=(\"pred_err_pp\", \"mean\"),\n",
    "        mean_prior=(\"prior_pct\", \"mean\"),\n",
    "        mean_pred=(\"pred_pct\", \"mean\"),\n",
    "    )\n",
    "    .sort_values([\"case\", \"true_pct\"])\n",
    ")\n",
