    "\n",
    "out_csv = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_line_caseaware_mod_takagi_tf_only_prior_filled_event_features.csv\"\n",
    "\n",
    "op = pd.read_csv(operator_csv)\n",
    "settings = pd.read_csv(settings_csv)\n",
    "\n",
    "# Keep only useful event metadata\n",
    "event_cols = [\n",
    "    \"general/sim_idx\",\n",
    "    \"events/event_flt_shc_resistance\",\n",
    "    \"events/event_flt_hif_resistance\",\n",
    "    \"events/event_iflt_duration\",\n",
    "    \"events/event_iflt_arc_on\",\n",
    "    \"arc/arc_tau\",\n",
    "    \"arc/arc_u0\",\n",
    "    \"arc/arc_r0\",\n",
    "]\n",
    "\n",
    "event_cols = [c for c in event_cols if c in settings.columns]\n",
    "settings_small = settings[event_cols].copy()\n",
    "\n",
    "# Rename to model-safe names\n",
    "rename_map = {\n",
    "    \"general/sim_idx\": \"sample_id\",\n",
    "    \"events/event_flt_shc_resistance\": \"event_flt_shc_resistance\",\n",
    "    \"events/event_flt_hif_resistance\": \"event_flt_hif_resistance\",\n",
    "    \"events/event_iflt_duration\": \"event_iflt_duration\",\n",
    "    \"events/event_iflt_arc_on\": \"event_iflt_arc_on\",\n",
    "    \"arc/arc_tau\": \"arc_tau\",\n",
    "    \"arc/arc_u0\": \"arc_u0\",\n",
    "    \"arc/arc_r0\": \"arc_r0\",\n",
    "}\n",
    "\n",
    "settings_small = settings_small.rename(columns=rename_map)\n",
    "\n",
    "# Merge\n",
    "df = op.merge(settings_small, on=\"sample_id\", how=\"left\", validate=\"many_to_one\")\n",
    "\n",
    "print(\"Operator shape:\", op.shape)\n",
    "print(\"Settings small shape:\", settings_small.shape)\n",
    "print(\"Merged shape:\", df.shape)\n",
    "\n",
    "# Check missingness\n",
    "check_cols = [c for c in rename_map.values() if c != \"sample_id\" and c in df.columns]\n",
    "print(\"\\nMissing rates:\")\n",
    "print(df[check_cols].isna().mean().sort_values(ascending=False))\n",
    "\n",
    "# Create safe model features\n",
    "df[\"event_flt_shc_resistance_filled\"] = df[\"event_flt_shc_resistance\"].fillna(-1.0)\n",
    "\n",
    "if \"event_flt_hif_resistance\" in df.columns:\n",
    "    df[\"is_hif_resistance_available\"] = df[\"event_flt_hif_resistance\"].notna().astype(int)\n",
    "    df[\"event_flt_hif_resistance_filled\"] = df[\"event_flt_hif_resistance\"].fillna(-1.0)\n",
    "else:\n",
    "    df[\"is_hif_resistance_available\"] = 0\n",
    "    df[\"event_flt_hif_resistance_filled\"] = -1.0\n",
    "\n",
    "if \"event_iflt_duration\" in df.columns:\n",
    "    df[\"is_iflt_duration_available\"] = df[\"event_iflt_duration\"].notna().astype(int)\n",
    "    df[\"event_iflt_duration_filled\"] = df[\"event_iflt_duration\"].fillna(-1.0)\n",
    "\n",
    "# Save\n",
    "df.to_csv(out_csv, index=False)\n",
    "print(\"\\nSaved:\", out_csv)\n",
    "\n",
    "# Sanity check: no NaNs in planned feature columns\n",
    "planned_event_features = [\n",
    "    \"event_flt_shc_resistance_filled\",\n",
    "    \"event_flt_hif_resistance_filled\",\n",
    "    \"is_hif_resistance_available\",\n",
    "]\n",
    "\n",
    "print(\"\\nNaNs in planned event features:\")\n",
    "print(df[planned_event_features].isna().sum())"
   ]
