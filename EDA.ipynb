   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "old_path = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_both_all_fault_start_i0res_seq_bothfix.csv\"\n",
    "takagi_path = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_takagi_local_prior.csv\"\n",
    "\n",
    "old = pd.read_csv(old_path)\n",
    "tak = pd.read_csv(takagi_path)\n",
    "\n",
    "old = old[old[\"y_fault_line\"].astype(str) == \"MainLn1-2A\"].copy()\n",
    "tak = tak[tak[\"y_fault_line\"].astype(str) == \"MainLn1-2A\"].copy()\n",
    "\n",
    "# Merge old and Takagi priors\n",
    "m = old[[\n",
    "    \"sample_id\", \"window_idx\", \"case\", \"y_fault_location\", \"d_phys_real_pct\"\n",
    "]].merge(\n",
    "    tak[[\"sample_id\", \"window_idx\", \"d_phys_real_pct\", \"d_phys_real_pct_original\", \"d_takagi_local_pct\"]],\n",
    "    on=[\"sample_id\", \"window_idx\"],\n",
    "    suffixes=(\"_old\", \"_takagi\"),\n",
    ")\n",
    "\n",
    "m[\"old_err\"] = m[\"d_phys_real_pct_old\"] - m[\"y_fault_location\"]\n",
    "m[\"takagi_err\"] = m[\"d_phys_real_pct_takagi\"] - m[\"y_fault_location\"]\n",
    "\n",
    "m[\"old_abs_err\"] = m[\"old_err\"].abs()\n",
    "m[\"takagi_abs_err\"] = m[\"takagi_err\"].abs()\n",
    "m[\"takagi_gain\"] = m[\"old_abs_err\"] - m[\"takagi_abs_err\"]\n",
    "\n",
    "summary = (\n",
    "    m.groupby(\"case\", as_index=False)\n",
    "    .agg(\n",
    "        n=(\"sample_id\", \"count\"),\n",
    "        old_mae_pp=(\"old_abs_err\", \"mean\"),\n",
    "        takagi_mae_pp=(\"takagi_abs_err\", \"mean\"),\n",
    "        gain_pp=(\"takagi_gain\", \"mean\"),\n",
    "        old_bias_pp=(\"old_err\", \"mean\"),\n",
    "        takagi_bias_pp=(\"takagi_err\", \"mean\"),\n",
    "    )\n",
    "    .sort_values(\"gain_pp\", ascending=False)\n",
    ")\n",
    "\n",
    "display(summary)\n",
    "\n",
    "print(\"Overall:\")\n",
    "print(\"Old prior MAE:\", m[\"old_abs_err\"].mean())\n",
    "print(\"Takagi prior MAE:\", m[\"takagi_abs_err\"].mean())"
   ]
  },
