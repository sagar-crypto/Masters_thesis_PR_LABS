    "        mean_bias_pp=(\"bias_pp\", \"mean\"),\n",
    "    )\n",
    "    .sort_values(\"mean_mae_pp\", ascending=False)\n",
    ")\n",
    "\n",
    "print(\"Average performance per case across folds:\")\n",
    "display(avg_per_case)"
