   "source": [
    "IDENTITY_KEYWORDS = [\n",
    "    \"experiment\",\n",
    "    \"run\",\n",
    "    \"model\",\n",
    "    \"mode\",\n",
    "    \"family\",\n",
    "    \"topology\",\n",
    "    \"voltage\",\n",
    "    \"dataset\",\n",
    "    \"cohort\",\n",
    "    \"view\",\n",
    "    \"ended\",\n",
    "    \"terminal\",\n",
    "    \"level\",\n",
    "    \"source\",\n",
    "    \"name\",\n",
    "]\n",
    "\n",
    "\n",
    "def normalize_name(value: Any) -> str:\n",
    "    return re.sub(\n",
    "        r\"[^a-z0-9]+\",\n",
    "        \"_\",\n",
    "        str(value).strip().lower(),\n",
    "    ).strip(\"_\")\n",
    "\n",
    "\n",
    "def inspect_identity_columns(\n",
    "    path: Path,\n",
    "    max_unique: int = 50,\n",
    ") -> pd.DataFrame:\n",
    "    parquet_file = pq.ParquetFile(path)\n",
    "    schema = parquet_file.schema_arrow\n",
    "\n",
    "    candidate_columns = []\n",
    "\n",
    "    for field in schema:\n",
    "        normalized = normalize_name(field.name)\n",
    "\n",
    "        relevant_name = any(\n",
    "            keyword in normalized\n",
    "            for keyword in IDENTITY_KEYWORDS\n",
    "        )\n",
    "\n",
    "        scalar_type = (\n",
    "            pa.types.is_string(field.type)\n",
    "            or pa.types.is_large_string(field.type)\n",
    "            or pa.types.is_dictionary(field.type)\n",
    "            or pa.types.is_integer(field.type)\n",
    "            or pa.types.is_boolean(field.type)\n",
    "        )\n",
    "\n",
    "        if relevant_name and scalar_type:\n",
    "            candidate_columns.append(field.name)\n",
    "\n",
    "    if not candidate_columns:\n",
    "        return pd.DataFrame(\n",
    "            columns=[\n",
    "                \"path\",\n",
    "                \"column\",\n",
    "                \"dtype\",\n",
    "                \"unique_count\",\n",
    "                \"unique_values\",\n",
    "            ]\n",
    "        )\n",
    "\n",
    "    frame = pd.read_parquet(\n",
    "        path,\n",
    "        columns=candidate_columns,\n",
    "    )\n",
    "\n",
    "    rows = []\n",
    "\n",
    "    for column in candidate_columns:\n",
    "        unique_values = pd.unique(\n",
    "            frame[column].dropna()\n",
    "        )\n",
    "\n",
    "        rows.append(\n",
    "            {\n",
    "                \"path\": str(path),\n",
    "                \"column\": column,\n",
    "                \"dtype\": str(frame[column].dtype),\n",
    "                \"unique_count\": len(unique_values),\n",
    "                \"unique_values\": json.dumps(\n",
    "                    [\n",
    "                        value.item()\n",
    "                        if isinstance(value, np.generic)\n",
    "                        else value\n",
    "                        for value in unique_values[:max_unique]\n",
    "                    ],\n",
    "                    ensure_ascii=False,\n",
    "                    default=str,\n",
    "                ),\n",
    "            }\n",
    "        )\n",
    "\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "identity_tables = []\n",
    "\n",
    "for label, path in expected_oof_files.items():\n",
    "    if not path.exists():\n",
    "        continue\n",
    "\n",
    "    inspected = inspect_identity_columns(path)\n",
    "\n",
    "    if not inspected.empty:\n",
    "        inspected.insert(0, \"artifact\", label)\n",
    "        identity_tables.append(inspected)\n",
    "\n",
    "\n",
    "if identity_tables:\n",
    "    identity_audit = pd.concat(\n",
    "        identity_tables,\n",
    "        ignore_index=True,\n",
    "    )\n",
    "else:\n",
    "    identity_audit = pd.DataFrame()\n",
    "\n",
