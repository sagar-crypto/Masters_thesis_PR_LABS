    "error_audit_rows = []\n",
    "\n",
    "\n",
    "for experiment_id, frame in experiment_frames.items():\n",
    "    calculated_model_error = (\n",
    "        pd.to_numeric(\n",
    "            frame[\"y_pred_pp\"],\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "        - pd.to_numeric(\n",
    "            frame[\"y_true_pp\"],\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "    ).abs()\n",
    "\n",
    "    calculated_prior_error = (\n",
    "        pd.to_numeric(\n",
    "            frame[\"prior_pp\"],\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "        - pd.to_numeric(\n",
    "            frame[\"y_true_pp\"],\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "    ).abs()\n",
    "\n",
    "    saved_model_error = pd.to_numeric(\n",
    "        frame[\"model_abs_error_pp\"],\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    "    saved_prior_error = pd.to_numeric(\n",
    "        frame[\"prior_abs_error_pp\"],\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    "    model_difference = (\n",
    "        calculated_model_error\n",
    "        - saved_model_error\n",
    "    ).abs()\n",
    "\n",
    "    prior_difference = (\n",
    "        calculated_prior_error\n",
    "        - saved_prior_error\n",
    "    ).abs()\n",
    "\n",
    "    model_error_ok = bool(\n",
    "        (\n",
    "            model_difference.fillna(np.inf)\n",
    "            <= ERROR_TOLERANCE\n",
    "        ).all()\n",
    "    )\n",
    "\n",
    "    prior_error_ok = bool(\n",
    "        (\n",
    "            prior_difference.fillna(np.inf)\n",
    "            <= ERROR_TOLERANCE\n",
    "        ).all()\n",
    "    )\n",
    "\n",
    "    error_audit_rows.append(\n",
    "        {\n",
    "            \"experiment_id\": experiment_id,\n",
    "            \"rows\": len(frame),\n",
    "            \"model_error_max_difference\": float(\n",
    "                model_difference.max()\n",
    "            ),\n",
    "            \"prior_error_max_difference\": float(\n",
    "                prior_difference.max()\n",
    "            ),\n",
    "            \"model_error_column_ok\": model_error_ok,\n",
    "            \"prior_error_column_ok\": prior_error_ok,\n",
    "        }\n",
    "    )\n",
    "\n",
    "    if not model_error_ok:\n",
    "        mapping_failures.append(\n",
    "            f\"{experiment_id}: saved model error is inconsistent\"\n",
    "        )\n",
    "\n",
    "    if not prior_error_ok:\n",
    "        mapping_failures.append(\n",
    "            f\"{experiment_id}: saved prior error is inconsistent\"\n",
    "        )\n",
    "\n",
    "\n",
    "error_column_audit = pd.DataFrame(\n",
    "    error_audit_rows\n",
    ")\n",
    "\n",
    "error_column_audit.to_csv(\n",
    "    ERROR_COLUMN_AUDIT_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "display(error_column_audit)\n",
    "\n",
    "print(\"Saved:\", ERROR_COLUMN_AUDIT_PATH)"
