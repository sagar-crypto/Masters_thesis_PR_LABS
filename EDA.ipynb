   "source": [
    "# Worst case inside each fold\n",
    "worst_per_fold = (\n",
    "    all_cases.sort_values([\"fold\", \"mae_pp\"], ascending=[True, False])\n",
    "    .groupby(\"fold\", as_index=False)\n",
    "    .first()\n",
    "    [[\"fold\", \"case\", \"support\", \"mae_pp\", \"rmse_pp\", \"bias_pp\", \"median_ae_pp\"]]\n",
    ")\n",
    "\n",
    "print(\"Worst case per fold:\")\n",
    "display(worst_per_fold)\n",
    "\n",
    "# Average performance per case across folds\n",
    "avg_per_case = (\n",
    "    all_cases.groupby(\"case\", as_index=False)\n",
    "    .agg(\n",
    "        n_folds=(\"fold\", \"count\"),\n",
    "        mean_mae_pp=(\"mae_pp\", \"mean\"),\n",
