   "source": [
    "detection_rows: list[dict[str, Any]] = []\n",
    "\n",
    "\n",
    "for path_string in sorted(\n",
    "    set(double_prediction_files[\"path\"].astype(str))\n",
    "):\n",
    "    path = Path(path_string)\n",
    "\n",
    "    try:\n",
    "        columns = table_columns(path)\n",
    "        row_count = table_row_count(path)\n",
    "\n",
    "        if path.suffix.lower() == \".parquet\":\n",
    "            metadata_columns = (\n",
    "                parquet_candidate_metadata_columns(path)\n",
    "            )\n",
    "        else:\n",
    "            metadata_columns = (\n",
    "                csv_candidate_metadata_columns(path)\n",
    "            )\n",
    "\n",
    "        metadata_frame = read_selected_columns(\n",
    "            path,\n",
    "            metadata_columns,\n",
    "        )\n",
    "\n",
    "        detected_in_path = experiment_ids_in_path(path)\n",
    "\n",
    "        found_value_evidence = False\n",
    "\n",
    "        for column in metadata_columns:\n",
    "            values = safe_unique_values(\n",
    "                metadata_frame[column],\n",
    "                maximum=100,\n",
    "            )\n",
    "\n",
    "            experiment_value_map: dict[str, list[Any]] = (\n",
    "                defaultdict(list)\n",
    "            )\n",
    "\n",
    "            for value in values:\n",
    "                detected_experiments = (\n",
    "                    experiment_ids_in_value(value)\n",
    "                )\n",
    "\n",
    "                for experiment_id in detected_experiments:\n",
    "                    experiment_value_map[\n",
    "                        experiment_id\n",
    "                    ].append(value)\n",
    "\n",
    "            if not experiment_value_map:\n",
    "                continue\n",
    "\n",
    "            found_value_evidence = True\n",
    "\n",
    "            for experiment_id, matching_values in (\n",
    "                experiment_value_map.items()\n",
    "            ):\n",
    "                detection_rows.append(\n",
    "                    {\n",
    "                        \"path\": str(path),\n",
    "                        \"format\": path.suffix.lower(),\n",
    "                        \"row_count\": row_count,\n",
    "                        \"evidence_type\": \"column_value\",\n",
    "                        \"evidence_column\": column,\n",
    "                        \"experiment_id\": experiment_id,\n",
    "                        \"matching_values\": json.dumps(\n",
    "                            matching_values,\n",
    "                            ensure_ascii=False,\n",
    "                            default=str,\n",
    "                        ),\n",
    "                        \"metadata_columns_inspected\": \"|\".join(\n",
    "                            metadata_columns\n",
    "                        ),\n",
    "                    }\n",
    "                )\n",
    "\n",
    "        for experiment_id in detected_in_path:\n",
    "            detection_rows.append(\n",
    "                {\n",
    "                    \"path\": str(path),\n",
    "                    \"format\": path.suffix.lower(),\n",
    "                    \"row_count\": row_count,\n",
    "                    \"evidence_type\": \"file_path\",\n",
    "                    \"evidence_column\": \"\",\n",
    "                    \"experiment_id\": experiment_id,\n",
    "                    \"matching_values\": json.dumps(\n",
    "                        [str(path)],\n",
    "                        ensure_ascii=False,\n",
    "                    ),\n",
    "                    \"metadata_columns_inspected\": \"|\".join(\n",
    "                        metadata_columns\n",
    "                    ),\n",
    "                }\n",
    "            )\n",
    "\n",
    "        if (\n",
    "            not detected_in_path\n",
    "            and not found_value_evidence\n",
    "        ):\n",
    "            detection_rows.append(\n",
    "                {\n",
    "                    \"path\": str(path),\n",
    "                    \"format\": path.suffix.lower(),\n",
    "                    \"row_count\": row_count,\n",
    "                    \"evidence_type\": \"no_experiment_evidence\",\n",
    "                    \"evidence_column\": \"\",\n",
    "                    \"experiment_id\": \"\",\n",
    "                    \"matching_values\": \"\",\n",
    "                    \"metadata_columns_inspected\": \"|\".join(\n",
    "                        metadata_columns\n",
    "                    ),\n",
    "                }\n",
    "            )\n",
    "\n",
    "    except Exception as exc:\n",
    "        detection_rows.append(\n",
    "            {\n",
    "                \"path\": str(path),\n",
    "                \"format\": path.suffix.lower(),\n",
    "                \"row_count\": None,\n",
    "                \"evidence_type\": \"inspection_error\",\n",
    "                \"evidence_column\": \"\",\n",
    "                \"experiment_id\": \"\",\n",
    "                \"matching_values\": \"\",\n",
    "                \"metadata_columns_inspected\": \"\",\n",
    "                \"error\": repr(exc),\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "double_detection = pd.DataFrame(detection_rows)\n",
    "\n",
    "double_detection.to_csv(\n",
    "    DOUBLE_DETECTION_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "print(\"Saved:\", DOUBLE_DETECTION_PATH)\n",
    "\n",
    "display(\n",
    "    double_detection.sort_values(\n",
    "        [\n",
    "            \"experiment_id\",\n",
    "            \"path\",\n",
    "            \"evidence_type\",\n",
    "        ],\n",
    "        kind=\"stable\",\n",
    "    )\n",
    ")"
   ]
  },
