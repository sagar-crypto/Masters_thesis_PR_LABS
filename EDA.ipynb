    "TARGET_KEYS = {\"snss\", \"rntxn\", \"x0tx1\", \"r0tx0\"}\n",
    "\n",
    "def search_target_keys(obj, path=\"\"):\n",
    "    hits = []\n",
    "    if isinstance(obj, dict):\n",
    "        for k, v in obj.items():\n",
    "            new_path = f\"{path}/{k}\"\n",
    "            if str(k).lower() in TARGET_KEYS:\n",
    "                hits.append((new_path, v))\n",
    "            hits.extend(search_target_keys(v, new_path))\n",
    "    elif isinstance(obj, (list, tuple)):\n",
    "        for i, v in enumerate(obj):\n",
    "            hits.extend(search_target_keys(v, f\"{path}[{i}]\"))\n",
    "    return hits\n",
    "\n",
    "hits = []\n",
    "\n",
    "for node, attr in G.nodes(data=True):\n",
    "    hits.extend(search_target_keys(attr, path=f\"node:{node}\"))\n",
    "\n",
    "for u, v, key, attr in G.edges(keys=True, data=True):\n",
    "    hits.extend(search_target_keys(attr, path=f\"edge:{key}:{u}-{v}\"))\n",
    "\n",
    "print(\"Number of external-grid source parameter hits:\", len(hits))\n",
    "for path, value in hits[:100]:\n",
    "    print(path, \"=\", value)"
   ]
  },
