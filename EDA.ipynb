   "source": [
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "csv_path = Path(\n",
    "    \"/home/vault/iwi5/iwi5305h/\"\n",
    "    \"kol_operator_features_hv_double_line_110kv_both_all_fault_start_mod_takagi_seeded_standard_takagi.csv\"\n",
    ")\n",
    "\n",
    "df = pd.read_csv(csv_path, low_memory=False)\n",
    "\n",
    "print(\"File:\", csv_path.name)\n",
    "print(\"Rows:\", len(df))\n",
    "print(\"Unique samples:\", df[\"sample_id\"].nunique())\n",
    "\n",
    "print(\"\\nRows per sample:\")\n",
    "display(\n",
    "    df.groupby(\"sample_id\")\n",
    "      .size()\n",
    "      .value_counts()\n",
    "      .sort_index()\n",
    "      .rename(\"n_samples\")\n",
    "      .to_frame()\n",
    ")\n",
    "\n",
    "print(\"\\nModified-Takagi-related columns:\")\n",
    "mod_cols = [c for c in df.columns if \"mod_takagi\" in c.lower()]\n",
    "print(\"\\n\".join(mod_cols))\n",
    "\n",
    "required_cols = [\n",
    "    \"y_fault_line\",\n",
    "    \"status\",\n",
    "    \"sample_id\",\n",
    "    \"case\",\n",
    "    \"y_fault_location\",\n",
    "    \"mod_takagi_m_seed_local_pct\",\n",
    "    \"mod_takagi_m_seed_remote_pct\",\n",
    "    \"mod_takagi_m_seed_source_local\",\n",
    "    \"mod_takagi_m_seed_source_remote\",\n",
    "]\n",
    "\n",
    "missing = [c for c in required_cols if c not in df.columns]\n",
    "if missing:\n",
    "    raise ValueError(f\"Missing expected columns: {missing}\")\n",
    "\n",
    "# Keep only the same representative fault-start row per sample.\n",
    "# This lets us inspect one physical estimate per fault event.\n",
    "fault_start = df.loc[df[\"status\"].eq(\"fault_start\")].copy()\n",
    "\n",
    "if \"window_idx\" in fault_start.columns:\n",
    "    fault_start = (\n",
    "        fault_start.sort_values([\"sample_id\", \"window_idx\"])\n",
    "        .drop_duplicates(subset=[\"sample_id\"], keep=\"first\")\n",
    "    )\n",
    "else:\n",
    "    fault_start = fault_start.drop_duplicates(subset=[\"sample_id\"], keep=\"first\")\n",
    "\n",
    "slg = fault_start.loc[\n",
    "    fault_start[\"case\"].isin([\"slg_a\", \"slg_b\", \"slg_c\"])\n",
    "].copy()\n",
    "\n",
    "print(\"\\nRepresentative fault events:\", len(fault_start))\n",
    "print(\"Representative SLG events:\", len(slg))\n",
    "\n",
    "print(\"\\nSeed-source usage for SLG:\")\n",
    "display(\n",
    "    slg[\n",
    "        [\n",
    "            \"mod_takagi_m_seed_source_local\",\n",
    "            \"mod_takagi_m_seed_source_remote\",\n",
    "        ]\n",
    "    ]\n",
    "    .value_counts(dropna=False)\n",
    "    .rename(\"n\")\n",
    "    .to_frame()\n",
    ")\n",
    "\n",
    "# Leakage audit:\n",
    "# In the old oracle version, these two errors would effectively be zero:\n",
    "# local_seed == y, remote_seed == 100 - y.\n",
    "slg[\"local_seed_error_vs_truth_pp\"] = (\n",
    "    slg[\"mod_takagi_m_seed_local_pct\"]\n",
    "    - slg[\"y_fault_location\"]\n",
    ").abs()\n",
    "\n",
    "slg[\"remote_seed_error_vs_reverse_truth_pp\"] = (\n",
    "    slg[\"mod_takagi_m_seed_remote_pct\"]\n",
    "    - (100.0 - slg[\"y_fault_location\"])\n",
    ").abs()\n",
    "\n",
    "print(\"\\nLeakage audit — seed disagreement with true distance:\")\n",
    "display(\n",
    "    slg[\n",
    "        [\n",
    "            \"local_seed_error_vs_truth_pp\",\n",
    "            \"remote_seed_error_vs_reverse_truth_pp\",\n",
    "        ]\n",
    "    ]\n",
    "    .describe(percentiles=[0.05, 0.25, 0.50, 0.75, 0.95])\n",
    "    .T\n",
    ")\n",
    "\n",
    "print(\"\\nExact matches to truth (should be rare, not ~100%):\")\n",
    "print(\n",
    "    \"Local seed equals true local distance: \",\n",
    "    f\"{(slg['local_seed_error_vs_truth_pp'] < 1e-8).mean() * 100:.2f}%\"\n",
    ")\n",
    "print(\n",
    "    \"Remote seed equals true remote distance: \",\n",
    "    f\"{(slg['remote_seed_error_vs_reverse_truth_pp'] < 1e-8).mean() * 100:.2f}%\"\n",
    ")\n",
    "\n",
    "display(\n",
    "    slg[\n",
    "        [\n",
    "            \"sample_id\",\n",
    "            \"case\",\n",
    "            \"y_fault_location\",\n",
    "            \"mod_takagi_m_seed_local_pct\",\n",
    "            \"mod_takagi_m_seed_remote_pct\",\n",
    "            \"mod_takagi_m_seed_source_local\",\n",
    "            \"mod_takagi_m_seed_source_remote\",\n",
    "            \"local_seed_error_vs_truth_pp\",\n",
    "            \"remote_seed_error_vs_reverse_truth_pp\",\n",
    "        ]\n",
    "    ]\n",
    "    .sort_values([\"case\", \"sample_id\"])\n",
    "    .head(20)\n",
    ")"
   ]
  },
