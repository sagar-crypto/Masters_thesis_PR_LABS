    "integrity_audit = pd.DataFrame(\n",
    "    audit_rows\n",
    ")\n",
    "\n",
    "\n",
    "mandatory_failures = integrity_audit.loc[\n",
    "    integrity_audit[\"mandatory\"]\n",
    "    & ~integrity_audit[\"passed\"]\n",
    "].copy()\n",
    "\n",
    "\n",
    "optional_warnings = integrity_audit.loc[\n",
    "    ~integrity_audit[\"mandatory\"]\n",
    "    & ~integrity_audit[\"passed\"]\n",
    "].copy()\n",
    "\n",
    "\n",
    "experiment_summaries = []\n",
    "\n",
    "\n",
    "for experiment_id in EXPERIMENTS:\n",
    "    experiment_checks = integrity_audit.loc[\n",
    "        integrity_audit[\n",
    "            \"experiment_id\"\n",
    "        ] == experiment_id\n",
    "    ]\n",
    "\n",
    "    mandatory_checks = experiment_checks.loc[\n",
    "        experiment_checks[\"mandatory\"]\n",
    "    ]\n",
    "\n",
    "    experiment_summaries.append(\n",
    "        {\n",
    "            \"experiment_id\": experiment_id,\n",
    "            \"mandatory_check_count\": int(\n",
    "                len(mandatory_checks)\n",
    "            ),\n",
    "            \"mandatory_pass_count\": int(\n",
    "                mandatory_checks[\n",
    "                    \"passed\"\n",
    "                ].sum()\n",
    "            ),\n",
    "            \"mandatory_failure_count\": int(\n",
    "                (~mandatory_checks[\"passed\"]).sum()\n",
    "            ),\n",
    "            \"optional_warning_count\": int(\n",
    "                (\n",
    "                    ~experiment_checks[\"mandatory\"]\n",
    "                    & ~experiment_checks[\"passed\"]\n",
    "                ).sum()\n",
    "            ),\n",
    "            \"integrity_status\": (\n",
    "                \"PASS\"\n",
    "                if mandatory_checks[\"passed\"].all()\n",
    "                else \"FAIL\"\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "experiment_integrity_summary = pd.DataFrame(\n",
    "    experiment_summaries\n",
    ")\n",
    "\n",
    "\n",
    "integrity_audit.to_csv(\n",
    "    INTEGRITY_CSV_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "\n",
    "integrity_payload = {\n",
    "    \"audit_version\": (\n",
    "        \"chapter4_posthoc_integrity_v1\"\n",
    "    ),\n",
    "    \"generated_utc\": datetime.now(\n",
    "        timezone.utc\n",
    "    ).isoformat(),\n",
    "    \"overall_status\": (\n",
    "        \"PASS\"\n",
    "        if mandatory_failures.empty\n",
    "        else \"FAIL\"\n",
    "    ),\n",
    "    \"mandatory_failure_count\": int(\n",
    "        len(mandatory_failures)\n",
    "    ),\n",
    "    \"optional_warning_count\": int(\n",
    "        len(optional_warnings)\n",
    "    ),\n",
    "    \"experiments\": (\n",
    "        experiment_integrity_summary\n",
    "        .to_dict(orient=\"records\")\n",
    "    ),\n",
    "    \"mandatory_failures\": (\n",
    "        mandatory_failures\n",
    "        .to_dict(orient=\"records\")\n",
    "    ),\n",
    "    \"optional_warnings\": (\n",
    "        optional_warnings\n",
    "        .to_dict(orient=\"records\")\n",
    "    ),\n",
    "    \"scientific_confirmations\": {\n",
    "        \"all_eight_experiments_present\": bool(\n",
    "            len(experiment_integrity_summary) == 8\n",
    "        ),\n",
    "        \"all_90kv_experiments_have_9022_events\": bool(\n",
    "            integrity_audit.loc[\n",
    "                integrity_audit[\n",
    "                    \"check_name\"\n",
    "                ] == \"unique_physical_event_count\",\n",
    "                \"passed\",\n",
    "            ].all()\n",
    "        ),\n",
    "        \"all_110kv_events_are_fold_independent\": bool(\n",
    "            integrity_audit.loc[\n",
    "                integrity_audit[\n",
    "                    \"check_name\"\n",
    "                ]\n",
    "                == \"one_outer_test_fold_per_event\",\n",
    "                \"passed\",\n",
    "            ].all()\n",
    "        ),\n",
    "        \"all_110kv_events_have_windows_8_9_10_11\": bool(\n",
    "            integrity_audit.loc[\n",
    "                integrity_audit[\n",
    "                    \"check_name\"\n",
    "                ]\n",
    "                == \"exact_110kv_window_indices_per_event\",\n",
    "                \"passed\",\n",
    "            ].all()\n",
    "        ),\n",
    "        \"saved_event_predictions_match_reconstruction\": bool(\n",
    "            integrity_audit.loc[\n",
    "                integrity_audit[\n",
    "                    \"category\"\n",
    "                ] == \"event_aggregation\",\n",
    "                \"passed\",\n",
    "            ].all()\n",
    "        ),\n",
    "    },\n",
    "    \"paths\": {\n",
    "        \"integrity_csv\": str(\n",
    "            INTEGRITY_CSV_PATH\n",
    "        ),\n",
    "        \"event_reconstruction_audit\": str(\n",
    "            EVENT_COMPARISON_PATH\n",
    "        ),\n",
    "        \"final_manifest\": str(\n",
    "            FINAL_MANIFEST_PATH\n",
    "        ),\n",
    "    },\n",
    "}\n",
    "\n",
    "\n",
    "with INTEGRITY_JSON_PATH.open(\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    json.dump(\n",
    "        integrity_payload,\n",
    "        file,\n",
    "        indent=2,\n",
    "        ensure_ascii=False,\n",
    "        default=str,\n",
    "    )\n",
    "\n",
    "\n",
    "print(\"Saved:\", INTEGRITY_CSV_PATH)\n",
    "print(\"Saved:\", INTEGRITY_JSON_PATH)\n",
    "\n",
    "print(\"\\nExperiment integrity summary:\")\n",
    "display(experiment_integrity_summary)\n",
    "\n",
    "print(\"\\nMandatory failures:\")\n",
    "display(mandatory_failures)\n",
    "\n",
    "print(\"\\nOptional warnings:\")\n",
    "display(optional_warnings)"
   ]
