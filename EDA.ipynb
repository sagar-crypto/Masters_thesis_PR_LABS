    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "old_run_dir = Path(\n",
    "    \"outputs/MainLn1-2A__kol_operator_features_hv_double_line_110kv_caseaware_family_takagi_prior__threeph_add_ground_mul__all_fault_start__run_2026-05-03T09:58:27.279672Z\"\n",
    ")\n",
    "\n",
    "new_run_dir = Path(\n",
    "    \"outputs/MainLn1-2A__kol_operator_features_hv_double_line_110kv_line_caseaware_mod_takagi_tf_only_prior_filled__threeph_add_ground_mul__all_fault_start__run_2026-06-06T11:38:40.374852Z\"\n",
    ")\n",
    "\n",
    "def load_case_metrics(run_dir: Path, tag: str) -> pd.DataFrame:\n",
    "    files = sorted(run_dir.glob(\"fold*_subgroups/metrics_by_case.csv\"))\n",
    "    \n",
    "    if not files:\n",
    "        raise FileNotFoundError(f\"No metrics_by_case.csv files found under {run_dir}\")\n",
    "    \n",
    "    dfs = []\n",
    "    for f in files:\n",
    "        tmp = pd.read_csv(f)\n",
    "        tmp[\"run\"] = tag\n",
    "        tmp[\"fold\"] = f.parent.name.replace(\"_subgroups\", \"\")\n",
    "        tmp[\"file\"] = str(f)\n",
    "        dfs.append(tmp)\n",
    "    \n",
    "    return pd.concat(dfs, ignore_index=True)\n",
    "\n",
    "old_case_raw = load_case_metrics(old_run_dir, \"old_best\")\n",
    "new_case_raw = load_case_metrics(new_run_dir, \"new_mod_takagi\")\n",
    "\n",
    "print(\"Old shape:\", old_case_raw.shape)\n",
    "print(\"New shape:\", new_case_raw.shape)\n",
    "\n",
    "print(\"\\nOld columns:\")\n",
    "print(old_case_raw.columns.tolist())\n",
    "\n",
    "print(\"\\nNew columns:\")\n",
    "print(new_case_raw.columns.tolist())\n",
    "\n",
    "display(old_case_raw.head())\n",
    "display(new_case_raw.head())"
   ]
  },
