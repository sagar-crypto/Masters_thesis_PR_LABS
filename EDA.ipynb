    "def normalize_name(value: Any) -> str:\n",
    "    return re.sub(\n",
    "        r\"[^a-z0-9]+\",\n",
    "        \"_\",\n",
    "        str(value).strip().lower(),\n",
    "    ).strip(\"_\")\n",
    "\n",
    "\n",
    "def compact_token(value: Any) -> str:\n",
    "    return re.sub(\n",
    "        r\"[^A-Z0-9]+\",\n",
    "        \"\",\n",
    "        str(value).upper(),\n",
    "    )\n",
    "\n",
    "\n",
    "EXPERIMENT_TOKENS = {\n",
    "    experiment_id: compact_token(experiment_id)\n",
    "    for experiment_id in EXPERIMENTS\n",
    "}\n",
    "\n",
    "\n",
    "def experiment_ids_in_value(value: Any) -> list[str]:\n",
    "    token = compact_token(value)\n",
    "\n",
    "    if not token:\n",
    "        return []\n",
    "\n",
    "    detected = []\n",
    "\n",
    "    for experiment_id, experiment_token in (\n",
    "        EXPERIMENT_TOKENS.items()\n",
    "    ):\n",
    "        if experiment_token in token:\n",
    "            detected.append(experiment_id)\n",
    "\n",
    "    return sorted(set(detected))\n",
    "\n",
    "\n",
    "def experiment_ids_in_path(path: Path) -> list[str]:\n",
    "    return experiment_ids_in_value(str(path))\n",
    "\n",
    "\n",
    "def safe_unique_values(\n",
    "    series: pd.Series,\n",
    "    maximum: int = 100,\n",
    ") -> list[Any]:\n",
    "    values = pd.unique(series.dropna())\n",
    "\n",
    "    output = []\n",
    "\n",
    "    for value in values[:maximum]:\n",
    "        if isinstance(value, np.generic):\n",
    "            value = value.item()\n",
    "\n",
    "        if isinstance(value, pd.Timestamp):\n",
    "            value = value.isoformat()\n",
    "\n",
    "        if isinstance(value, float) and not np.isfinite(value):\n",
    "            value = str(value)\n",
    "\n",
    "        output.append(value)\n",
    "\n",
    "    return output\n",
    "\n",
    "\n",
    "def table_columns(path: Path) -> list[str]:\n",
    "    if path.suffix.lower() == \".parquet\":\n",
    "        return [\n",
    "            str(name)\n",
    "            for name in pq.ParquetFile(path).schema_arrow.names\n",
    "        ]\n",
    "\n",
    "    if path.suffix.lower() == \".csv\":\n",
    "        return [\n",
    "            str(column)\n",
    "            for column in pd.read_csv(\n",
    "                path,\n",
    "                nrows=0,\n",
    "            ).columns\n",
    "        ]\n",
    "\n",
    "    return []\n",
    "\n",
    "\n",
    "def table_row_count(path: Path) -> int | None:\n",
    "    if path.suffix.lower() == \".parquet\":\n",
    "        return int(\n",
    "            pq.ParquetFile(path).metadata.num_rows\n",
    "        )\n",
    "\n",
    "    if path.suffix.lower() == \".csv\":\n",
    "        # The relevant model-input CSVs contain only thousands of rows.\n",
    "        with path.open(\n",
    "            \"rb\",\n",
    "        ) as file:\n",
    "            line_count = sum(1 for _ in file)\n",
    "\n",
    "        return max(0, line_count - 1)\n",
    "\n",
    "    return None\n",
    "\n",
    "\n",
    "def parquet_candidate_metadata_columns(\n",
    "    path: Path,\n",
    ") -> list[str]:\n",
    "    parquet_file = pq.ParquetFile(path)\n",
    "    schema = parquet_file.schema_arrow\n",
    "\n",
    "    selected = []\n",
    "\n",
    "    name_keywords = [\n",
    "        \"experiment\",\n",
    "        \"model\",\n",
    "        \"mode\",\n",
    "        \"family\",\n",
    "        \"topology\",\n",
    "        \"voltage\",\n",
    "        \"dataset\",\n",
    "        \"cohort\",\n",
    "        \"view\",\n",
    "        \"ended\",\n",
    "        \"prior\",\n",
    "        \"fold\",\n",
    "        \"window\",\n",
    "        \"case\",\n",
    "        \"fault\",\n",
    "        \"line\",\n",
    "        \"level\",\n",
    "    ]\n",
    "\n",
    "    for field in schema:\n",
    "        name = str(field.name)\n",
    "        normalized = normalize_name(name)\n",
    "\n",
    "        name_is_relevant = any(\n",
    "            keyword in normalized\n",
    "            for keyword in name_keywords\n",
    "        )\n",
    "\n",
    "        type_is_metadata_like = (\n",
    "            pa.types.is_string(field.type)\n",
    "            or pa.types.is_large_string(field.type)\n",
    "            or pa.types.is_dictionary(field.type)\n",
    "            or pa.types.is_boolean(field.type)\n",
    "            or pa.types.is_integer(field.type)\n",
    "        )\n",
    "\n",
    "        if name_is_relevant and type_is_metadata_like:\n",
    "            selected.append(name)\n",
    "\n",
    "    return sorted(set(selected))\n",
    "\n",
    "\n",
    "def csv_candidate_metadata_columns(\n",
    "    path: Path,\n",
    ") -> list[str]:\n",
    "    columns = table_columns(path)\n",
    "\n",
    "    keywords = [\n",
    "        \"experiment\",\n",
    "        \"model\",\n",
    "        \"mode\",\n",
    "        \"family\",\n",
    "        \"topology\",\n",
    "        \"voltage\",\n",
    "        \"dataset\",\n",
    "        \"cohort\",\n",
    "        \"view\",\n",
    "        \"ended\",\n",
    "        \"fold\",\n",
    "        \"window\",\n",
    "        \"case\",\n",
    "        \"fault\",\n",
    "        \"line\",\n",
    "        \"level\",\n",
    "    ]\n",
    "\n",
    "    return [\n",
    "        column\n",
    "        for column in columns\n",
    "        if any(\n",
    "            keyword in normalize_name(column)\n",
    "            for keyword in keywords\n",
    "        )\n",
    "    ]\n",
    "\n",
    "\n",
    "def read_selected_columns(\n",
    "    path: Path,\n",
    "    columns: list[str],\n",
    ") -> pd.DataFrame:\n",
    "    columns = sorted(set(columns))\n",
    "\n",
    "    if not columns:\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    if path.suffix.lower() == \".parquet\":\n",
    "        return pd.read_parquet(\n",
    "            path,\n",
    "            columns=columns,\n",
    "        )\n",
    "\n",
    "    if path.suffix.lower() == \".csv\":\n",
    "        return pd.read_csv(\n",
    "            path,\n",
    "            usecols=columns,\n",
    "            low_memory=False,\n",
    "        )\n",
    "\n",
    "    raise ValueError(f\"Unsupported table format: {path}\")"
   ]
  },
