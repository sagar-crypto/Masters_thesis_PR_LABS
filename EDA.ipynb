   "source": [
    "summary_by_window_case = (\n",
    "    df_line\n",
    "    .groupby([\"window_idx\", \"case\"], as_index=False)\n",
    "    .agg(\n",
    "        n=(\"sample_id\", \"count\"),\n",
    "        prior_mae_pp=(\"prior_abs_err_pp\", \"mean\"),\n",
    "        prior_rmse_pp=(\"prior_err_pp\", lambda x: float(np.sqrt(np.mean(np.square(x))))),\n",
    "        prior_bias_pp=(\"prior_err_pp\", \"mean\"),\n",
    "        median_abs_err_pp=(\"prior_abs_err_pp\", \"median\"),\n",
    "    )\n",
    "    .sort_values([\"window_idx\", \"prior_mae_pp\"])\n",
    ")\n",
    "\n",
    "print(\"Prior quality by window_idx and case:\")\n",
    "display(summary_by_window_case)\n",
    "\n",
    "pivot = summary_by_window_case.pivot(\n",
    "    index=\"window_idx\",\n",
    "    columns=\"case\",\n",
    "    values=\"prior_mae_pp\",\n",
    ")\n",
    "\n",
    "print(\"\\nPrior MAE pivot: rows=window_idx, columns=case\")\n",
    "display(pivot)"
   ]
  },
