   "source": [
    "# =============================================================================\n",
    "# Diagnose modified-Takagi availability and suspicious selected physics values\n",
    "# =============================================================================\n",
    "\n",
    "final_prior_col = \"d_mod_takagi_tf_only_p_both_mean_pct_filled\"\n",
    "raw_mod_col = \"d_mod_takagi_tf_only_p_both_mean_pct\"\n",
    "availability_col = \"is_mod_takagi_tf_only_available\"\n",
    "\n",
    "diag = work.copy()\n",
    "\n",
    "for col in [\"y_fault_location\", final_prior_col, raw_mod_col, availability_col]:\n",
    "    if col in diag.columns:\n",
    "        diag[col] = pd.to_numeric(diag[col], errors=\"coerce\")\n",
    "\n",
    "# One selected fault-start row per sample, same as prior analysis\n",
    "if \"status\" in diag.columns and (diag[\"status\"] == \"fault_start\").any():\n",
    "    diag = diag.loc[diag[\"status\"].eq(\"fault_start\")].copy()\n",
    "\n",
    "sort_cols = [c for c in [\"sample_id\", \"window_idx\", \"dt_start\"] if c in diag.columns]\n",
    "if sort_cols:\n",
    "    diag = diag.sort_values(sort_cols)\n",
    "\n",
    "diag = diag.drop_duplicates(subset=[\"sample_id\"], keep=\"first\").copy()\n",
    "\n",
    "diag[\"final_prior_abs_error_pp\"] = (\n",
    "    diag[final_prior_col] - diag[\"y_fault_location\"]\n",
    ").abs()\n",
    "\n",
    "print(\"=\" * 100)\n",
    "print(\"Modified Takagi availability by fault case\")\n",
    "\n",
    "availability_by_case = (\n",
    "    diag.groupby(\"case\", observed=True)\n",
    "    .agg(\n",
    "        n=(\"sample_id\", \"size\"),\n",
    "        modified_takagi_available_rate=(\n",
    "            availability_col,\n",
    "            \"mean\",\n",
    "        ),\n",
    "        final_prior_mae_pp=(\n",
    "            \"final_prior_abs_error_pp\",\n",
    "            \"mean\",\n",
    "        ),\n",
    "    )\n",
    "    .sort_values(\"final_prior_mae_pp\", ascending=False)\n",
    ")\n",
    "\n",
    "availability_by_case[\"modified_takagi_available_rate\"] *= 100.0\n",
    "display(availability_by_case.round(3))\n",
    "\n",
    "print(\"\\n\" + \"=\" * 100)\n",
    "print(\"Overall modified Takagi availability\")\n",
    "\n",
    "display(\n",
    "    diag[availability_col]\n",
    "    .value_counts(dropna=False)\n",
    "    .rename_axis(\"available_flag\")\n",
    "    .to_frame(\"n_samples\")\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 100)\n",
    "print(\"Frequency of suspicious final physics estimates\")\n",
    "\n",
    "suspicious_values = [0.0, 50.0, 100.0]\n",
    "\n",
    "for value in suspicious_values:\n",
    "    subset = diag.loc[\n",
    "        np.isclose(diag[final_prior_col], value, atol=1e-6)\n",
    "    ].copy()\n",
    "\n",
    "    print(f\"\\nFinal prior approximately equal to {value:.0f}%\")\n",
    "    print(f\"Number of samples: {len(subset)}\")\n",
    "\n",
    "    if len(subset) > 0:\n",
    "        display(\n",
    "            subset.groupby(\"case\", observed=True)\n",
    "            .agg(\n",
    "                n=(\"sample_id\", \"size\"),\n",
    "                mean_true_distance=(\"y_fault_location\", \"mean\"),\n",
    "                mae_pp=(\"final_prior_abs_error_pp\", \"mean\"),\n",
    "                modified_takagi_available_rate=(availability_col, \"mean\"),\n",
    "            )\n",
    "            .sort_values(\"n\", ascending=False)\n",
    "            .round(3)\n",
    "        )\n",
    "\n",
    "print(\"\\n\" + \"=\" * 100)\n",
    "print(\"Final prior vs raw modified-Takagi value\")\n",
    "\n",
    "comparison_cols = [\n",
    "    col\n",
    "    for col in [\n",
    "        \"sample_id\",\n",
    "        \"case\",\n",
    "        \"y_fault_location\",\n",
    "        final_prior_col,\n",
    "        raw_mod_col,\n",
    "        availability_col,\n",
    "        \"final_prior_abs_error_pp\",\n",
    "    ]\n",
    "    if col in diag.columns\n",
    "]\n",
    "\n",
    "display(\n",
    "    diag[comparison_cols]\n",
    "    .sort_values(\"final_prior_abs_error_pp\", ascending=False)\n",
    "    .head(40)\n",
    ")"
   ]
  },
