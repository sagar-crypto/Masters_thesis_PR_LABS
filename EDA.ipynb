    "def path_contains_experiment(\n",
    "    path: Path,\n",
    "    experiment_id: str,\n",
    ") -> bool:\n",
    "    return (\n",
    "        EXPERIMENT_COMPACT_TOKENS[experiment_id]\n",
    "        in compact_token(str(path))\n",
    "    )\n",
    "\n",
    "\n",
    "def experiments_in_path(path: Path) -> list[str]:\n",
    "    return [\n",
    "        experiment_id\n",
    "        for experiment_id in EXPERIMENTS\n",
    "        if path_contains_experiment(path, experiment_id)\n",
    "    ]\n",
    "\n",
    "\n",
    "def classify_artifact(path: Path) -> list[str]:\n",
    "    \"\"\"\n",
    "    Heuristic role labels.\n",
    "\n",
    "    These labels identify candidates only. They do not establish that a\n",
    "    file is scientifically valid for the final analysis.\n",
    "    \"\"\"\n",
    "    normalized_path = normalize_name(str(path))\n",
    "    filename = normalize_name(path.name)\n",
    "\n",
    "    roles: set[str] = set()\n",
    "\n",
    "    if (\n",
    "        \"prediction\" in filename\n",
    "        or \"predictions\" in filename\n",
    "        or \"oof\" in filename\n",
    "    ):\n",
    "        roles.add(\"prediction_candidate\")\n",
    "\n",
    "    if (\n",
    "        \"model_input\" in normalized_path\n",
    "        or \"modelinput\" in normalized_path\n",
    "        or \"prepared_prior\" in filename\n",
    "    ):\n",
    "        roles.add(\"model_input_candidate\")\n",
    "\n",
    "    if (\n",
    "        \"physics\" in normalized_path\n",
    "        or \"takagi\" in normalized_path\n",
    "        or \"prior\" in filename\n",
    "        or \"operator\" in normalized_path\n",
    "    ):\n",
    "        roles.add(\"physics_or_prior_candidate\")\n",
    "\n",
    "    if (\n",
    "        \"raw_physics\" in normalized_path\n",
    "        or \"unclipped\" in filename\n",
    "        or \"validity\" in filename\n",
    "    ):\n",
    "        roles.add(\"raw_physics_candidate\")\n",
    "\n",
    "    if (\n",
    "        \"fold\" in filename\n",
    "        or \"split\" in filename\n",
    "        or \"mapping_audit\" in filename\n",
    "    ):\n",
    "        roles.add(\"fold_or_split_candidate\")\n",
    "\n",
    "    if \"posthoc_metrics\" in normalized_path:\n",
    "        roles.add(\"existing_posthoc_artifact\")\n",
    "\n",
    "    if (\n",
    "        path.suffix.lower() in TEXT_SUFFIXES\n",
    "        and (\n",
    "            \"config\" in filename\n",
    "            or \"args\" in filename\n",
    "            or \"command\" in filename\n",
    "            or \"status\" in filename\n",
    "            or \"manifest\" in filename\n",
    "            or \"metadata\" in filename\n",
    "        )\n",
    "    ):\n",
    "        roles.add(\"configuration_or_metadata\")\n",
    "\n",
    "    if path.suffix.lower() in {\".log\", \".txt\"}:\n",
    "        roles.add(\"log_or_text\")\n",
    "\n",
    "    if not roles:\n",
    "        roles.add(\"other\")\n",
    "\n",
    "    return sorted(roles)\n",
    "\n",
    "\n",
    "def determine_root_label(path: Path) -> str:\n",
    "    try:\n",
    "        path.relative_to(SINGLE_RUN_ROOT)\n",
    "        return \"single_run\"\n",
    "    except ValueError:\n",
    "        pass\n",
    "\n",
    "    try:\n",
    "        path.relative_to(DOUBLE_RUN_ROOT)\n",
    "        return \"double_run\"\n",
    "    except ValueError:\n",
    "        pass\n",
    "\n",
    "    try:\n",
    "        path.relative_to(DOUBLE_MODEL_INPUT_ROOT)\n",
    "        return \"double_model_input\"\n",
    "    except ValueError:\n",
    "        pass\n",
    "\n",
    "    try:\n",
    "        path.relative_to(CHAPTER4_ROOT)\n",
    "        return \"chapter4_other\"\n",
    "    except ValueError:\n",
    "        return \"external_reference\"\n",
    "\n",
    "\n",
    "def utc_timestamp(timestamp: float) -> str:\n",
    "    return datetime.fromtimestamp(\n",
    "        timestamp,\n",
    "        tz=timezone.utc,\n",
    "    ).isoformat()\n",
    "\n",
    "\n",
    "def is_excluded_path(path: Path) -> bool:\n",
    "    return any(\n",
    "        part in EXCLUDED_DIRECTORY_NAMES\n",
    "        for part in path.parts\n",
    "    )"
   ]
  },
