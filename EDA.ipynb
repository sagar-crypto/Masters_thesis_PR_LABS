   "source": [
    "# =====================================================================\n",
    "# The OOF prior is authoritative for paired model-versus-prior analysis\n",
    "# =====================================================================\n",
    "\n",
    "RAW_EXPORT_ROOT = (\n",
    "    CHAPTER4_ROOT\n",
    "    / \"fresh_prior_exports\"\n",
    "    / \"12098749_20260717_230756\"\n",
    "    / \"raw_exports\"\n",
    ")\n",
    "\n",
    "if not RAW_EXPORT_ROOT.exists():\n",
    "    raise FileNotFoundError(\n",
    "        f\"Raw prior export directory does not exist: {RAW_EXPORT_ROOT}\"\n",
    "    )\n",
    "\n",
    "\n",
    "OOF_PRIOR_AUDIT_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"00D_oof_prior_authority_audit.csv\"\n",
    ")\n",
    "\n",
    "RAW_EXPORT_INVENTORY_PATH = (\n",
    "    FINAL_DIR\n",
    "    / \"00D_raw_prior_export_inventory.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "oof_prior_audit_rows = []\n",
    "core_failures = []\n",
    "\n",
    "\n",
    "for experiment_id, frame in experiment_frames.items():\n",
    "    y_true = pd.to_numeric(\n",
    "        frame[\"y_true_pp\"],\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    "    prior_pp = pd.to_numeric(\n",
    "        frame[\"prior_pp\"],\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    "    saved_prior_error = pd.to_numeric(\n",
    "        frame[\"prior_abs_error_pp\"],\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    "    reconstructed_prior_error = (\n",
    "        prior_pp - y_true\n",
    "    ).abs()\n",
    "\n",
    "    finite_required = (\n",
    "        np.isfinite(y_true)\n",
    "        & np.isfinite(prior_pp)\n",
    "        & np.isfinite(saved_prior_error)\n",
    "    )\n",
    "\n",
    "    nonfinite_count = int(\n",
    "        (~finite_required).sum()\n",
    "    )\n",
    "\n",
    "    prior_error_difference = (\n",
    "        reconstructed_prior_error[finite_required]\n",
    "        - saved_prior_error[finite_required]\n",
    "    ).abs()\n",
    "\n",
    "    prior_error_identity_ok = bool(\n",
    "        nonfinite_count == 0\n",
    "        and (\n",
    "            prior_error_difference\n",
    "            <= ERROR_TOLERANCE\n",
    "        ).all()\n",
    "    )\n",
    "\n",
    "    # -------------------------------------------------------------\n",
    "    # For the single-ended consolidated OOF file, verify how the\n",
    "    # internal d_prior relates to prior_pp.\n",
    "    # -------------------------------------------------------------\n",
    "\n",
    "    d_prior_present = \"d_prior\" in frame.columns\n",
    "\n",
    "    d_prior_relation = \"not_available\"\n",
    "    d_prior_max_difference = np.nan\n",
    "    d_prior_best_transform = None\n",
    "\n",
    "    if d_prior_present:\n",
    "        d_prior = pd.to_numeric(\n",
    "            frame[\"d_prior\"],\n",
    "            errors=\"coerce\",\n",
    "        )\n",
    "\n",
    "        valid_d_prior = (\n",
    "            np.isfinite(d_prior)\n",
    "            & np.isfinite(prior_pp)\n",
    "        )\n",
    "\n",
    "        direct_difference = (\n",
    "            d_prior[valid_d_prior]\n",
    "            - prior_pp[valid_d_prior]\n",
    "        ).abs()\n",
    "\n",
    "        times_100_difference = (\n",
    "            d_prior[valid_d_prior] * 100.0\n",
    "            - prior_pp[valid_d_prior]\n",
    "        ).abs()\n",
    "\n",
    "        direct_max = (\n",
    "            float(direct_difference.max())\n",
    "            if len(direct_difference)\n",
    "            else np.inf\n",
    "        )\n",
    "\n",
    "        times_100_max = (\n",
    "            float(times_100_difference.max())\n",
    "            if len(times_100_difference)\n",
    "            else np.inf\n",
    "        )\n",
    "\n",
    "        if direct_max <= times_100_max:\n",
    "            d_prior_best_transform = \"identity\"\n",
    "            d_prior_max_difference = direct_max\n",
    "        else:\n",
    "            d_prior_best_transform = \"multiply_by_100\"\n",
    "            d_prior_max_difference = times_100_max\n",
    "\n",
    "        if d_prior_max_difference <= VALUE_TOLERANCE:\n",
    "            d_prior_relation = \"verified\"\n",
    "        else:\n",
    "            d_prior_relation = \"not_identical\"\n",
    "\n",
    "    prior_authority_ok = prior_error_identity_ok\n",
    "\n",
    "    oof_prior_audit_rows.append(\n",
    "        {\n",
    "            \"experiment_id\": experiment_id,\n",
    "            \"rows\": int(len(frame)),\n",
    "            \"authoritative_prior_column\": \"prior_pp\",\n",
    "            \"saved_prior_error_column\": (\n",
    "                \"prior_abs_error_pp\"\n",
    "            ),\n",
    "            \"nonfinite_required_values\": (\n",
    "                nonfinite_count\n",
    "            ),\n",
    "            \"prior_error_max_difference\": (\n",
    "                float(prior_error_difference.max())\n",
    "                if len(prior_error_difference)\n",
    "                else np.nan\n",
    "            ),\n",
