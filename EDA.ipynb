   "source": [
    "def load_experiment_slice(\n",
    "    path: Path,\n",
    "    row_filter: dict[str, Any] | None,\n",
    "    columns: list[str] | None = None,\n",
    ") -> pd.DataFrame:\n",
    "    if path.suffix.lower() == \".parquet\":\n",
    "        if row_filter is not None:\n",
    "            filter_tuple = (\n",
    "                row_filter[\"column\"],\n",
    "                \"==\",\n",
    "                row_filter[\"value\"],\n",
    "            )\n",
    "\n",
    "            return pd.read_parquet(\n",
    "                path,\n",
    "                columns=columns,\n",
    "                filters=[filter_tuple],\n",
    "            )\n",
    "\n",
    "        return pd.read_parquet(\n",
    "            path,\n",
    "            columns=columns,\n",
    "        )\n",
    "\n",
    "    if path.suffix.lower() == \".csv\":\n",
    "        frame = pd.read_csv(\n",
    "            path,\n",
    "            usecols=columns,\n",
    "            low_memory=False,\n",
    "        )\n",
    "\n",
    "        if row_filter is not None:\n",
    "            frame = frame.loc[\n",
    "                frame[row_filter[\"column\"]]\n",
    "                == row_filter[\"value\"]\n",
    "            ].copy()\n",
    "\n",
    "        return frame\n",
    "\n",
    "    raise ValueError(f\"Unsupported table: {path}\")\n",
    "\n",
    "\n",
    "slice_audit_rows = []\n",
    "\n",
    "\n",
    "for experiment_id in DOUBLE_EXPERIMENTS:\n",
    "    entry = manifest[\"experiments\"][experiment_id]\n",
    "\n",
    "    selected_path = entry.get(\n",
    "        \"selected_prediction_artifact\"\n",
    "    )\n",
    "\n",
    "    row_filter = entry.get(\n",
    "        \"prediction_row_filter\"\n",
    "    )\n",
    "\n",
    "    expected_rows = EXPERIMENTS[\n",
    "        experiment_id\n",
    "    ][\"expected_rows\"]\n",
    "\n",
    "    if selected_path is None:\n",
    "        slice_audit_rows.append(\n",
    "            {\n",
    "                \"experiment_id\": experiment_id,\n",
    "                \"status\": \"unresolved\",\n",
    "                \"selected_path\": None,\n",
    "                \"row_count\": None,\n",
    "                \"expected_rows\": expected_rows,\n",
    "                \"row_count_matches\": False,\n",
    "                \"error\": \"\",\n",
    "            }\n",
    "        )\n",
    "        continue\n",
    "\n",
    "    try:\n",
    "        frame = load_experiment_slice(\n",
    "            Path(selected_path),\n",
    "            row_filter,\n",
    "            columns=None,\n",
    "        )\n",
    "\n",
    "        row_count = int(len(frame))\n",
    "\n",
    "        slice_audit_rows.append(\n",
    "            {\n",
    "                \"experiment_id\": experiment_id,\n",
    "                \"status\": \"loaded\",\n",
    "                \"selected_path\": selected_path,\n",
    "                \"row_count\": row_count,\n",
    "                \"expected_rows\": expected_rows,\n",
    "                \"row_count_matches\": (\n",
    "                    row_count == expected_rows\n",
    "                ),\n",
    "                \"column_count\": int(len(frame.columns)),\n",
    "                \"error\": \"\",\n",
    "            }\n",
    "        )\n",
    "\n",
    "    except Exception as exc:\n",
    "        slice_audit_rows.append(\n",
    "            {\n",
    "                \"experiment_id\": experiment_id,\n",
    "                \"status\": \"load_error\",\n",
    "                \"selected_path\": selected_path,\n",
    "                \"row_count\": None,\n",
    "                \"expected_rows\": expected_rows,\n",
    "                \"row_count_matches\": False,\n",
    "                \"column_count\": None,\n",
    "                \"error\": repr(exc),\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "double_slice_audit = pd.DataFrame(\n",
    "    slice_audit_rows\n",
    ")\n",
    "\n",
    "display(double_slice_audit)"
   ]
  },
