    "        max_pp=\"max\",\n",
    "    )\n",
    "    .sort_values(\"mae_pp\")\n",
    "    .round(4)\n",
    ")\n",
    "\n",
    "print(\"\\nPer fault type\")\n",
    "display(\n",
    "    analysis_df.groupby(\"case\")[\"abs_error_pp\"]\n",
