    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.preprocessing import PolynomialFeatures\n",
    "from sklearn.pipeline import make_pipeline\n",
    "from sklearn.isotonic import IsotonicRegression\n",
    "from sklearn.metrics import mean_absolute_error, mean_squared_error\n",
    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "run_dir = Path(\n",
    "    \"outputs/MainLn1-2A__kol_operator_features_hv_double_line_110kv_both_all_fault_start_i0res_seq_bothfix__all_faults_casewise_safe__all_fault_start__run_2026-04-29T08:58:37.894958Z\"\n",
    ")\n",
    "\n",
    "ops_path = Path(\n",
    "    \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_both_all_fault_start_i0res_seq_bothfix.csv\"\n",
    ")\n",
    "\n",
    "ops = pd.read_csv(ops_path)\n",
    "ops_line = ops[ops[\"y_fault_line\"].astype(str) == \"MainLn1-2A\"].copy()\n",
    "\n",
    "split_files = sorted((run_dir / \"splits\").glob(\"fold*_splits.json\"))\n",
    "\n",
    "rows = []\n",
    "\n",
    "for p in split_files:\n",
    "    with open(p, \"r\") as f:\n",
    "        split = json.load(f)\n",
    "\n",
    "    fold = int(split[\"fold\"])\n",
    "    test_groups = set(map(int, split[\"test_groups\"]))\n",
    "    train_groups = set(map(int, split[\"train_groups\"]))\n",
    "    val_groups = set(map(int, split[\"val_groups\"]))\n",
    "\n",
    "    train_df = ops_line[ops_line[\"sample_id\"].astype(int).isin(train_groups | val_groups)].copy()\n",
    "    test_df = ops_line[ops_line[\"sample_id\"].astype(int).isin(test_groups)].copy()\n",
    "\n",
    "    x_train = train_df[[\"d_phys_real_pct\"]].to_numpy()\n",
    "    y_train = train_df[\"y_fault_location\"].to_numpy()\n",
    "\n",
    "    x_test = test_df[[\"d_phys_real_pct\"]].to_numpy()\n",
    "    y_test = test_df[\"y_fault_location\"].to_numpy()\n",
    "\n",
    "    # Raw prior\n",
    "    raw_pred = x_test[:, 0]\n",
    "\n",
    "    # Linear calibration\n",
    "    lin = LinearRegression()\n",
    "    lin.fit(x_train, y_train)\n",
    "    lin_pred = np.clip(lin.predict(x_test), 0, 100)\n",
    "\n",
    "    # Quadratic calibration\n",
    "    quad = make_pipeline(\n",
    "        PolynomialFeatures(degree=2, include_bias=False),\n",
    "        LinearRegression()\n",
    "    )\n",
    "    quad.fit(x_train, y_train)\n",
    "    quad_pred = np.clip(quad.predict(x_test), 0, 100)\n",
    "\n",
    "    # Isotonic calibration\n",
    "    # Isotonic expects 1D x\n",
    "    iso = IsotonicRegression(out_of_bounds=\"clip\", y_min=0, y_max=100)\n",
    "    iso.fit(x_train[:, 0], y_train)\n",
    "    iso_pred = np.clip(iso.predict(x_test[:, 0]), 0, 100)\n",
    "\n",
    "    for name, pred in [\n",
    "        (\"raw_prior\", raw_pred),\n",
    "        (\"linear_cal\", lin_pred),\n",
    "        (\"quadratic_cal\", quad_pred),\n",
    "        (\"isotonic_cal\", iso_pred),\n",
    "    ]:\n",
    "        err = pred - y_test\n",
    "        rows.append({\n",
    "            \"fold\": fold,\n",
    "            \"method\": name,\n",
    "            \"n\": len(y_test),\n",
    "            \"mae_pp\": float(np.mean(np.abs(err))),\n",
    "            \"rmse_pp\": float(np.sqrt(np.mean(err ** 2))),\n",
    "            \"bias_pp\": float(np.mean(err)),\n",
    "        })\n",
    "\n",
    "cal_df = pd.DataFrame(rows)\n",
    "\n",
    "display(cal_df)\n",
    "\n",
    "cal_summary = (\n",
    "    cal_df\n",
    "    .groupby(\"method\", as_index=False)\n",
    "    .agg(\n",
    "        mean_mae_pp=(\"mae_pp\", \"mean\"),\n",
    "        std_mae_pp=(\"mae_pp\", \"std\"),\n",
    "        mean_rmse_pp=(\"rmse_pp\", \"mean\"),\n",
    "        mean_bias_pp=(\"bias_pp\", \"mean\"),\n",
    "    )\n",
    "    .sort_values(\"mean_mae_pp\")\n",
    ")\n",
    "\n",
    "display(cal_summary)"
   ]
  },
