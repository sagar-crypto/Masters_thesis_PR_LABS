   "source": [
    "schema_records: list[dict[str, Any]] = []\n",
    "\n",
    "for index, row in schema_candidate_inventory.iterrows():\n",
    "    path = Path(row[\"path\"])\n",
    "    suffix = path.suffix.lower()\n",
    "\n",
    "    print(\n",
    "        f\"[{len(schema_records) + 1:03d}/\"\n",
    "        f\"{len(schema_candidate_inventory):03d}] \"\n",
    "        f\"{path}\"\n",
    "    )\n",
    "\n",
    "    try:\n",
    "        if suffix == \".parquet\":\n",
    "            record = inspect_parquet_schema(path)\n",
    "\n",
    "        elif suffix == \".csv\":\n",
    "            record = inspect_csv_schema(path)\n",
    "\n",
    "        else:\n",
    "            continue\n",
    "\n",
    "    except Exception as exc:\n",
    "        record = {\n",
    "            \"path\": str(path),\n",
    "            \"format\": suffix.lstrip(\".\"),\n",
    "            \"size_bytes\": (\n",
    "                int(path.stat().st_size)\n",
    "                if path.exists()\n",
    "                else None\n",
    "            ),\n",
    "            \"row_count\": None,\n",
    "            \"columns\": [],\n",
    "            \"column_count\": 0,\n",
    "            \"alias_resolution\": {},\n",
    "            \"probe_values\": {},\n",
    "            \"schema_error\": repr(exc),\n",
    "        }\n",
    "\n",
    "    record[\"root_label\"] = row[\"root_label\"]\n",
    "    record[\"artifact_roles\"] = row[\"artifact_roles\"]\n",
    "    record[\"experiment_tokens_in_path\"] = row[\n",
    "        \"experiment_tokens_in_path\"\n",
    "    ]\n",
    "\n",
    "    schema_records.append(record)\n",
    "\n",
    "\n",
    "schema_json_path = (\n",
    "    FINAL_DIR / \"artifact_schema_inventory.json\"\n",
    ")\n",
    "\n",
    "with schema_json_path.open(\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    json.dump(\n",
    "        schema_records,\n",
    "        file,\n",
    "        indent=2,\n",
    "        ensure_ascii=False,\n",
    "        default=str,\n",
    "    )\n",
    "\n",
    "\n",
    "schema_summary_rows = []\n",
    "\n",
    "for record in schema_records:\n",
    "    error = record.get(\"schema_error\")\n",
    "\n",
    "    alias_resolution = record.get(\n",
    "        \"alias_resolution\",\n",
    "        {},\n",
    "    )\n",
    "\n",
    "    resolved_fields = [\n",
    "        canonical_field\n",
    "        for canonical_field, resolution\n",
    "        in alias_resolution.items()\n",
    "        if resolution.get(\"status\") == \"resolved\"\n",
    "    ]\n",
    "\n",
    "    ambiguous_fields = [\n",
    "        canonical_field\n",
    "        for canonical_field, resolution\n",
    "        in alias_resolution.items()\n",
    "        if resolution.get(\"status\") == \"ambiguous\"\n",
    "    ]\n",
    "\n",
    "    schema_summary_rows.append(\n",
    "        {\n",
    "            \"path\": record[\"path\"],\n",
    "            \"root_label\": record.get(\"root_label\"),\n",
    "            \"format\": record.get(\"format\"),\n",
    "            \"size_bytes\": record.get(\"size_bytes\"),\n",
    "            \"row_count\": record.get(\"row_count\"),\n",
    "            \"sample_row_count\": record.get(\n",
    "                \"sample_row_count\"\n",
    "            ),\n",
    "            \"column_count\": record.get(\n",
    "                \"column_count\"\n",
    "            ),\n",
    "            \"resolved_fields\": \"|\".join(\n",
    "                resolved_fields\n",
    "            ),\n",
    "            \"ambiguous_fields\": \"|\".join(\n",
    "                ambiguous_fields\n",
    "            ),\n",
    "            \"experiment_probe_values\": json.dumps(\n",
    "                record.get(\n",
    "                    \"probe_values\",\n",
    "                    {},\n",
    "                ).get(\n",
    "                    \"experiment_id\",\n",
    "                    [],\n",
    "                ),\n",
    "                ensure_ascii=False,\n",
    "            ),\n",
    "            \"schema_error\": error,\n",
    "            \"artifact_roles\": record.get(\n",
    "                \"artifact_roles\"\n",
    "            ),\n",
    "            \"experiment_tokens_in_path\": record.get(\n",
    "                \"experiment_tokens_in_path\"\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "schema_summary = pd.DataFrame(\n",
    "    schema_summary_rows\n",
    ")\n",
    "\n",
    "schema_csv_path = (\n",
    "    FINAL_DIR / \"artifact_schema_inventory.csv\"\n",
    ")\n",
    "\n",
    "schema_summary.to_csv(\n",
    "    schema_csv_path,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "print(\"\\nSaved:\", schema_json_path)\n",
    "print(\"Saved:\", schema_csv_path)\n",
    "\n",
    "schema_error_count = int(\n",
    "    schema_summary[\"schema_error\"].notna().sum()\n",
    ")\n",
    "\n",
    "print(\"Schema inspection errors:\", schema_error_count)\n",
    "\n",
    "if schema_error_count:\n",
    "    display(\n",
