    "# Old selected-prior SLG performance\n",
    "old_slg = old_df[old_df[\"case\"].isin([\"slg_a\", \"slg_b\", \"slg_c\"])].copy()\n",
    "\n",
    "old_slg_rows = []\n",
    "for (line, case), g in old_slg.groupby([\"y_fault_line\", \"case\"]):\n",
    "    err = g[\"d_phys_real_pct\"] - g[\"y_fault_location\"]\n",
    "    old_slg_rows.append({\n",
    "        \"line\": line,\n",
    "        \"case\": case,\n",
    "        \"n\": len(g),\n",
    "        \"old_selected_mae\": err.abs().mean(),\n",
    "        \"old_selected_bias\": err.mean(),\n",
    "        \"old_strategy\": g[\"d_phys_real_strategy\"].iloc[0] if \"d_phys_real_strategy\" in g.columns else \"unknown\",\n",
    "    })\n",
    "\n",
    "old_selected_slg = pd.DataFrame(old_slg_rows)\n",
    "\n",
    "compare_slg = old_selected_slg.merge(\n",
    "    new_slg_summary[[\"line\", \"case\", \"best_prior\", \"best_prior_mae\"]],\n",
    "    on=[\"line\", \"case\"],\n",
    "    how=\"left\"\n",
    ")\n",
    "\n",
    "compare_slg[\"gain_vs_old_selected\"] = compare_slg[\"old_selected_mae\"] - compare_slg[\"best_prior_mae\"]\n",
    "\n",
    "compare_slg.sort_values([\"line\", \"case\"]).round(2)"
   ]
