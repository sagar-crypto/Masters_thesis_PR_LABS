    "prior_candidates = {\n",
    "    \"old\": \"d_phys_real_pct_original\",\n",
    "    \"takagi_local\": \"d_takagi_local_pct\",\n",
    "    \"takagi_remote_flipped\": \"d_takagi_remote_flipped_pct\",\n",
    "    \"takagi_both_mean\": \"d_takagi_both_mean_pct\",\n",
    "    \"selected_caseaware\": \"d_phys_real_pct\",\n",
    "}\n",
    "\n",
    "available_priors = {\n",
    "    name: col\n",
    "    for name, col in prior_candidates.items()\n",
    "    if col in df4.columns\n",
    "}\n",
    "\n",
    "rows = []\n",
    "\n",
    "for line, g in df4.groupby(line_col):\n",
    "    row = {\n",
    "        \"line\": line,\n",
    "        \"n\": len(g),\n",
    "    }\n",
    "\n",
    "    for name, col in available_priors.items():\n",
    "        row[f\"{name}_mae_pp\"] = 100 * (g[target_col] - g[col]).abs().mean()\n",
    "        row[f\"{name}_bias_pp\"] = 100 * (g[col] - g[target_col]).mean()\n",
    "\n",
    "    rows.append(row)\n",
    "\n",
    "line_prior_summary = pd.DataFrame(rows)\n",
    "\n",
    "mae_cols = [c for c in line_prior_summary.columns if c.endswith(\"_mae_pp\")]\n",
    "bias_cols = [c for c in line_prior_summary.columns if c.endswith(\"_bias_pp\")]\n",
    "\n",
    "line_prior_summary = line_prior_summary[[\"line\", \"n\"] + mae_cols + bias_cols]\n",
    "\n",
    "line_prior_summary.round(2)"
   ]
  },
