    "\n",
    "    top_candidates = candidates[:10]\n",
    "\n",
    "    if not top_candidates:\n",
    "        candidate_summary_rows.append(\n",
    "            {\n",
    "                \"experiment_id\": experiment_id,\n",
    "                \"selection_status\": (\n",
    "                    experiment_manifest[\n",
    "                        \"prediction_selection_status\"\n",
    "                    ]\n",
    "                ),\n",
    "                \"selected_path\": (\n",
    "                    experiment_manifest[\n",
    "                        \"selected_prediction_artifact\"\n",
    "                    ]\n",
    "                ),\n",
    "                \"candidate_rank\": None,\n",
    "                \"score\": None,\n",
    "                \"candidate_path\": None,\n",
    "                \"reasons\": None,\n",
    "            }\n",
    "        )\n",
    "        continue\n",
    "\n",
    "    for rank, candidate in enumerate(\n",
    "        top_candidates,\n",
    "        start=1,\n",
    "    ):\n",
    "        candidate_summary_rows.append(\n",
    "            {\n",
    "                \"experiment_id\": experiment_id,\n",
    "                \"selection_status\": (\n",
    "                    experiment_manifest[\n",
    "                        \"prediction_selection_status\"\n",
    "                    ]\n",
    "                ),\n",
    "                \"selected_path\": (\n",
    "                    experiment_manifest[\n",
    "                        \"selected_prediction_artifact\"\n",
    "                    ]\n",
    "                ),\n",
    "                \"candidate_rank\": rank,\n",
    "                \"score\": candidate[\"score\"],\n",
    "                \"candidate_path\": candidate[\"path\"],\n",
    "                \"reasons\": \" | \".join(\n",
    "                    candidate[\"reasons\"]\n",
    "                ),\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "candidate_summary = pd.DataFrame(\n",
    "    candidate_summary_rows\n",
    ")\n",
    "\n",
    "candidate_summary_path = (\n",
    "    FINAL_DIR\n",
    "    / \"experiment_prediction_candidates.csv\"\n",
    ")\n",
    "\n",
    "candidate_summary.to_csv(\n",
    "    candidate_summary_path,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "print(\"Saved:\", candidate_summary_path)\n",
    "\n",
    "display(candidate_summary)"
