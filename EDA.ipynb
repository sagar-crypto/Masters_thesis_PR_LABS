    "fold_ops[\"prior_err_pp\"] = fold_ops[\"d_phys_real_pct\"] - fold_ops[\"y_fault_location\"]\n",
    "fold_ops[\"prior_abs_err_pp\"] = fold_ops[\"prior_err_pp\"].abs()\n",
    "\n",
    "prior_by_fold = (\n",
    "    fold_ops\n",
    "    .groupby(\"fold\", as_index=False)\n",
    "    .agg(\n",
    "        n=(\"sample_id\", \"count\"),\n",
    "        unique_samples=(\"sample_id\", \"nunique\"),\n",
    "        prior_mae_pp=(\"prior_abs_err_pp\", \"mean\"),\n",
    "        prior_rmse_pp=(\"prior_err_pp\", lambda x: float(np.sqrt(np.mean(np.square(x))))),\n",
    "        prior_bias_pp=(\"prior_err_pp\", \"mean\"),\n",
    "    )\n",
    ")\n",
    "\n",
    "display(prior_by_fold)"
   ]
