    "candidate_summary_rows: list[dict[str, Any]] = []\n",
    "\n",
    "\n",
    "for experiment_id, experiment_manifest in (\n",
    "    manifest[\"experiments\"].items()\n",
    "):\n",
    "    candidates = experiment_manifest[\n",
    "        \"prediction_candidates\"\n",
