   "source": [
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# Configuration\n",
    "# =============================================================================\n",
    "CSV_PATH = Path(\n",
    "    \"/home/vault/iwi5/iwi5305h/\"\n",
    "    \"kol_operator_features_hv_double_line_110kv_line_caseaware_mod_takagi_tf_only_prior_filled.csv\"\n",
    ")\n",
    "\n",
    "LINE = \"MainLn1-2A\"\n",
    "\n",
    "# Your latest modified-prior run reported:\n",
    "# test/prior_mae = 0.129331 -> 12.9331 percentage points.\n",
    "EXPECTED_PRIOR_MAE_PCT = 12.9331\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# Load and apply the same general sample selection used by the KOL experiment\n",
    "# =============================================================================\n",
    "df = pd.read_csv(CSV_PATH, low_memory=False)\n",
    "\n",
    "if \"y_fault_line\" not in df.columns:\n",
    "    raise KeyError(\"Expected column 'y_fault_line' was not found.\")\n",
    "\n",
    "if \"y_fault_location\" not in df.columns:\n",
    "    raise KeyError(\"Expected column 'y_fault_location' was not found.\")\n",
    "\n",
    "if \"sample_id\" not in df.columns:\n",
    "    raise KeyError(\"Expected column 'sample_id' was not found.\")\n",
    "\n",
    "work = df.loc[df[\"y_fault_line\"].eq(LINE)].copy()\n",
    "\n",
    "print(\"=\" * 100)\n",
    "print(f\"Raw rows for {LINE}: {len(work):,}\")\n",
    "\n",
    "if \"status\" in work.columns:\n",
    "    print(\"\\nStatus distribution before filtering:\")\n",
    "    display(work[\"status\"].value_counts(dropna=False).to_frame(\"count\"))\n",
    "\n",
    "    if (work[\"status\"] == \"fault_start\").any():\n",
    "        work = work.loc[work[\"status\"].eq(\"fault_start\")].copy()\n",
    "        print(f\"\\nRows after status == 'fault_start': {len(work):,}\")\n",
    "    else:\n",
    "        print(\"\\nWARNING: No rows with status == 'fault_start' were found. \"\n",
    "              \"Keeping all rows for now.\")\n",
    "\n",
    "# Keep the first selected row per sample to avoid counting repeated windows.\n",
    "sort_cols = [c for c in [\"sample_id\", \"window_idx\", \"dt_start\"] if c in work.columns]\n",
    "if sort_cols:\n",
    "    work = work.sort_values(sort_cols)\n",
    "\n",
    "rows_before_dedup = len(work)\n",
    "work = work.drop_duplicates(subset=[\"sample_id\"], keep=\"first\").copy()\n",
    "\n",
    "print(f\"Rows after one-row-per-sample selection: {len(work):,}\")\n",
    "print(f\"Duplicate rows removed: {rows_before_dedup - len(work):,}\")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# Find likely physics distance-estimate columns\n",
    "# =============================================================================\n",
    "known_candidates = [\n",
    "    \"d_phys_real_pct_original\",\n",
    "    \"d_phys_real_pct_before_mod_takagi_caseaware\",\n",
    "    \"d_mod_takagi_tf_only_p_both_mean_pct_filled\",\n",
    "]\n",
    "\n",
    "# Also look for additional physics/Takagi distance columns that may exist in CSV.\n",
    "auto_candidates = [\n",
    "    col\n",
    "    for col in work.columns\n",
    "    if (\n",
    "        col.startswith(\"d_phys_\")\n",
    "        or col.startswith(\"d_mod_takagi_\")\n",
    "    )\n",
    "    and \"pct\" in col.lower()\n",
    "    and \"err\" not in col.lower()\n",
    "    and \"error\" not in col.lower()\n",
    "    and \"disagreement\" not in col.lower()\n",
    "]\n",
    "\n",
    "candidate_cols = list(dict.fromkeys(\n",
    "    [col for col in known_candidates if col in work.columns] + auto_candidates\n",
    "))\n",
    "\n",
    "print(\"\\n\" + \"=\" * 100)\n",
    "print(\"Physics / Takagi distance candidates found:\")\n",
    "for col in candidate_cols:\n",
    "    print(\"-\", col)\n",
    "\n",
    "if not candidate_cols:\n",
    "    raise RuntimeError(\n",
    "        \"No candidate physics distance columns were found. \"\n",
    "        \"Please print columns containing 'd_phys' or 'd_mod_takagi'.\"\n",
    "    )\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# Calculate operator-error statistics\n",
    "# All distances are already in percentage of line length: 0 to 100.\n",
    "# =============================================================================\n",
    "y_true = pd.to_numeric(work[\"y_fault_location\"], errors=\"coerce\")\n",
    "\n",
    "rows = []\n",
    "\n",
    "for col in candidate_cols:\n",
    "    y_pred = pd.to_numeric(work[col], errors=\"coerce\")\n",
    "\n",
    "    valid = y_true.notna() & y_pred.notna()\n",
    "    true_valid = y_true.loc[valid]\n",
    "    pred_valid = y_pred.loc[valid]\n",
    "\n",
    "    if len(true_valid) == 0:\n",
    "        continue\n",
    "\n",
    "    signed_error = pred_valid - true_valid\n",
    "    abs_error = signed_error.abs()\n",
    "\n",
    "    rows.append(\n",
    "        {\n",
    "            \"operator_column\": col,\n",
    "            \"n_valid\": len(abs_error),\n",
    "            \"mae_pct_points\": abs_error.mean(),\n",
    "            \"median_abs_error\": abs_error.median(),\n",
    "            \"rmse_pct_points\": np.sqrt(np.mean(signed_error**2)),\n",
    "            \"p90_abs_error\": abs_error.quantile(0.90),\n",
    "            \"p95_abs_error\": abs_error.quantile(0.95),\n",
    "            \"p99_abs_error\": abs_error.quantile(0.99),\n",
    "            \"max_abs_error\": abs_error.max(),\n",
    "            \"within_5pp_pct\": 100.0 * (abs_error <= 5.0).mean(),\n",
    "            \"within_10pp_pct\": 100.0 * (abs_error <= 10.0).mean(),\n",
    "            \"within_20pp_pct\": 100.0 * (abs_error <= 20.0).mean(),\n",
    "            \"out_of_range_pct\": 100.0 * ((pred_valid < 0.0) | (pred_valid > 100.0)).mean(),\n",
    "            \"prediction_min\": pred_valid.min(),\n",
    "            \"prediction_max\": pred_valid.max(),\n",
    "        }\n",
    "    )\n",
    "\n",
    "summary_df = (\n",
    "    pd.DataFrame(rows)\n",
    "    .sort_values(\"mae_pct_points\")\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 100)\n",
    "print(\"Physics-operator summary\")\n",
    "display(summary_df.round(3))\n",
    "\n",
    "# Identify the candidate whose MAE most closely matches the prior MAE\n",
    "# reported by the KOL experiment.\n",
    "summary_df[\"difference_from_cv_prior_mae\"] = (\n",
    "    summary_df[\"mae_pct_points\"] - EXPECTED_PRIOR_MAE_PCT\n",
    ").abs()\n",
    "\n",
    "matched_row = summary_df.loc[\n",
    "    summary_df[\"difference_from_cv_prior_mae\"].idxmin()\n",
    "]\n",
    "\n",
    "selected_operator_col = matched_row[\"operator_column\"]\n",
    "\n",
    "print(\"\\n\" + \"=\" * 100)\n",
    "print(\"Closest match to the KOL-reported prior MAE\")\n",
    "print(f\"Expected CV prior MAE: {EXPECTED_PRIOR_MAE_PCT:.4f} percentage points\")\n",
    "print(f\"Matched column:        {selected_operator_col}\")\n",
    "print(f\"Matched MAE:           {matched_row['mae_pct_points']:.4f} percentage points\")\n",
    "print(f\"Difference:            {matched_row['difference_from_cv_prior_mae']:.4f}\")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# Detailed analysis for the selected operator\n",
    "# =============================================================================\n",
    "analysis_cols = [\n",
    "    col\n",
    "    for col in [\n",
    "        \"sample_id\",\n",
    "        \"window_idx\",\n",
    "        \"status\",\n",
    "        \"y_fault_line\",\n",
    "        \"case\",\n",
    "        \"line_len_km\",\n",
    "        \"y_fault_location\",\n",
    "        selected_operator_col,\n",
    "    ]\n",
    "    if col in work.columns\n",
    "]\n",
    "\n",
    "analysis_df = work[analysis_cols].copy()\n",
    "\n",
    "analysis_df = analysis_df.rename(\n",
    "    columns={\n",
    "        \"y_fault_location\": \"true_distance_pct\",\n",
    "        selected_operator_col: \"physics_distance_pct\",\n",
    "    }\n",
    ")\n",
    "\n",
    "analysis_df[\"true_distance_pct\"] = pd.to_numeric(\n",
    "    analysis_df[\"true_distance_pct\"],\n",
    "    errors=\"coerce\",\n",
    ")\n",
    "\n",
    "analysis_df[\"physics_distance_pct\"] = pd.to_numeric(\n",
    "    analysis_df[\"physics_distance_pct\"],\n",
    "    errors=\"coerce\",\n",
    ")\n",
    "\n",
    "analysis_df = analysis_df.dropna(\n",
    "    subset=[\"true_distance_pct\", \"physics_distance_pct\"]\n",
    ").copy()\n",
    "\n",
    "analysis_df[\"physics_signed_error_pct\"] = (\n",
    "    analysis_df[\"physics_distance_pct\"] - analysis_df[\"true_distance_pct\"]\n",
    ")\n",
    "\n",
    "analysis_df[\"physics_abs_error_pct\"] = (\n",
    "    analysis_df[\"physics_signed_error_pct\"].abs()\n",
    ")\n",
    "\n",
    "analysis_df[\"distance_bin\"] = pd.cut(\n",
    "    analysis_df[\"true_distance_pct\"],\n",
    "    bins=np.arange(0, 110, 10),\n",
    "    include_lowest=True,\n",
    "    right=True,\n",
    ")\n",
    "\n",
    "# Check whether the existing exported error column corresponds to this estimate.\n",
    "if \"mod_caseaware_abs_err\" in work.columns:\n",
    "    check_df = work[\n",
    "        [\"y_fault_location\", selected_operator_col, \"mod_caseaware_abs_err\"]\n",
    "    ].copy()\n",
    "\n",
    "    check_df = check_df.apply(pd.to_numeric, errors=\"coerce\").dropna()\n",
    "\n",
    "    if len(check_df) > 0:\n",
    "        recomputed_error = (\n",
    "            check_df[selected_operator_col] - check_df[\"y_fault_location\"]\n",
    "        ).abs()\n",
    "\n",
    "        max_difference = (\n",
    "            recomputed_error - check_df[\"mod_caseaware_abs_err\"]\n",
    "        ).abs().max()\n",
    "\n",
    "        print(\"\\n\" + \"=\" * 100)\n",
    "        print(\"Check against 'mod_caseaware_abs_err'\")\n",
    "        print(\n",
    "            \"Maximum difference between recomputed error and exported \"\n",
    "            f\"mod_caseaware_abs_err: {max_difference:.8f}\"\n",
    "        )\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# Does a small number of outliers dominate the MAE?\n",
    "# =============================================================================\n",
    "errors = analysis_df[\"physics_abs_error_pct\"]\n",
    "\n",
    "trimmed_95_mae = errors.loc[errors <= errors.quantile(0.95)].mean()\n",
    "trimmed_90_mae = errors.loc[errors <= errors.quantile(0.90)].mean()\n",
    "\n",
    "print(\"\\n\" + \"=\" * 100)\n",
    "print(\"Outlier / tail-error diagnostic\")\n",
    "print(f\"Selected physics operator: {selected_operator_col}\")\n",
    "print(f\"Samples analysed:          {len(analysis_df):,}\")\n",
    "print(f\"MAE:                       {errors.mean():.3f} percentage points\")\n",
    "print(f\"Median absolute error:     {errors.median():.3f} percentage points\")\n",
    "print(f\"P90 absolute error:        {errors.quantile(0.90):.3f} percentage points\")\n",
    "print(f\"P95 absolute error:        {errors.quantile(0.95):.3f} percentage points\")\n",
    "print(f\"P99 absolute error:        {errors.quantile(0.99):.3f} percentage points\")\n",
    "print(f\"Maximum absolute error:    {errors.max():.3f} percentage points\")\n",
    "print(f\"Trimmed MAE, best 95%:     {trimmed_95_mae:.3f} percentage points\")\n",
    "print(f\"Trimmed MAE, best 90%:     {trimmed_90_mae:.3f} percentage points\")\n",
    "print(f\"Share with error > 20 pp:  {100.0 * (errors > 20.0).mean():.2f}%\")\n",
    "print(f\"Share with error > 40 pp:  {100.0 * (errors > 40.0).mean():.2f}%\")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# Worst physics estimates\n",
    "# =============================================================================\n",
    "print(\"\\n\" + \"=\" * 100)\n",
    "print(\"Worst 25 physics estimates\")\n",
    "display(\n",
    "    analysis_df\n",
    "    .sort_values(\"physics_abs_error_pct\", ascending=False)\n",
    "    .head(25)\n",
    ")\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# Error by fault type and true-distance region\n",
    "# =============================================================================\n",
    "if \"case\" in analysis_df.columns:\n",
    "    error_by_case = (\n",
    "        analysis_df\n",
    "        .groupby(\"case\", observed=True)\n",
    "        .agg(\n",
    "            n=(\"physics_abs_error_pct\", \"size\"),\n",
    "            mae_pct=(\"physics_abs_error_pct\", \"mean\"),\n",
    "            median_abs_error_pct=(\"physics_abs_error_pct\", \"median\"),\n",
    "            p95_abs_error_pct=(\n",
    "                \"physics_abs_error_pct\",\n",
    "                lambda s: s.quantile(0.95),\n",
    "            ),\n",
    "            max_abs_error_pct=(\"physics_abs_error_pct\", \"max\"),\n",
    "        )\n",
    "        .sort_values(\"mae_pct\", ascending=False)\n",
    "    )\n",
    "\n",
    "    print(\"\\n\" + \"=\" * 100)\n",
    "    print(\"Physics error by fault case\")\n",
    "    display(error_by_case.round(3))\n",
    "\n",
    "error_by_distance = (\n",
    "    analysis_df\n",
    "    .groupby(\"distance_bin\", observed=True)\n",
    "    .agg(\n",
    "        n=(\"physics_abs_error_pct\", \"size\"),\n",
    "        mae_pct=(\"physics_abs_error_pct\", \"mean\"),\n",
    "        median_abs_error_pct=(\"physics_abs_error_pct\", \"median\"),\n",
    "        p95_abs_error_pct=(\n",
    "            \"physics_abs_error_pct\",\n",
    "            lambda s: s.quantile(0.95),\n",
    "        ),\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 100)\n",
    "print(\"Physics error by true fault-distance bin\")\n",
    "display(error_by_distance.round(3))\n",
    "\n",
    "\n",
    "# =============================================================================\n",
    "# Two quick plots\n",
    "# =============================================================================\n",
    "fig, ax = plt.subplots(figsize=(7, 7))\n",
    "\n",
    "ax.scatter(\n",
    "    analysis_df[\"true_distance_pct\"],\n",
    "    analysis_df[\"physics_distance_pct\"],\n",
    "    alpha=0.35,\n",
    "    s=18,\n",
    ")\n",
    "\n",
    "ax.plot([0, 100], [0, 100], linestyle=\"--\")\n",
    "\n",
    "ax.set_title(f\"Physics estimate vs. true distance — {LINE}\")\n",
    "ax.set_xlabel(\"True fault distance (% of line)\")\n",
    "ax.set_ylabel(\"Physics operator estimate (% of line)\")\n",
    "ax.set_xlim(0, 100)\n",
    "ax.set_ylim(0, 100)\n",
    "ax.grid(True, alpha=0.3)\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 4))\n",
    "\n",
    "ax.hist(\n",
    "    analysis_df[\"physics_abs_error_pct\"],\n",
    "    bins=40,\n",
    ")\n",
    "\n",
    "ax.axvline(\n",
    "    analysis_df[\"physics_abs_error_pct\"].median(),\n",
    "    linestyle=\"--\",\n",
    "    label=f\"Median = {analysis_df['physics_abs_error_pct'].median():.2f} pp\",\n",
    ")\n",
    "\n",
    "ax.axvline(\n",
    "    analysis_df[\"physics_abs_error_pct\"].mean(),\n",
    "    linestyle=\"--\",\n",
    "    label=f\"MAE = {analysis_df['physics_abs_error_pct'].mean():.2f} pp\",\n",
    ")\n",
    "\n",
    "ax.set_title(f\"Physics absolute-error distribution — {LINE}\")\n",
    "ax.set_xlabel(\"Absolute error (percentage points)\")\n",
    "ax.set_ylabel(\"Number of samples\")\n",
    "ax.grid(True, alpha=0.3)\n",
    "ax.legend()\n",
    "\n",
    "plt.show()"
   ]
  },
