    "def normalize_phase_text(x):\n",
    "    if pd.isna(x):\n",
    "        return \"\"\n",
    "    s = str(x).strip().lower()\n",
    "    s = s.replace(\"-\", \"\").replace(\"_\", \"\").replace(\" \", \"\")\n",
    "    s = s.replace(\"phase\", \"\").replace(\"phases\", \"\")\n",
    "    mapping = {\n",
    "        \"l1\": \"a\",\n",
    "        \"l2\": \"b\",\n",
    "        \"l3\": \"c\",\n",
    "        \"ac\": \"ca\",\n",
    "    }\n",
    "    return mapping.get(s, s)\n",
    "\n",
    "\n",
    "def infer_fault_case_110(row):\n",
    "    event_type = str(row[\"events/event_type\"]).strip().lower()\n",
    "    phase_1ph = normalize_phase_text(row[\"events/event_phase_select_1ph\"])\n",
    "    phase_2ph = normalize_phase_text(row[\"events/event_phase_select_2ph\"])\n",
    "\n",
    "    # 3-phase\n",
    "    if event_type in {\"3ph\", \"3-phase\", \"3_phase\", \"three_phase\", \"abc\"}:\n",
    "        return \"3ph\"\n",
    "\n",
    "    # single-line-to-ground\n",
    "    if event_type in {\"slg\", \"1phg\", \"lg\", \"single_line_to_ground\", \"1ph_ground\"}:\n",
    "        if phase_1ph in {\"a\", \"b\", \"c\"}:\n",
    "            return f\"slg_{phase_1ph}\"\n",
    "        return \"slg_unknown\"\n",
    "\n",
    "    # line-to-line\n",
    "    if event_type in {\"ll\", \"2ph\", \"line_to_line\"}:\n",
    "        if phase_2ph in {\"ab\", \"bc\", \"ca\"}:\n",
    "            return f\"ll_{phase_2ph}\"\n",
    "        return \"ll_unknown\"\n",
    "\n",
    "    # double-line-to-ground\n",
    "    if event_type in {\"llg\", \"2phg\", \"double_line_to_ground\", \"line_line_ground\"}:\n",
    "        if phase_2ph in {\"ab\", \"bc\", \"ca\"}:\n",
    "            return f\"llg_{phase_2ph}\"\n",
    "        return \"llg_unknown\"\n",
    "\n",
    "    return event_type"
   ]
  },
