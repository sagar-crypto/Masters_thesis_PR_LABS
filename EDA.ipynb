   "source": [
    "in_csv = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_both_all_fault_start_k0fixed.csv\"\n",
    "\n",
    "out_csv = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_line_caseaware_takagi_prior_k0fixed.csv\"\n",
    "\n",
    "df = pd.read_csv(in_csv)\n",
    "\n",
    "line_col = \"y_fault_line\"\n",
    "case_col = \"case\"\n",
    "\n",
    "# Preserve original/default physics prior\n",
    "df[\"d_phys_real_pct_original\"] = df[\"d_phys_real_pct\"]\n",
    "df[\"d_phys_real_pct_before_line_caseaware\"] = df[\"d_phys_real_pct\"]\n",
    "\n",
    "# Start with original prior\n",
    "df[\"d_phys_real_strategy\"] = \"old_default\"\n",
    "df[\"d_phys_real_pct\"] = df[\"d_phys_real_pct_original\"]\n",
    "\n",
    "main12_lines = [\"MainLn1-2A\", \"MainLn1-2B\"]\n",
    "main23_lines = [\"MainLn2-3A\", \"MainLn2-3B\"]\n",
    "\n",
    "takagi_cases = [\n",
    "    \"3ph\",\n",
    "    \"ll_ab\", \"ll_bc\", \"ll_ca\",\n",
    "    \"llg_ab\", \"llg_bc\", \"llg_ca\",\n",
    "]\n",
    "\n",
    "# MainLn1-2A/B: Takagi local for 3ph/LL/LLG\n",
    "mask_main12 = df[line_col].isin(main12_lines) & df[case_col].isin(takagi_cases)\n",
    "df.loc[mask_main12, \"d_phys_real_pct\"] = df.loc[mask_main12, \"d_takagi_local_pct\"]\n",
    "df.loc[mask_main12, \"d_phys_real_strategy\"] = \"takagi_local_main12_3ph_ll_llg\"\n",
    "\n",
    "# MainLn2-3A/B: Takagi remote-flipped for 3ph/LL/LLG\n",
    "mask_main23 = df[line_col].isin(main23_lines) & df[case_col].isin(takagi_cases)\n",
    "df.loc[mask_main23, \"d_phys_real_pct\"] = df.loc[mask_main23, \"d_takagi_remote_flipped_pct\"]\n",
    "df.loc[mask_main23, \"d_phys_real_strategy\"] = \"takagi_remote_flipped_main23_3ph_ll_llg\"\n",
    "\n",
    "# Old SLG rule:\n",
    "# slg_a -> old/default\n",
    "mask_slg_a = df[case_col].eq(\"slg_a\")\n",
    "df.loc[mask_slg_a, \"d_phys_real_pct\"] = df.loc[mask_slg_a, \"d_phys_real_pct_original\"]\n",
    "df.loc[mask_slg_a, \"d_phys_real_strategy\"] = \"old_prior_slg_a\"\n",
    "\n",
    "# slg_b/slg_c -> Takagi both-side mean\n",
    "mask_slg_bc = df[case_col].isin([\"slg_b\", \"slg_c\"])\n",
    "df.loc[mask_slg_bc, \"d_phys_real_pct\"] = df.loc[mask_slg_bc, \"d_takagi_both_mean_pct\"]\n",
    "df.loc[mask_slg_bc, \"d_phys_real_strategy\"] = \"takagi_both_mean_slg_b_c\"\n",
    "\n",
    "df[\"line_caseaware_abs_err\"] = (\n",
    "    df[\"y_fault_location\"] - df[\"d_phys_real_pct\"]\n",
    ").abs()\n",
    "\n",
    "df[\"prior_selected_is_takagi\"] = (\n",
    "    df[\"d_phys_real_strategy\"].str.contains(\"takagi\", case=False, na=False).astype(int)\n",
    ")\n",
    "\n",
    "print(\"Strategy counts:\")\n",
    "print(df[\"d_phys_real_strategy\"].value_counts())\n",
    "\n",
    "print(\"\\nLine-wise selected prior MAE:\")\n",
    "line_mae = (\n",
    "    df.groupby(line_col)\n",
    "      .apply(lambda g: (g[\"y_fault_location\"] - g[\"d_phys_real_pct\"]).abs().mean())\n",
    "      .rename(\"prior_mae\")\n",
    "      .reset_index()\n",
    ")\n",
    "display(line_mae.round(4))\n",
    "\n",
    "print(\"\\nCase-wise selected prior MAE:\")\n",
    "case_mae = (\n",
    "    df.groupby([line_col, case_col])\n",
    "      .agg(\n",
    "          n=(case_col, \"size\"),\n",
    "          strategy=(\"d_phys_real_strategy\", \"first\"),\n",
    "          mae=(\"line_caseaware_abs_err\", \"mean\"),\n",
    "      )\n",
    "      .reset_index()\n",
    "      .sort_values([line_col, case_col])\n",
    ")\n",
    "display(case_mae.round(4))\n",
    "\n",
    "df.to_csv(out_csv, index=False)\n",
    "print(\"Saved:\", out_csv)"
   ]
  },
