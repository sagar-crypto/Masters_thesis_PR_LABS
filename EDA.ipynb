   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# Input: CSV that contains the modified Takagi columns\n",
    "in_csv = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_both_all_fault_start_mod_takagi_tf_only.csv\"\n",
    "\n",
    "# Output: new selective prior CSV\n",
    "out_csv = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_selective_slg_b_mod_takagi_prior.csv\"\n",
    "\n",
    "df = pd.read_csv(in_csv)\n",
    "\n",
    "line_col = \"y_fault_line\"\n",
    "case_col = \"case\"\n",
    "\n",
    "# Preserve original/default prior from raw physics script\n",
    "df[\"d_phys_real_pct_original\"] = df[\"d_phys_real_pct\"]\n",
    "df[\"d_phys_real_pct_before_selective_slg_b\"] = df[\"d_phys_real_pct\"]\n",
    "\n",
    "# Start from old/default prior\n",
    "df[\"d_phys_real_pct\"] = df[\"d_phys_real_pct_original\"]\n",
    "df[\"d_phys_real_strategy\"] = \"old_default\"\n",
    "\n",
    "main12_lines = [\"MainLn1-2A\", \"MainLn1-2B\"]\n",
    "main23_lines = [\"MainLn2-3A\", \"MainLn2-3B\"]\n",
    "\n",
    "takagi_cases = [\n",
    "    \"3ph\",\n",
    "    \"ll_ab\", \"ll_bc\", \"ll_ca\",\n",
    "    \"llg_ab\", \"llg_bc\", \"llg_ca\",\n",
    "]\n",
    "\n",
    "# Keep existing old best rule for 3ph / LL / LLG\n",
    "# MainLn1-2A/B -> Takagi local\n",
    "mask_main12 = df[line_col].isin(main12_lines) & df[case_col].isin(takagi_cases)\n",
    "df.loc[mask_main12, \"d_phys_real_pct\"] = df.loc[mask_main12, \"d_takagi_local_pct\"]\n",
    "df.loc[mask_main12, \"d_phys_real_strategy\"] = \"takagi_local_main12_3ph_ll_llg\"\n",
    "\n",
    "# MainLn2-3A/B -> Takagi remote flipped\n",
    "mask_main23 = df[line_col].isin(main23_lines) & df[case_col].isin(takagi_cases)\n",
    "df.loc[mask_main23, \"d_phys_real_pct\"] = df.loc[mask_main23, \"d_takagi_remote_flipped_pct\"]\n",
    "df.loc[mask_main23, \"d_phys_real_strategy\"] = \"takagi_remote_flipped_main23_3ph_ll_llg\"\n",
    "\n",
    "# Old best SLG rule:\n",
    "# slg_a -> old default\n",
    "mask_slg_a = df[case_col].eq(\"slg_a\")\n",
    "df.loc[mask_slg_a, \"d_phys_real_pct\"] = df.loc[mask_slg_a, \"d_phys_real_pct_original\"]\n",
    "df.loc[mask_slg_a, \"d_phys_real_strategy\"] = \"old_default_slg_a\"\n",
    "\n",
    "# slg_c -> old both_mean rule\n",
    "mask_slg_c = df[case_col].eq(\"slg_c\")\n",
    "df.loc[mask_slg_c, \"d_phys_real_pct\"] = df.loc[mask_slg_c, \"d_takagi_both_mean_pct\"]\n",
    "df.loc[mask_slg_c, \"d_phys_real_strategy\"] = \"takagi_both_mean_slg_c\"\n",
    "\n",
    "# NEW selective rule:\n",
    "# only slg_b -> modified Takagi transformer-only both mean\n",
    "mask_slg_b = df[case_col].eq(\"slg_b\")\n",
    "df.loc[mask_slg_b, \"d_phys_real_pct\"] = df.loc[\n",
    "    mask_slg_b, \"d_mod_takagi_tf_only_p_both_mean_pct\"\n",
    "]\n",
    "df.loc[mask_slg_b, \"d_phys_real_strategy\"] = \"mod_takagi_tf_only_p_both_mean_slg_b\"\n",
    "\n",
    "# Safety checks\n",
    "if df[\"d_phys_real_pct\"].isna().sum() > 0:\n",
    "    bad = df[df[\"d_phys_real_pct\"].isna()][\n",
    "        [\"sample_id\", \"window_idx\", \"y_fault_line\", \"case\", \"d_phys_real_strategy\"]\n",
    "    ].head(20)\n",
    "    display(bad)\n",
    "    raise ValueError(\"NaNs found in selected prior d_phys_real_pct\")\n",
    "\n",
    "# Optional filled feature if you want to pass modified Takagi as feature later\n",
    "mod_col = \"d_mod_takagi_tf_only_p_both_mean_pct\"\n",
    "df[f\"{mod_col}_filled\"] = df[mod_col].fillna(df[\"d_phys_real_pct\"])\n",
    "df[\"is_mod_takagi_tf_only_available\"] = df[mod_col].notna().astype(int)\n",
    "\n",
    "# Error column\n",
    "df[\"selective_slg_b_abs_err\"] = (\n",
    "    df[\"y_fault_location\"] - df[\"d_phys_real_pct\"]\n",
    ").abs()\n",
    "\n",
    "print(\"Strategy counts:\")\n",
    "print(df[\"d_phys_real_strategy\"].value_counts())\n",
    "\n",
    "print(\"\\nLine-wise selected prior MAE:\")\n",
    "line_mae = (\n",
    "    df.groupby(line_col)\n",
    "      .apply(lambda g: (g[\"y_fault_location\"] - g[\"d_phys_real_pct\"]).abs().mean())\n",
    "      .rename(\"prior_mae\")\n",
    "      .reset_index()\n",
    ")\n",
    "display(line_mae.round(4))\n",
    "\n",
    "print(\"\\nMainLn1-2A case-wise selected prior MAE:\")\n",
    "case_mae = (\n",
    "    df[df[line_col] == \"MainLn1-2A\"]\n",
    "    .groupby([line_col, case_col, \"d_phys_real_strategy\"])\n",
    "    .agg(\n",
    "        n=(case_col, \"size\"),\n",
    "        mae=(\"selective_slg_b_abs_err\", \"mean\"),\n",
    "    )\n",
    "    .reset_index()\n",
    "    .sort_values([line_col, case_col])\n",
    ")\n",
    "display(case_mae.round(4))\n",
    "\n",
    "df.to_csv(out_csv, index=False)\n",
    "print(\"Saved:\", out_csv)"
   ]
  },
