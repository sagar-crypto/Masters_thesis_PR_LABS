    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "in_csv = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_both_all_fault_start_mod_takagi_tf_only.csv\"\n",
    "\n",
    "out_csv = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_line_caseaware_mod_takagi_tf_only_prior.csv\"\n",
    "\n",
    "df = pd.read_csv(in_csv)\n",
    "\n",
    "line_col = \"y_fault_line\"\n",
    "case_col = \"case\"\n",
    "\n",
    "# Preserve original/default prior\n",
    "df[\"d_phys_real_pct_original\"] = df[\"d_phys_real_pct\"]\n",
    "df[\"d_phys_real_pct_before_mod_takagi_caseaware\"] = df[\"d_phys_real_pct\"]\n",
    "\n",
    "# Start from old/default prior\n",
    "df[\"d_phys_real_pct\"] = df[\"d_phys_real_pct_original\"]\n",
    "df[\"d_phys_real_strategy\"] = \"old_default\"\n",
    "\n",
    "main12_lines = [\"MainLn1-2A\", \"MainLn1-2B\"]\n",
    "main23_lines = [\"MainLn2-3A\", \"MainLn2-3B\"]\n",
    "\n",
    "takagi_cases = [\n",
    "    \"3ph\",\n",
    "    \"ll_ab\", \"ll_bc\", \"ll_ca\",\n",
    "    \"llg_ab\", \"llg_bc\", \"llg_ca\",\n",
    "]\n",
    "\n",
    "# Existing best rule for 3ph / LL / LLG\n",
    "mask_main12 = df[line_col].isin(main12_lines) & df[case_col].isin(takagi_cases)\n",
    "df.loc[mask_main12, \"d_phys_real_pct\"] = df.loc[mask_main12, \"d_takagi_local_pct\"]\n",
    "df.loc[mask_main12, \"d_phys_real_strategy\"] = \"takagi_local_main12_3ph_ll_llg\"\n",
    "\n",
    "mask_main23 = df[line_col].isin(main23_lines) & df[case_col].isin(takagi_cases)\n",
    "df.loc[mask_main23, \"d_phys_real_pct\"] = df.loc[mask_main23, \"d_takagi_remote_flipped_pct\"]\n",
    "df.loc[mask_main23, \"d_phys_real_strategy\"] = \"takagi_remote_flipped_main23_3ph_ll_llg\"\n",
    "\n",
    "# New SLG rule from ablation:\n",
    "# slg_b and slg_c -> modified Takagi transformer-only both mean\n",
    "mask_slg_bc = df[case_col].isin([\"slg_b\", \"slg_c\"])\n",
    "df.loc[mask_slg_bc, \"d_phys_real_pct\"] = df.loc[\n",
    "    mask_slg_bc, \"d_mod_takagi_tf_only_p_both_mean_pct\"\n",
    "]\n",
    "df.loc[mask_slg_bc, \"d_phys_real_strategy\"] = \"mod_takagi_tf_only_p_both_mean_slg_b_c\"\n",
    "\n",
    "# slg_a: only MainLn1-2A improved with modified candidate.\n",
    "# Other lines keep old/default prior.\n",
    "mask_slg_a_main12a = (df[line_col] == \"MainLn1-2A\") & (df[case_col] == \"slg_a\")\n",
    "df.loc[mask_slg_a_main12a, \"d_phys_real_pct\"] = df.loc[\n",
    "    mask_slg_a_main12a, \"d_mod_takagi_tf_only_p_both_mean_pct\"\n",
    "]\n",
    "df.loc[mask_slg_a_main12a, \"d_phys_real_strategy\"] = \"mod_takagi_tf_only_p_both_mean_slg_a_1_2A\"\n",
    "\n",
    "mask_slg_a_other = (df[case_col] == \"slg_a\") & ~mask_slg_a_main12a\n",
    "df.loc[mask_slg_a_other, \"d_phys_real_pct\"] = df.loc[\n",
    "    mask_slg_a_other, \"d_phys_real_pct_original\"\n",
    "]\n",
    "df.loc[mask_slg_a_other, \"d_phys_real_strategy\"] = \"old_default_slg_a\"\n",
    "\n",
    "df[\"mod_caseaware_abs_err\"] = (\n",
    "    df[\"y_fault_location\"] - df[\"d_phys_real_pct\"]\n",
    ").abs()\n",
    "\n",
    "print(\"Strategy counts:\")\n",
    "print(df[\"d_phys_real_strategy\"].value_counts())\n",
    "\n",
    "print(\"\\nLine-wise selected prior MAE:\")\n",
    "line_mae = (\n",
    "    df.groupby(line_col)\n",
    "      .apply(lambda g: (g[\"y_fault_location\"] - g[\"d_phys_real_pct\"]).abs().mean())\n",
    "      .rename(\"prior_mae\")\n",
    "      .reset_index()\n",
    ")\n",
    "display(line_mae.round(4))\n",
    "\n",
    "print(\"\\nLine + case selected prior MAE:\")\n",
    "case_mae = (\n",
    "    df.groupby([line_col, case_col])\n",
    "      .agg(\n",
    "          n=(case_col, \"size\"),\n",
    "          strategy=(\"d_phys_real_strategy\", \"first\"),\n",
    "          mae=(\"mod_caseaware_abs_err\", \"mean\"),\n",
    "      )\n",
    "      .reset_index()\n",
    "      .sort_values([line_col, case_col])\n",
    ")\n",
    "display(case_mae.round(4))\n",
    "\n",
    "df.to_csv(out_csv, index=False)\n",
    "print(\"Saved:\", out_csv)"
   ]
  },
