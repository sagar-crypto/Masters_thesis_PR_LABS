    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "operator_csv = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_line_caseaware_mod_takagi_tf_only_prior_filled.csv\"\n",
