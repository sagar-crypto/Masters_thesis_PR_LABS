   "source": [
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "\n",
    "# -------------------------------------------------------------------\n",
    "# Physics operator feature CSV\n",
    "# -------------------------------------------------------------------\n",
    "csv_path = Path(\n",
    "    \"/home/vault/iwi5/iwi5305h/\"\n",
    "    \"kol_operator_features_hv_double_line_110kv_line_caseaware_mod_takagi_tf_only_prior_filled.csv\"\n",
    ")\n",
    "\n",
    "if not csv_path.exists():\n",
    "    raise FileNotFoundError(f\"CSV not found:\\n{csv_path}\")\n",
    "\n",
    "# Read only a few rows first: fast inspection, no heavy memory usage.\n",
    "preview_df = pd.read_csv(csv_path, nrows=10)\n",
    "\n",
    "print(\"=\" * 100)\n",
    "print(\"CSV PATH\")\n",
    "print(csv_path)\n",
    "\n",
    "print(\"\\n\" + \"=\" * 100)\n",
    "print(f\"NUMBER OF COLUMNS: {len(preview_df.columns)}\")\n",
    "\n",
    "print(\"\\n\" + \"=\" * 100)\n",
    "print(\"ALL COLUMN NAMES\")\n",
    "for i, col in enumerate(preview_df.columns, start=1):\n",
    "    print(f\"{i:>3}. {col}\")\n",
    "\n",
    "# -------------------------------------------------------------------\n",
    "# Find columns that are likely useful for physics-distance analysis.\n",
    "# -------------------------------------------------------------------\n",
    "keywords = [\n",
    "    \"sample\",\n",
    "    \"line\",\n",
    "    \"case\",\n",
    "    \"fault\",\n",
    "    \"location\",\n",
    "    \"target\",\n",
    "    \"prior\",\n",
    "    \"takagi\",\n",
    "    \"distance\",\n",
    "    \"d_\",\n",
    "    \"phys\",\n",
    "    \"error\",\n",
    "    \"local\",\n",
    "    \"remote\",\n",
    "    \"both\",\n",
    "]\n",
    "\n",
    "candidate_cols = [\n",
    "    col\n",
    "    for col in preview_df.columns\n",
    "    if any(keyword.lower() in col.lower() for keyword in keywords)\n",
    "]\n",
    "\n",
    "print(\"\\n\" + \"=\" * 100)\n",
    "print(\"POTENTIALLY RELEVANT COLUMNS\")\n",
    "for col in candidate_cols:\n",
    "    print(\"-\", col)\n",
    "\n",
    "print(\"\\n\" + \"=\" * 100)\n",
    "print(\"FIRST 10 ROWS — RELEVANT COLUMNS ONLY\")\n",
    "\n",
    "available_relevant_cols = [\n",
    "    col for col in candidate_cols if col in preview_df.columns\n",
    "]\n",
    "\n",
    "display(preview_df[available_relevant_cols].head(10))\n",
    "\n",
    "print(\"\\n\" + \"=\" * 100)\n",
    "print(\"MISSING VALUES IN PREVIEW — RELEVANT COLUMNS\")\n",
    "\n",
    "missing_summary = (\n",
    "    preview_df[available_relevant_cols]\n",
    "    .isna()\n",
    "    .sum()\n",
    "    .sort_values(ascending=False)\n",
    ")\n",
    "\n",
    "display(missing_summary.to_frame(name=\"missing_count\"))"
   ]
  },
