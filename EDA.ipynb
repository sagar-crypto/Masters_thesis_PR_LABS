    "    experiment_id: str,\n",
    "    category: str,\n",
    "    check_name: str,\n",
    "    observed: Any,\n",
    "    expected: Any,\n",
    "    passed: bool,\n",
    "    mandatory: bool = True,\n",
    "    details: str = \"\",\n",
    ") -> None:\n",
    "    audit_rows.append(\n",
    "        {\n",
    "            \"experiment_id\": experiment_id,\n",
    "            \"category\": category,\n",
    "            \"check_name\": check_name,\n",
    "            \"observed\": json_value(observed),\n",
    "            \"expected\": json_value(expected),\n",
    "            \"passed\": bool(passed),\n",
    "            \"mandatory\": bool(mandatory),\n",
    "            \"severity\": (\n",
    "                \"ERROR\"\n",
    "                if mandatory and not passed\n",
    "                else \"WARNING\"\n",
    "                if not mandatory and not passed\n",
    "                else \"PASS\"\n",
    "            ),\n",
    "            \"details\": details,\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "def normalize_identifier(value: Any) -> str | None:\n",
    "    if pd.isna(value):\n",
    "        return None\n",
    "\n",
    "    if isinstance(value, (int, np.integer)):\n",
    "        return str(int(value))\n",
    "\n",
    "    if isinstance(value, (float, np.floating)):\n",
    "        if np.isfinite(value) and float(value).is_integer():\n",
    "            return str(int(value))\n",
    "\n",
    "    return str(value).strip()\n",
    "\n",
    "\n",
    "def normalize_topology(value: Any) -> str:\n",
    "    token = \"\".join(\n",
    "        character\n",
    "        for character in str(value).lower()\n",
    "        if character.isalnum()\n",
    "    )\n",
    "\n",
    "    if \"110\" in token:\n",
    "        return \"110kv\"\n",
    "\n",
    "    if \"90\" in token:\n",
    "        return \"90kv\"\n",
    "\n",
    "    return token\n",
    "\n",
    "\n",
    "def maximum_absolute_difference(\n",
    "    left: pd.Series,\n",
    "    right: pd.Series,\n",
    ") -> float:\n",
    "    left_numeric = pd.to_numeric(\n",
    "        left,\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    "    right_numeric = pd.to_numeric(\n",
    "        right,\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    "    valid = (\n",
    "        np.isfinite(left_numeric)\n",
    "        & np.isfinite(right_numeric)\n",
    "    )\n",
    "\n",
    "    if not valid.any():\n",
    "        return np.inf\n",
    "\n",
    "    return float(\n",
    "        (\n",
    "            left_numeric[valid]\n",
    "            - right_numeric[valid]\n",
    "        ).abs().max()\n",
    "    )\n",
    "\n",
    "\n",
    "def all_numeric_equal(\n",
    "    left: pd.Series,\n",
    "    right: pd.Series,\n",
    "    tolerance: float = NUMERIC_TOLERANCE,\n",
    ") -> bool:\n",
    "    left_numeric = pd.to_numeric(\n",
    "        left,\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    "    right_numeric = pd.to_numeric(\n",
    "        right,\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "\n",
    "    finite = (\n",
    "        np.isfinite(left_numeric)\n",
    "        & np.isfinite(right_numeric)\n",
    "    )\n",
    "\n",
    "    return bool(\n",
    "        finite.sum() == len(left)\n",
    "        and (\n",
    "            left_numeric[finite]\n",
    "            - right_numeric[finite]\n",
    "        ).abs().le(tolerance).all()\n",
    "    )\n",
    "\n",
    "\n",
    "def all_string_equal(\n",
    "    left: pd.Series,\n",
    "    right: pd.Series,\n",
    ") -> bool:\n",
    "    return bool(\n",
    "        left.fillna(\"<NA>\")\n",
    "        .astype(str)\n",
    "        .eq(\n",
    "            right.fillna(\"<NA>\")\n",
    "            .astype(str)\n",
    "        )\n",
    "        .all()\n",
    "    )\n",
    "\n",
    "\n",
    "def reconstruct_event_table(\n",
    "    window_frame: pd.DataFrame,\n",
    ") -> pd.DataFrame:\n",
    "    frame = window_frame.copy()\n",
    "\n",
    "    frame[\"_sample_key\"] = frame[\n",
    "        \"sample_id\"\n",
    "    ].map(normalize_identifier)\n",
    "\n",
    "    grouped = frame.groupby(\n",
    "        \"_sample_key\",\n",
    "        sort=False,\n",
    "        dropna=False,\n",
    "    )\n",
    "\n",
    "    reconstructed = grouped.agg(\n",
    "        sample_id=(\"sample_id\", \"first\"),\n",
    "        y_true_pp=(\"y_true_pp\", \"first\"),\n",
    "        y_pred_pp=(\"y_pred_pp\", \"mean\"),\n",
    "        prior_pp=(\"prior_pp\", \"mean\"),\n",
    "        fold=(\"fold\", \"first\"),\n",
    "        window_rows=(\"sample_id\", \"size\"),\n",
    "        case=(\"case\", \"first\"),\n",
    "        y_fault_line=(\"y_fault_line\", \"first\"),\n",
    "        event_type=(\"event_type\", \"first\"),\n",
    "        topology=(\"topology\", \"first\"),\n",
    "        target_min_pp=(\"y_true_pp\", \"min\"),\n",
    "        target_max_pp=(\"y_true_pp\", \"max\"),\n",
    "        fold_count=(\"fold\", \"nunique\"),\n",
    "        case_count=(\"case\", \"nunique\"),\n",
    "        line_count=(\"y_fault_line\", \"nunique\"),\n",
    "        event_type_count=(\"event_type\", \"nunique\"),\n",
    "    ).reset_index()\n",
    "\n",
    "    reconstructed[\n",
    "        \"target_spread_pp\"\n",
    "    ] = (\n",
    "        reconstructed[\"target_max_pp\"]\n",
    "        - reconstructed[\"target_min_pp\"]\n",
    "    )\n",
    "\n",
    "    reconstructed[\n",
    "        \"model_abs_error_pp\"\n",
    "    ] = (\n",
    "        reconstructed[\"y_pred_pp\"]\n",
    "        - reconstructed[\"y_true_pp\"]\n",
    "    ).abs()\n",
    "\n",
    "    reconstructed[\n",
    "        \"prior_abs_error_pp\"\n",
    "    ] = (\n",
    "        reconstructed[\"prior_pp\"]\n",
    "        - reconstructed[\"y_true_pp\"]\n",
    "    ).abs()\n",
    "\n",
    "    return reconstructed"
   ]
