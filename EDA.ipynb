    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "path = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_both_all_fault_start_i0res_seq_bothfix.csv\"\n",
    "df = pd.read_csv(path)\n",
    "df = df[df[\"y_fault_line\"].astype(str) == \"MainLn1-2A\"].copy()\n",
    "\n",
    "cols = [\n",
    "    \"d_phys_real_pct\",\n",
    "    \"d_takagi_local_pct\",\n",
    "    \"d_takagi_remote_flipped_pct\",\n",
    "    \"d_takagi_both_mean_pct\",\n",
    "]\n",
    "\n",
    "for col in cols:\n",
    "    if col in df.columns:\n",
    "        err = df[col] - df[\"y_fault_location\"]\n",
    "        print(\n",
    "            col,\n",
    "            \"| MAE:\", np.nanmean(np.abs(err)),\n",
    "            \"| RMSE:\", np.sqrt(np.nanmean(err ** 2)),\n",
    "            \"| Bias:\", np.nanmean(err),\n",
    "            \"| NaN%:\", df[col].isna().mean() * 100,\n",
    "            \"| <=0%:\", np.nanmean(df[col] <= 0) * 100,\n",
    "            \"| >=100%:\", np.nanmean(df[col] >= 100) * 100,\n",
    "        )\n",
    "\n",
    "print(\"\\nBy case: d_takagi_both_mean_pct\")\n",
    "if \"d_takagi_both_mean_pct\" in df.columns:\n",
    "    tmp = df.copy()\n",
    "    tmp[\"takagi_err\"] = tmp[\"d_takagi_both_mean_pct\"] - tmp[\"y_fault_location\"]\n",
    "    tmp[\"takagi_abs_err\"] = tmp[\"takagi_err\"].abs()\n",
    "    display(\n",
    "        tmp.groupby(\"case\", as_index=False)\n",
    "        .agg(\n",
    "            n=(\"sample_id\", \"count\"),\n",
    "            mae_pp=(\"takagi_abs_err\", \"mean\"),\n",
    "            rmse_pp=(\"takagi_err\", lambda x: np.sqrt(np.nanmean(np.square(x)))),\n",
    "            bias_pp=(\"takagi_err\", \"mean\"),\n",
    "            nan_pct=(\"d_takagi_both_mean_pct\", lambda x: x.isna().mean() * 100),\n",
    "        )\n",
    "        .sort_values(\"mae_pp\", ascending=False)\n",
    "    )\n",
    "\n",
    "print(\"\\nTakagi local reasons:\")\n",
    "if \"takagi_reason_local\" in df.columns:\n",
    "    print(df[\"takagi_reason_local\"].value_counts(dropna=False).head(20))\n",
    "\n",
    "print(\"\\nTakagi remote reasons:\")\n",
    "if \"takagi_reason_remote\" in df.columns:\n",
    "    print(df[\"takagi_reason_remote\"].value_counts(dropna=False).head(20))"
   ]
  },
