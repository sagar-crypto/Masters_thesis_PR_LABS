   "source": [
    "ABSOLUTE_PATH_PATTERN = re.compile(\n",
    "    r\"\"\"\n",
    "    (?P<path>\n",
    "        /\n",
    "        [^\\s\"'<>]+\n",
    "    )\n",
    "    \"\"\",\n",
    "    flags=re.VERBOSE,\n",
    ")\n",
    "\n",
    "\n",
    "def clean_extracted_path(value: str) -> str:\n",
    "    cleaned = value.strip()\n",
    "\n",
    "    # Remove common trailing punctuation left by logs or Markdown.\n",
    "    cleaned = cleaned.rstrip(\n",
    "        \".,;:)]}>`\"\n",
    "    )\n",
    "\n",
    "    # Remove opening wrappers when captured.\n",
    "    cleaned = cleaned.lstrip(\n",
    "        \"([{<`\"\n",
    "    )\n",
    "\n",
    "    return cleaned\n",
    "\n",
    "\n",
    "def read_text_safely(path: Path) -> str | None:\n",
    "    try:\n",
    "        if path.stat().st_size > MAX_TEXT_SCAN_BYTES:\n",
    "            return None\n",
    "\n",
    "        return path.read_text(\n",
    "            encoding=\"utf-8\",\n",
    "            errors=\"replace\",\n",
    "        )\n",
    "\n",
    "    except (OSError, UnicodeError):\n",
    "        return None\n",
    "\n",
    "\n",
    "# Scan only text/configuration artifacts under the two completed run roots.\n",
    "text_scan_paths = []\n",
    "\n",
    "for path_string in artifact_inventory.loc[\n",
    "    artifact_inventory[\"suffix\"].isin(TEXT_SUFFIXES),\n",
    "    \"path\",\n",
    "]:\n",
    "    path = Path(path_string)\n",
    "\n",
    "    if (\n",
    "        SINGLE_RUN_ROOT in path.parents\n",
    "        or DOUBLE_RUN_ROOT in path.parents\n",
    "    ):\n",
    "        text_scan_paths.append(path)\n",
    "\n",
    "\n",
    "path_reference_rows: list[dict[str, Any]] = []\n",
    "\n",
    "for source_path in sorted(set(text_scan_paths)):\n",
    "    text = read_text_safely(source_path)\n",
    "\n",
    "    if text is None:\n",
    "        continue\n",
    "\n",
    "    for match in ABSOLUTE_PATH_PATTERN.finditer(text):\n",
    "        raw_reference = match.group(\"path\")\n",
    "        cleaned_reference = clean_extracted_path(raw_reference)\n",
    "\n",
    "        referenced_path = Path(cleaned_reference)\n",
    "\n",
    "        # We are interested in data/configuration artifacts and directories.\n",
    "        suffix = referenced_path.suffix.lower()\n",
    "\n",
    "        looks_relevant = (\n",
    "            suffix in INVENTORY_SUFFIXES\n",
    "            or suffix in {\".npz\", \".npy\", \".pt\", \".pth\", \".ckpt\"}\n",
    "            or \"model_input\" in normalize_name(cleaned_reference)\n",
    "            or \"window\" in normalize_name(cleaned_reference)\n",
    "            or \"physics\" in normalize_name(cleaned_reference)\n",
    "            or \"prior\" in normalize_name(cleaned_reference)\n",
    "        )\n",
    "\n",
    "        if not looks_relevant:\n",
    "            continue\n",
    "\n",
    "        path_reference_rows.append(\n",
    "            {\n",
    "                \"source_path\": str(source_path),\n",
    "                \"referenced_path\": cleaned_reference,\n",
    "                \"exists\": referenced_path.exists(),\n",
    "                \"is_file\": referenced_path.is_file(),\n",
    "                \"is_directory\": referenced_path.is_dir(),\n",
    "                \"suffix\": suffix,\n",
    "                \"experiment_tokens_in_reference\": \"|\".join(\n",
    "                    experiments_in_path(referenced_path)\n",
    "                ),\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "path_references = pd.DataFrame(path_reference_rows)\n",
    "\n",
    "if path_references.empty:\n",
    "    path_references = pd.DataFrame(\n",
    "        columns=[\n",
    "            \"source_path\",\n",
    "            \"referenced_path\",\n",
    "            \"exists\",\n",
    "            \"is_file\",\n",
    "            \"is_directory\",\n",
    "            \"suffix\",\n",
    "            \"experiment_tokens_in_reference\",\n",
    "        ]\n",
    "    )\n",
    "else:\n",
    "    path_references = (\n",
    "        path_references\n",
    "        .drop_duplicates()\n",
    "        .sort_values(\n",
    "            [\"exists\", \"referenced_path\", \"source_path\"],\n",
    "            ascending=[False, True, True],\n",
    "            kind=\"stable\",\n",
    "        )\n",
    "        .reset_index(drop=True)\n",
    "    )\n",
    "\n",
    "path_reference_output = (\n",
    "    FINAL_DIR / \"artifact_path_references.csv\"\n",
    ")\n",
    "\n",
    "path_references.to_csv(\n",
    "    path_reference_output,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "print(\"Saved:\", path_reference_output)\n",
    "print(\n",
    "    \"Discovered path references:\",\n",
    "    len(path_references),\n",
    ")\n",
    "print(\n",
    "    \"Existing path references:\",\n",
    "    int(path_references[\"exists\"].sum())\n",
    "    if not path_references.empty\n",
    "    else 0,\n",
    ")\n",
    "\n",
    "display(\n",
    "    path_references.loc[\n",
    "        path_references[\"exists\"] == True  # noqa: E712\n",
    "    ].head(100)\n",
    ")"
   ]
  },
