   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from pathlib import Path\n",
    "\n",
    "physics_csv = Path(\n",
    "    \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_both_all_fault_start_i0res_seq_bothfix.csv\"\n",
    ")\n",
    "\n",
    "df = pd.read_csv(physics_csv)\n",
    "\n",
    "required_cols = [\n",
    "    \"sample_id\",\n",
    "    \"window_idx\",\n",
    "    \"y_fault_line\",\n",
    "    \"y_fault_location\",\n",
    "    \"case\",\n",
    "    \"d_phys_real_pct\",\n",
    "]\n",
    "\n",
    "missing = [c for c in required_cols if c not in df.columns]\n",
    "if missing:\n",
    "    raise ValueError(f\"Missing columns in physics CSV: {missing}\")\n",
    "\n",
    "# optional: focus only on the current 110 kV line\n",
    "line_filter = \"MainLn1-2A\"\n",
    "df_line = df[df[\"y_fault_line\"].astype(str) == line_filter].copy()\n",
    "\n",
    "df_line[\"prior_err_pp\"] = df_line[\"d_phys_real_pct\"] - df_line[\"y_fault_location\"]\n",
    "df_line[\"prior_abs_err_pp\"] = df_line[\"prior_err_pp\"].abs()\n",
    "\n",
    "summary_by_window = (\n",
    "    df_line\n",
    "    .groupby(\"window_idx\", as_index=False)\n",
    "    .agg(\n",
    "        n=(\"sample_id\", \"count\"),\n",
    "        unique_samples=(\"sample_id\", \"nunique\"),\n",
    "        prior_mae_pp=(\"prior_abs_err_pp\", \"mean\"),\n",
    "        prior_rmse_pp=(\"prior_err_pp\", lambda x: float(np.sqrt(np.mean(np.square(x))))),\n",
    "        prior_bias_pp=(\"prior_err_pp\", \"mean\"),\n",
    "        median_abs_err_pp=(\"prior_abs_err_pp\", \"median\"),\n",
    "        p90_abs_err_pp=(\"prior_abs_err_pp\", lambda x: float(np.percentile(x, 90))),\n",
    "    )\n",
    "    .sort_values(\"prior_mae_pp\")\n",
    ")\n",
    "\n",
    "print(\"Prior quality by window_idx:\")\n",
    "display(summary_by_window)\n",
    "\n",
    "print(\"\\nBest window indices by prior MAE:\")\n",
    "display(summary_by_window.head(10))\n",
    "\n",
    "print(\"\\nWorst window indices by prior MAE:\")\n",
    "display(summary_by_window.tail(10))"
   ]
  },
