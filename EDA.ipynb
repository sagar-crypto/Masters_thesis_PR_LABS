    "remaining_rows = []\n",
    "\n",
    "\n",
    "for experiment_id, experiment_info in EXPERIMENTS.items():\n",
    "    entry = manifest[\"experiments\"][experiment_id]\n",
    "\n",
    "    prediction_path = entry.get(\n",
    "        \"selected_prediction_artifact\"\n",
    "    )\n",
    "\n",
    "    prediction_status = entry.get(\n",
    "        \"prediction_selection_status\"\n",
    "    )\n",
    "\n",
    "    matched_prior = entry.get(\n",
    "        \"matched_prior\",\n",
    "        {},\n",
    "    )\n",
    "\n",
    "    if prediction_path is None:\n",
    "        remaining_rows.append(\n",
    "            {\n",
    "                \"experiment_id\": experiment_id,\n",
    "                \"mapping_type\": \"prediction_artifact\",\n",
    "                \"status\": prediction_status,\n",
    "                \"details\": (\n",
    "                    \"A unique prediction artifact could not \"\n",
    "                    \"be established from direct evidence.\"\n",
    "                ),\n",
    "            }\n",
    "        )\n",
    "\n",
    "    if matched_prior.get(\"source_path\") is None:\n",
    "        remaining_rows.append(\n",
    "            {\n",
    "                \"experiment_id\": experiment_id,\n",
    "                \"mapping_type\": \"matched_prior\",\n",
    "                \"status\": matched_prior.get(\n",
    "                    \"status\",\n",
    "                    \"unresolved\",\n",
    "                ),\n",
    "                \"details\": (\n",
    "                    \"The exact prepared prior supplied to the \"\n",
    "                    \"model could not be uniquely established.\"\n",
    "                ),\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "remaining_unresolved = pd.DataFrame(\n",
    "    remaining_rows,\n",
    "    columns=[\n",
    "        \"experiment_id\",\n",
    "        \"mapping_type\",\n",
    "        \"status\",\n",
    "        \"details\",\n",
    "    ],\n",
    ")\n",
    "\n",
    "remaining_unresolved.to_csv(\n",
    "    REMAINING_UNRESOLVED_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "print(\"Saved:\", REMAINING_UNRESOLVED_PATH)\n",
    "print(\n",
    "    \"Remaining unresolved mappings:\",\n",
    "    len(remaining_unresolved),\n",
    ")\n",
    "\n",
    "display(remaining_unresolved)"
