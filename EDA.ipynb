   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "case_col = \"case\"\n",
    "n_col = \"support\"\n",
    "mae_col = \"mae_pp\"\n",
    "rmse_col = \"rmse_pp\"\n",
    "bias_col = \"bias_pp\"\n",
    "\n",
    "def summarize_case_metrics(df: pd.DataFrame, tag: str) -> pd.DataFrame:\n",
    "    rows = []\n",
    "\n",
    "    for case, g in df.groupby(case_col):\n",
    "        weights = g[n_col].astype(float).to_numpy()\n",
    "\n",
    "        learned_mae = np.average(g[mae_col], weights=weights)\n",
    "        learned_rmse = np.average(g[rmse_col], weights=weights)\n",
    "        learned_bias = np.average(g[bias_col], weights=weights)\n",
    "        n_total = g[n_col].sum()\n",
    "\n",
    "        rows.append({\n",
    "            \"case\": case,\n",
    "            f\"{tag}_support\": n_total,\n",
    "            f\"{tag}_mae_pp\": learned_mae,\n",
    "            f\"{tag}_rmse_pp\": learned_rmse,\n",
    "            f\"{tag}_bias_pp\": learned_bias,\n",
    "        })\n",
    "\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "old_case = summarize_case_metrics(old_case_raw, \"old\")\n",
    "new_case = summarize_case_metrics(new_case_raw, \"new\")\n",
    "\n",
    "cmp = old_case.merge(new_case, on=\"case\", how=\"outer\")\n",
    "\n",
    "cmp[\"mae_delta_new_minus_old_pp\"] = cmp[\"new_mae_pp\"] - cmp[\"old_mae_pp\"]\n",
    "cmp[\"rmse_delta_new_minus_old_pp\"] = cmp[\"new_rmse_pp\"] - cmp[\"old_rmse_pp\"]\n",
    "cmp[\"bias_delta_new_minus_old_pp\"] = cmp[\"new_bias_pp\"] - cmp[\"old_bias_pp\"]\n",
    "\n",
    "cmp[\"mae_change\"] = np.where(\n",
    "    cmp[\"mae_delta_new_minus_old_pp\"] < 0,\n",
    "    \"improved\",\n",
    "    \"worse\"\n",
    ")\n",
    "\n",
    "cmp = cmp.sort_values(\"mae_delta_new_minus_old_pp\")\n",
    "\n",
    "display(cmp.round(3))"
   ]
  },
