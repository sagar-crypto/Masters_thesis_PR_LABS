   "source": [
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "base_dir = Path(\"/home/vault/iwi5/iwi5305h\")\n",
    "\n",
    "files = {\n",
    "    \"clip_each_side\": base_dir / (\n",
    "        \"kol_operator_features_hv_double_line_110kv_\"\n",
    "        \"both_all_fault_start_mod_takagi_seeded_standard_takagi.csv\"\n",
    "    ),\n",
    "    \"raw_fuse_then_clip\": base_dir / (\n",
    "        \"kol_operator_features_hv_double_line_110kv_\"\n",
    "        \"both_all_fault_start_mod_takagi_seeded_raw_fuse_then_clip.csv\"\n",
    "    ),\n",
    "}\n",
    "\n",
    "target_col = \"y_fault_location\"\n",
    "pred_col = \"d_mod_takagi_tf_only_p_both_mean_pct\"\n",
    "\n",
    "results = []\n",
    "case_results = []\n",
    "\n",
    "for name, path in files.items():\n",
    "    df = pd.read_csv(path, low_memory=False)\n",
    "\n",
    "    # One representative fault-start window per sample.\n",
    "    eval_df = (\n",
    "        df.loc[df[\"status\"].eq(\"fault_start\")]\n",
    "        .sort_values([\"sample_id\", \"window_idx\"])\n",
    "        .drop_duplicates(subset=[\"sample_id\"], keep=\"first\")\n",
    "    )\n",
    "\n",
    "    # Modified Takagi applies only to SLG cases.\n",
    "    eval_df = eval_df.loc[\n",
    "        eval_df[\"case\"].isin([\"slg_a\", \"slg_b\", \"slg_c\"])\n",
    "    ].copy()\n",
    "\n",
    "    eval_df[pred_col] = pd.to_numeric(eval_df[pred_col], errors=\"coerce\")\n",
    "    eval_df = eval_df.dropna(subset=[pred_col])\n",
    "\n",
    "    eval_df[\"abs_error_pp\"] = (\n",
    "        eval_df[pred_col] - eval_df[target_col]\n",
    "    ).abs()\n",
    "\n",
    "    results.append(\n",
    "        {\n",
    "            \"version\": name,\n",
    "            \"n\": len(eval_df),\n",
    "            \"slg_mae_pp\": eval_df[\"abs_error_pp\"].mean(),\n",
    "            \"slg_median_pp\": eval_df[\"abs_error_pp\"].median(),\n",
    "            \"slg_p90_pp\": eval_df[\"abs_error_pp\"].quantile(0.90),\n",
    "            \"exact_50_count\": np.isclose(eval_df[pred_col], 50.0).sum(),\n",
    "            \"exact_50_pct\": 100 * np.isclose(eval_df[pred_col], 50.0).mean(),\n",
    "        }\n",
    "    )\n",
    "\n",
    "    by_case = (\n",
    "        eval_df.groupby(\"case\")[\"abs_error_pp\"]\n",
    "        .agg(\n",
    "            n=\"size\",\n",
    "            mae_pp=\"mean\",\n",
    "            median_pp=\"median\",\n",
    "            p90_pp=lambda x: x.quantile(0.90),\n",
    "        )\n",
    "        .reset_index()\n",
    "    )\n",
    "    by_case.insert(0, \"version\", name)\n",
    "    case_results.append(by_case)\n",
    "\n",
    "print(\"Overall SLG comparison\")\n",
    "display(pd.DataFrame(results).set_index(\"version\").round(3))\n",
    "\n",
    "print(\"\\nSLG results by fault type\")\n",
    "display(\n",
    "    pd.concat(case_results, ignore_index=True)\n",
    "    .sort_values([\"case\", \"version\"])\n",
    "    .round(3)\n",
    ")"
   ]
  },
