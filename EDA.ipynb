    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from pathlib import Path\n",
    "\n",
    "labels_path_110 = \"/home/vault/iwi5/iwi5305h/hv_double_line_110kv/labels/settings.csv\"   # change this\n",
    "df110 = pd.read_csv(labels_path_110)\n",
    "\n",
    "print(df110.shape)\n",
    "print(df110.columns.tolist())\n",
    "df110.head()\n",
    "\n",
    "display(\n",
    "    df110[\n",
    "        [\n",
    "            \"events/event_type\",\n",
    "            \"events/event_phase_select_1ph\",\n",
    "            \"events/event_phase_select_2ph\",\n",
    "            \"events/event_flt_target_line_location\",\n",
    "        ]\n",
    "    ].head(20)\n",
    ")"
   ]
