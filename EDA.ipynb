    "        \"Run the file-inspection cell above and check the actual filenames.\"\n",
    "    )\n",
    "\n",
    "rows = []\n",
    "for p in pred_files:\n",
    "    if p.suffix == \".parquet\":\n",
    "        dfp = pd.read_parquet(p)\n",
    "    else:\n",
    "        dfp = pd.read_csv(p)\n",
    "\n",
    "    m = re.search(r\"fold(\\d+)\", p.name)\n",
    "    dfp[\"fold\"] = int(m.group(1)) if m else -1\n",
    "    rows.append(dfp)\n",
    "\n",
    "preds = pd.concat(rows, ignore_index=True)\n",
    "\n",
    "ops = pd.read_csv(ops_path)\n",
    "\n",
    "merge_keys = [\"sample_id\"]\n",
    "if \"window_idx\" in preds.columns and \"window_idx\" in ops.columns:\n",
    "    merge_keys = [\"sample_id\", \"window_idx\"]\n",
    "\n",
    "keep_cols = merge_keys + [\n",
    "    \"case\",\n",
    "    \"y_fault_location\",\n",
    "    \"d_phys_real_pct\",\n",
    "    \"d_both_diff_real_pct\",\n",
    "    \"d_local_real_pct\",\n",
    "    \"d_remote_real_flipped_pct\",\n",
    "]\n",
    "keep_cols = [c for c in keep_cols if c in ops.columns]\n",
    "\n",
    "df = preds.merge(\n",
    "    ops[keep_cols],\n",
    "    on=merge_keys,\n",
    "    how=\"left\",\n",
    ")\n",
    "\n",
    "df[\"true_pct\"] = df[\"y_true\"] * 100.0\n",
    "df[\"pred_pct\"] = df[\"y_pred\"] * 100.0\n",
    "df[\"prior_pct\"] = df[\"d_phys_real_pct\"]\n",
    "\n",
    "df[\"prior_err_pp\"] = df[\"prior_pct\"] - df[\"true_pct\"]\n",
    "df[\"pred_err_pp\"] = df[\"pred_pct\"] - df[\"true_pct\"]\n",
    "df[\"prior_abs_err_pp\"] = df[\"prior_err_pp\"].abs()\n",
    "df[\"pred_abs_err_pp\"] = df[\"pred_err_pp\"].abs()\n",
    "df[\"gain_pp\"] = df[\"prior_abs_err_pp\"] - df[\"pred_abs_err_pp\"]\n",
    "\n",
    "summary = (\n",
    "    df.groupby([\"case\", \"true_pct\"], as_index=False)\n",
    "    .agg(\n",
    "        n=(\"sample_id\", \"count\"),\n",
    "        prior_mae=(\"prior_abs_err_pp\", \"mean\"),\n",
    "        pred_mae=(\"pred_abs_err_pp\", \"mean\"),\n",
