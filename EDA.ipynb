    "edge_rows = []\n",
    "\n",
    "for u, v, key, attr in G.edges(keys=True, data=True):\n",
    "    pdict = attr.get(f\"{key}_param_dict\", {})\n",
    "    \n",
    "    if \"rline\" in pdict:\n",
    "        edge_type = \"line\"\n",
    "    elif \"uktr\" in pdict or \"uk0tr\" in pdict:\n",
    "        edge_type = \"transformer\"\n",
    "    else:\n",
    "        edge_type = \"other\"\n",
    "    \n",
    "    edge_rows.append({\n",
    "        \"edge\": key,\n",
    "        \"u\": u,\n",
    "        \"v\": v,\n",
    "        \"type\": edge_type,\n",
    "        \"param_keys\": list(pdict.keys()),\n",
    "        \"length\": pdict.get(\"length\", np.nan),\n",
    "        \"rline\": pdict.get(\"rline\", np.nan),\n",
    "        \"xline\": pdict.get(\"xline\", np.nan),\n",
    "        \"rline0\": pdict.get(\"rline0\", np.nan),\n",
    "        \"xline0\": pdict.get(\"xline0\", np.nan),\n",
    "        \"strn\": pdict.get(\"strn\", np.nan),\n",
    "        \"uktr\": pdict.get(\"uktr\", np.nan),\n",
    "        \"uktrr\": pdict.get(\"uktrr\", np.nan),\n",
    "        \"uk0tr\": pdict.get(\"uk0tr\", np.nan),\n",
    "        \"ur0tr\": pdict.get(\"ur0tr\", np.nan),\n",
    "    })\n",
    "\n",
    "edge_df = pd.DataFrame(edge_rows)\n",
