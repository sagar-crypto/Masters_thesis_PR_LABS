   "source": [
    "prior_column_rows: list[dict[str, Any]] = []\n",
    "\n",
    "\n",
    "for record in schema_records:\n",
    "    if record.get(\"schema_error\"):\n",
    "        continue\n",
    "\n",
    "    columns = record.get(\"columns\", [])\n",
    "\n",
    "    prior_like_columns = [\n",
    "        column\n",
    "        for column in columns\n",
    "        if any(\n",
    "            keyword in normalize_name(column)\n",
    "            for keyword in [\n",
    "                \"prior\",\n",
    "                \"physics\",\n",
    "                \"takagi\",\n",
    "                \"two_ended\",\n",
    "                \"one_ended\",\n",
    "                \"selected\",\n",
    "                \"input_pct\",\n",
    "                \"kol\",\n",
    "            ]\n",
    "        )\n",
    "    ]\n",
    "\n",
    "    if not prior_like_columns:\n",
    "        continue\n",
    "\n",
    "    prior_resolution = (\n",
    "        record\n",
    "        .get(\"alias_resolution\", {})\n",
    "        .get(\n",
    "            \"y_prior_pct\",\n",
    "            {\n",
    "                \"status\": \"missing\",\n",
    "                \"matches\": [],\n",
    "            },\n",
    "        )\n",
    "    )\n",
    "\n",
    "    prior_column_rows.append(\n",
    "        {\n",
    "            \"path\": record[\"path\"],\n",
    "            \"format\": record.get(\"format\"),\n",
    "            \"row_count\": record.get(\"row_count\"),\n",
    "            \"artifact_roles\": record.get(\n",
    "                \"artifact_roles\"\n",
    "            ),\n",
    "            \"experiment_tokens_in_path\": (\n",
    "                record.get(\n",
    "                    \"experiment_tokens_in_path\"\n",
    "                )\n",
    "            ),\n",
    "            \"prior_alias_status\": (\n",
    "                prior_resolution[\"status\"]\n",
    "            ),\n",
    "            \"resolved_prior_alias_matches\": \"|\".join(\n",
    "                prior_resolution[\"matches\"]\n",
    "            ),\n",
    "            \"all_prior_like_columns\": \"|\".join(\n",
    "                prior_like_columns\n",
    "            ),\n",
    "            \"contains_known_two_ended_prior\": (\n",
    "                KNOWN_TWO_ENDED_PREPARED_PRIOR_COLUMN\n",
    "                in columns\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "prior_column_inventory = pd.DataFrame(\n",
    "    prior_column_rows\n",
    ")\n",
    "\n",
    "prior_column_inventory_path = (\n",
    "    FINAL_DIR / \"candidate_prior_columns.csv\"\n",
    ")\n",
    "\n",
    "prior_column_inventory.to_csv(\n",
    "    prior_column_inventory_path,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "print(\"Saved:\", prior_column_inventory_path)\n",
    "print(\n",
    "    \"Tables containing prior-like columns:\",\n",
    "    len(prior_column_inventory),\n",
    ")\n",
    "\n",
    "display(\n",
    "    prior_column_inventory.sort_values(\n",
    "        [\n",
    "            \"contains_known_two_ended_prior\",\n",
    "            \"path\",\n",
    "        ],\n",
    "        ascending=[False, True],\n",
    "        kind=\"stable\",\n",
    "    ).head(200)\n",
    ")"
   ]
  },
