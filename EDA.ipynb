   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "df = pd.read_csv(\"/home/vault/iwi5/iwi5305h/kol_operator_features_default_i0res.csv\")\n",
    "\n",
    "def metrics(g, pred_col=\"d_phys_real_pct\"):\n",
    "    err = g[pred_col] - g[\"y_fault_location\"]\n",
    "    return pd.Series({\n",
    "        \"n\": len(g),\n",
    "        \"MAE\": np.mean(np.abs(err)),\n",
    "        \"RMSE\": np.sqrt(np.mean(err**2)),\n",
    "        \"Bias\": np.mean(err),\n",
    "    })\n",
    "\n",
    "print(\"=== By case (real) ===\")\n",
    "print(df.groupby(\"case\").apply(metrics, pred_col=\"d_phys_real_pct\").round(4).to_string())\n",
    "\n",
    "print(\"\\n=== By line (real) ===\")\n",
    "print(df.groupby(\"y_fault_line\").apply(metrics, pred_col=\"d_phys_real_pct\").round(4).to_string())\n",
    "\n",
    "print(\"\\n=== By case and line (real) ===\")\n",
    "print(df.groupby([\"case\", \"y_fault_line\"]).apply(metrics, pred_col=\"d_phys_real_pct\").round(4).to_string())"
   ]
  },
