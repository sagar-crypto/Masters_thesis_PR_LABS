    "from pathlib import Path\n",
    "import pandas as pd\n",
    "\n",
    "run_dir = Path(\n",
    "    \"/home/hpc/iwi5/iwi5305h/Masters_thesis_PR_LABS/outputs/MainLn1-2A__kol_operator_features_hv_double_line_110kv_both_i0res_seq_bothfix__ground_only_mul__single_fault_start__run_2026-04-10T21:05:38.350048Z\"\n",
    ")\n",
    "\n",
    "print(\"Top-level contents:\\n\")\n",
    "for p in sorted(run_dir.iterdir()):\n",
    "    print(p.name)\n",
    "\n",
    "print(\"\\nContents inside each fold*_subgroups folder:\\n\")\n",
    "for fold_dir in sorted(run_dir.glob(\"fold*_subgroups\")):\n",
    "    print(f\"\\n--- {fold_dir.name} ---\")\n",
    "    for p in sorted(fold_dir.iterdir()):\n",
    "        print(\" \", p.name)\n",
    "\n",
    "rows = []\n",
    "\n",
    "for fold_dir in sorted(run_dir.glob(\"fold*_subgroups\")):\n",
    "    fold_num = int(fold_dir.name.replace(\"fold\", \"\").replace(\"_subgroups\", \"\"))\n",
    "\n",
    "    candidate_files = [\n",
    "        fold_dir / \"metrics_by_case.csv\",\n",
    "        fold_dir / \"case.csv\",\n",
    "        fold_dir / \"metrics_case.csv\",\n",
    "        fold_dir / \"subgroup_metrics_by_case.csv\",\n",
    "    ]\n",
    "\n",
    "    case_file = next((f for f in candidate_files if f.exists()), None)\n",
    "\n",
    "    if case_file is not None:\n",
    "        df = pd.read_csv(case_file)\n",
    "        df[\"fold\"] = fold_num\n",
    "        df[\"source_file\"] = str(case_file)\n",
    "        rows.append(df)\n",
    "\n",
    "if not rows:\n",
    "    raise FileNotFoundError(\n",
    "        \"No case-level subgroup CSV found inside fold*_subgroups folders. \"\n",
    "        \"Check the printed filenames above and update candidate_files if needed.\"\n",
    "    )\n",
    "\n",
    "case_df = pd.concat(rows, ignore_index=True)\n",
    "\n",
    "print(\"\\nLoaded case-level subgroup files:\")\n",
    "display(case_df.sort_values([\"fold\", \"mae_pp\"], ascending=[True, False]))\n",
    "\n",
    "summary_df = (\n",
    "    case_df.groupby(\"case\", as_index=False)\n",
    "    .agg(\n",
    "        n_folds=(\"fold\", \"nunique\"),\n",
    "        total_support=(\"support\", \"sum\"),\n",
    "        mean_mae_pp=(\"mae_pp\", \"mean\"),\n",
    "        std_mae_pp=(\"mae_pp\", \"std\"),\n",
    "        mean_rmse_pp=(\"rmse_pp\", \"mean\"),\n",
    "        mean_bias_pp=(\"bias_pp\", \"mean\"),\n",
    "    )\n",
    "    .sort_values(\"mean_mae_pp\", ascending=False)\n",
    ")\n",
    "\n",
    "print(\"\\nAverage per-case metrics across folds:\")\n",
    "display(summary_df)\n",
    "\n",
    "pivot_df = case_df.pivot_table(\n",
    "    index=\"fold\",\n",
    "    columns=\"case\",\n",
    "    values=\"mae_pp\",\n",
    "    aggfunc=\"first\"\n",
    ").sort_index()\n",
    "\n",
    "print(\"\\nPer-fold case MAE (percentage points):\")\n",
    "display(pivot_df)"
   ]
  },
