    "def metrics_df(path, label):\n",
    "    df = pd.read_csv(path)\n",
    "    rows = []\n",
    "    for pred_col in [\"d_phys_real_pct\", \"d_phys_abs_pct\"]:\n",
    "        err = df[pred_col] - df[\"y_fault_location\"]\n",
    "        rows.append({\n",
    "            \"run\": label,\n",
    "            \"pred\": pred_col,\n",
    "            \"MAE\": np.mean(np.abs(err)),\n",
    "            \"RMSE\": np.sqrt(np.mean(err**2)),\n",
    "            \"Bias\": np.mean(err),\n",
    "        })\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "cmp = pd.concat([\n",
    "    metrics_df(\"/home/vault/iwi5/iwi5305h/kol_operator_features_default.csv\", \"default\"),\n",
    "    metrics_df(\"/home/vault/iwi5/iwi5305h/kol_operator_features_opposite.csv\", \"opposite\"),\n",
    "], ignore_index=True)\n",
    "\n",
    "print(cmp.to_string(index=False))"
   ]
