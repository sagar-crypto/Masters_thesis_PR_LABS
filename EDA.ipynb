    "required_files = [\n",
    "    INVENTORY_PATH,\n",
    "    SCHEMA_JSON_PATH,\n",
    "    MANIFEST_PATH,\n",
    "    UNRESOLVED_PATH,\n",
    "    CANDIDATE_PATH,\n",
    "    PATH_REFERENCES_PATH,\n",
    "]\n",
    "\n",
    "missing_files = [\n",
    "    path\n",
    "    for path in required_files\n",
    "    if not path.exists()\n",
    "]\n",
    "\n",
    "if missing_files:\n",
    "    raise FileNotFoundError(\n",
    "        \"The following Notebook 00 outputs are missing:\\n\"\n",
    "        + \"\\n\".join(str(path) for path in missing_files)\n",
    "    )\n",
    "\n",
    "\n",
    "artifact_inventory = pd.read_csv(INVENTORY_PATH)\n",
    "\n",
    "unresolved_original = pd.read_csv(\n",
    "    UNRESOLVED_PATH,\n",
    "    keep_default_na=False,\n",
    ")\n",
    "\n",
    "prediction_candidates = pd.read_csv(\n",
    "    CANDIDATE_PATH,\n",
    "    keep_default_na=False,\n",
    ")\n",
    "\n",
    "path_references = pd.read_csv(\n",
    "    PATH_REFERENCES_PATH,\n",
    "    keep_default_na=False,\n",
    ")\n",
    "\n",
    "with SCHEMA_JSON_PATH.open(\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    schema_records = json.load(file)\n",
    "\n",
    "with MANIFEST_PATH.open(\n",
    "    \"r\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    manifest = json.load(file)\n",
    "\n",
    "\n",
    "schema_by_path = {\n",
    "    record[\"path\"]: record\n",
    "    for record in schema_records\n",
    "}\n",
    "\n",
    "\n",
    "print(\"Original unresolved mappings:\", len(unresolved_original))\n",
    "display(unresolved_original)\n",
    "\n",
    "print(\"\\nTop prediction candidates for unresolved experiments:\")\n",
    "\n",
    "display(\n",
    "    prediction_candidates.loc[\n",
    "        prediction_candidates[\"experiment_id\"].isin(\n",
    "            DOUBLE_EXPERIMENTS\n",
    "        )\n",
    "    ].sort_values(\n",
    "        [\"experiment_id\", \"candidate_rank\"],\n",
    "        kind=\"stable\",\n",
    "    )\n",
    ")"
