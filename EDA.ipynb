    "            \"n_unique_events\": eval_df[\"sample_id\"].nunique(),\n",
    "            \"mae_pp\": eval_df[\"abs_error_pp\"].mean(),\n",
    "            \"median_pp\": eval_df[\"abs_error_pp\"].median(),\n",
    "            \"p90_pp\": eval_df[\"abs_error_pp\"].quantile(0.90),\n",
    "            \"p95_pp\": eval_df[\"abs_error_pp\"].quantile(0.95),\n",
    "            \"max_pp\": eval_df[\"abs_error_pp\"].max(),\n",
    "            \"mean_signed_error_pp\": eval_df[\"signed_error_pp\"].mean(),\n",
    "            \"outside_0_100\": int(\n",
    "                (\n",
    "                    (eval_df[pred_col] < 0.0)\n",
    "                    | (eval_df[pred_col] > 100.0)\n",
    "                ).sum()\n",
    "            ),\n",
    "        }]\n",
    "    )\n",
    "\n",
    "# Compare current-sign +1 and -1 for both protocols.\n",
    "summary_parts = []\n",
