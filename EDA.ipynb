   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "csv_path = \"/home/vault/iwi5/iwi5305h/kol_operator_features_hv_double_line_110kv_both_all_fault_start_mod_takagi_tf_only.csv\"\n",
    "\n",
    "df = pd.read_csv(csv_path)\n",
    "slg = df[df[\"case\"].isin([\"slg_a\", \"slg_b\", \"slg_c\"])].copy()\n",
    "\n",
    "candidate_cols = {\n",
    "    \"old_default\": \"d_phys_real_pct\",\n",
    "    \"takagi_local\": \"d_takagi_local_pct\",\n",
    "    \"remote_flipped\": \"d_takagi_remote_flipped_pct\",\n",
    "    \"both_mean\": \"d_takagi_both_mean_pct\",\n",
    "    \"mod_tf_p_local\": \"d_mod_takagi_tf_only_p_local_pct\",\n",
    "    \"mod_tf_m_local\": \"d_mod_takagi_tf_only_m_local_pct\",\n",
    "    \"mod_tf_p_remote_flipped\": \"d_mod_takagi_tf_only_p_remote_flipped_pct\",\n",
    "    \"mod_tf_m_remote_flipped\": \"d_mod_takagi_tf_only_m_remote_flipped_pct\",\n",
    "    \"mod_tf_p_both_mean\": \"d_mod_takagi_tf_only_p_both_mean_pct\",\n",
    "    \"mod_tf_m_both_mean\": \"d_mod_takagi_tf_only_m_both_mean_pct\",\n",
    "}\n",
    "\n",
    "candidate_cols = {k: v for k, v in candidate_cols.items() if v in slg.columns}\n",
    "\n",
    "rows = []\n",
    "\n",
    "for (line, case), g in slg.groupby([\"y_fault_line\", \"case\"]):\n",
    "    row = {\n",
    "        \"line\": line,\n",
    "        \"case\": case,\n",
    "        \"n\": len(g),\n",
    "    }\n",
    "\n",
    "    y = g[\"y_fault_location\"]\n",
    "\n",
    "    for name, col in candidate_cols.items():\n",
    "        valid = g[col].notna()\n",
    "        if valid.sum() == 0:\n",
    "            row[f\"{name}_mae\"] = np.nan\n",
    "            row[f\"{name}_bias\"] = np.nan\n",
    "        else:\n",
    "            err = g.loc[valid, col] - y.loc[valid]\n",
    "            row[f\"{name}_mae\"] = err.abs().mean()\n",
    "            row[f\"{name}_bias\"] = err.mean()\n",
    "\n",
    "    mae_candidates = {\n",
    "        name: row[f\"{name}_mae\"]\n",
    "        for name in candidate_cols\n",
    "        if pd.notna(row[f\"{name}_mae\"])\n",
    "    }\n",
    "\n",
    "    row[\"best_candidate\"] = min(mae_candidates, key=mae_candidates.get)\n",
    "    row[\"best_mae\"] = mae_candidates[row[\"best_candidate\"]]\n",
    "\n",
    "    rows.append(row)\n",
    "\n",
    "slg_ablation = pd.DataFrame(rows).sort_values([\"line\", \"case\"])\n",
    "display(slg_ablation.round(2))"
   ]
  },
