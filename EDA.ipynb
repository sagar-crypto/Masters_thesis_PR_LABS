    "def experiment_ids_from_values(\n",
    "    values: Iterable[Any],\n",
    ") -> list[str]:\n",
    "    detected: set[str] = set()\n",
    "\n",
    "    compact_values = [\n",
    "        compact_token(value)\n",
    "        for value in values\n",
    "        if value is not None\n",
    "    ]\n",
    "\n",
    "    for experiment_id, experiment_token in (\n",
    "        EXPERIMENT_COMPACT_TOKENS.items()\n",
    "    ):\n",
    "        for value_token in compact_values:\n",
    "            if experiment_token == value_token:\n",
    "                detected.add(experiment_id)\n",
    "                break\n",
    "\n",
    "            # Permit exact experiment token contained in a longer label,\n",
    "            # for example FINAL_C90_1E_OOF.\n",
    "            if experiment_token in value_token:\n",
    "                detected.add(experiment_id)\n",
    "                break\n",
    "\n",
    "    return sorted(detected)\n",
    "\n",
    "\n",
    "def experiments_detected_in_record(\n",
    "    record: dict[str, Any],\n",
    ") -> dict[str, list[str]]:\n",
    "    path = Path(record[\"path\"])\n",
    "\n",
    "    path_matches = experiments_in_path(path)\n",
    "\n",
    "    experiment_probe_values = (\n",
    "        record\n",
    "        .get(\"probe_values\", {})\n",
    "        .get(\"experiment_id\", [])\n",
    "    )\n",
    "\n",
    "    value_matches = experiment_ids_from_values(\n",
    "        experiment_probe_values\n",
    "    )\n",
    "\n",
    "    return {\n",
    "        \"path_matches\": path_matches,\n",
    "        \"value_matches\": value_matches,\n",
    "        \"all_matches\": sorted(\n",
    "            set(path_matches) | set(value_matches)\n",
    "        ),\n",
    "    }\n",
    "\n",
    "\n",
    "for record in schema_records:\n",
    "    detection = experiments_detected_in_record(\n",
    "        record\n",
    "    )\n",
    "\n",
    "    record[\"experiment_detection\"] = detection\n",
    "\n",
    "\n",
    "# Re-save schema JSON with experiment detection included.\n",
    "with schema_json_path.open(\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    json.dump(\n",
    "        schema_records,\n",
    "        file,\n",
    "        indent=2,\n",
    "        ensure_ascii=False,\n",
    "        default=str,\n",
    "    )"
   ]
  },
