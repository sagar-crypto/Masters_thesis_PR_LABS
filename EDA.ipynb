   "source": [
    "def field_status(\n",
    "    record: dict[str, Any],\n",
    "    canonical_field: str,\n",
    ") -> str:\n",
    "    return (\n",
    "        record\n",
    "        .get(\"alias_resolution\", {})\n",
    "        .get(canonical_field, {})\n",
    "        .get(\"status\", \"missing\")\n",
    "    )\n",
    "\n",
    "\n",
    "def field_matches(\n",
    "    record: dict[str, Any],\n",
    "    canonical_field: str,\n",
    ") -> list[str]:\n",
    "    return (\n",
    "        record\n",
    "        .get(\"alias_resolution\", {})\n",
    "        .get(canonical_field, {})\n",
    "        .get(\"matches\", [])\n",
    "    )\n",
    "\n",
    "\n",
    "def resembles_prediction_table(\n",
    "    record: dict[str, Any],\n",
    ") -> bool:\n",
    "    if record.get(\"schema_error\"):\n",
    "        return False\n",
    "\n",
    "    required_basic_fields = [\n",
    "        \"sample_id\",\n",
    "        \"y_true_pct\",\n",
    "        \"y_pred_pct\",\n",
    "    ]\n",
    "\n",
    "    return all(\n",
    "        field_status(record, field) == \"resolved\"\n",
    "        for field in required_basic_fields\n",
    "    )\n",
    "\n",
    "\n",
    "def prediction_candidate_score(\n",
    "    record: dict[str, Any],\n",
    "    experiment_id: str,\n",
    ") -> tuple[int, list[str]]:\n",
    "    score = 0\n",
    "    reasons: list[str] = []\n",
    "\n",
    "    detection = record.get(\n",
    "        \"experiment_detection\",\n",
    "        {},\n",
    "    )\n",
    "\n",
    "    if experiment_id in detection.get(\n",
    "        \"value_matches\",\n",
    "        [],\n",
    "    ):\n",
    "        score += 100\n",
    "        reasons.append(\n",
    "            \"experiment_id found in table values\"\n",
    "        )\n",
    "\n",
    "    if experiment_id in detection.get(\n",
    "        \"path_matches\",\n",
    "        [],\n",
    "    ):\n",
    "        score += 70\n",
    "        reasons.append(\n",
    "            \"experiment_id found in path\"\n",
    "        )\n",
    "\n",
    "    if resembles_prediction_table(record):\n",
    "        score += 30\n",
    "        reasons.append(\n",
    "            \"schema contains sample, target and prediction\"\n",
    "        )\n",
    "\n",
    "    roles = str(\n",
    "        record.get(\"artifact_roles\", \"\")\n",
    "    )\n",
    "\n",
    "    if \"prediction_candidate\" in roles:\n",
    "        score += 15\n",
    "        reasons.append(\n",
    "            \"filename/path classified as prediction candidate\"\n",
    "        )\n",
    "\n",
    "    if \"existing_posthoc_artifact\" in roles:\n",
    "        score += 5\n",
    "        reasons.append(\n",
    "            \"located in existing posthoc directory\"\n",
    "        )\n",
    "\n",
    "    if record.get(\"format\") == \"parquet\":\n",
    "        score += 5\n",
    "        reasons.append(\"Parquet artifact\")\n",
    "\n",
    "    return score, reasons"
   ]
  },
