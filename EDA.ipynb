   "source": [
    "resolution_messages: list[dict[str, Any]] = []\n",
    "\n",
    "\n",
    "for experiment_id in DOUBLE_EXPERIMENTS:\n",
    "    evidence = double_detection.loc[\n",
    "        double_detection[\"experiment_id\"] == experiment_id\n",
    "    ].copy()\n",
    "\n",
    "    value_evidence = evidence.loc[\n",
    "        evidence[\"evidence_type\"] == \"column_value\"\n",
    "    ]\n",
    "\n",
    "    path_evidence = evidence.loc[\n",
    "        evidence[\"evidence_type\"] == \"file_path\"\n",
    "    ]\n",
    "\n",
    "    selected_path = None\n",
    "    row_filter = None\n",
    "    resolution_status = \"unresolved\"\n",
    "\n",
    "    # Strongest evidence:\n",
    "    # exact experiment token stored in a table column.\n",
    "    if not value_evidence.empty:\n",
    "        unique_paths = sorted(\n",
    "            value_evidence[\"path\"].unique()\n",
    "        )\n",
    "\n",
    "        if len(unique_paths) == 1:\n",
    "            selected_path = unique_paths[0]\n",
    "\n",
    "            selected_evidence = value_evidence.loc[\n",
    "                value_evidence[\"path\"] == selected_path\n",
    "            ]\n",
    "\n",
    "            unique_columns = sorted(\n",
    "                selected_evidence[\n",
    "                    \"evidence_column\"\n",
    "                ].unique()\n",
    "            )\n",
    "\n",
    "            if len(unique_columns) == 1:\n",
    "                filter_column = unique_columns[0]\n",
    "\n",
    "                raw_matching_values = []\n",
    "\n",
    "                for value_json in selected_evidence[\n",
    "                    \"matching_values\"\n",
    "                ]:\n",
    "                    raw_matching_values.extend(\n",
    "                        json.loads(value_json)\n",
    "                    )\n",
    "\n",
    "                raw_matching_values = list(\n",
    "                    dict.fromkeys(raw_matching_values)\n",
    "                )\n",
    "\n",
    "                if len(raw_matching_values) == 1:\n",
    "                    row_filter = {\n",
    "                        \"column\": filter_column,\n",
    "                        \"operator\": \"equals\",\n",
    "                        \"value\": raw_matching_values[0],\n",
    "                    }\n",
    "                    resolution_status = (\n",
    "                        \"resolved_from_table_value\"\n",
    "                    )\n",
    "\n",
    "                else:\n",
    "                    resolution_status = (\n",
    "                        \"ambiguous_multiple_filter_values\"\n",
    "                    )\n",
    "\n",
    "            else:\n",
    "                resolution_status = (\n",
    "                    \"ambiguous_multiple_experiment_columns\"\n",
    "                )\n",
    "\n",
    "        else:\n",
    "            resolution_status = (\n",
    "                \"ambiguous_multiple_value_evidence_files\"\n",
    "            )\n",
    "\n",
    "    # Secondary evidence:\n",
    "    # experiment identifier embedded in a per-experiment path.\n",
    "    elif not path_evidence.empty:\n",
    "        unique_paths = sorted(\n",
    "            path_evidence[\"path\"].unique()\n",
    "        )\n",
    "\n",
    "        if len(unique_paths) == 1:\n",
    "            selected_path = unique_paths[0]\n",
    "            row_filter = None\n",
    "            resolution_status = \"resolved_from_file_path\"\n",
    "        else:\n",
    "            resolution_status = (\n",
    "                \"ambiguous_multiple_path_evidence_files\"\n",
    "            )\n",
    "\n",
    "    manifest[\"experiments\"][experiment_id][\n",
    "        \"selected_prediction_artifact\"\n",
    "    ] = selected_path\n",
    "\n",
    "    manifest[\"experiments\"][experiment_id][\n",
    "        \"prediction_selection_status\"\n",
    "    ] = resolution_status\n",
    "\n",
    "    manifest[\"experiments\"][experiment_id][\n",
    "        \"prediction_row_filter\"\n",
    "    ] = row_filter\n",
    "\n",
    "    resolution_messages.append(\n",
    "        {\n",
    "            \"experiment_id\": experiment_id,\n",
    "            \"status\": resolution_status,\n",
    "            \"selected_path\": selected_path,\n",
    "            \"row_filter\": json.dumps(\n",
    "                row_filter,\n",
    "                ensure_ascii=False,\n",
    "                default=str,\n",
    "            )\n",
    "            if row_filter is not None\n",
    "            else \"\",\n",
    "            \"value_evidence_file_count\": int(\n",
    "                value_evidence[\"path\"].nunique()\n",
    "            ),\n",
    "            \"path_evidence_file_count\": int(\n",
    "                path_evidence[\"path\"].nunique()\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "double_prediction_resolution = pd.DataFrame(\n",
    "    resolution_messages\n",
    ")\n",
    "\n",
    "display(double_prediction_resolution)"
   ]
  },
