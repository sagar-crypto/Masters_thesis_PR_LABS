   "source": [
    "rows = []\n",
    "\n",
    "for (line, case), g in df4.groupby([line_col, case_col]):\n",
    "    row = {\n",
    "        \"line\": line,\n",
    "        \"case\": case,\n",
    "        \"n\": len(g),\n",
    "    }\n",
    "\n",
    "    prior_maes = {}\n",
    "\n",
    "    for name, col in available_priors.items():\n",
    "        mae = 100 * (g[target_col] - g[col]).abs().mean()\n",
    "        bias = 100 * (g[col] - g[target_col]).mean()\n",
    "\n",
    "        row[f\"{name}_mae_pp\"] = mae\n",
    "        row[f\"{name}_bias_pp\"] = bias\n",
    "        prior_maes[name] = mae\n",
    "\n",
    "    best_name = min(prior_maes, key=prior_maes.get)\n",
    "    row[\"best_prior\"] = best_name\n",
    "    row[\"best_prior_mae_pp\"] = prior_maes[best_name]\n",
    "\n",
    "    if \"selected_caseaware\" in prior_maes:\n",
    "        row[\"selected_gap_to_best_pp\"] = (\n",
    "            prior_maes[\"selected_caseaware\"] - prior_maes[best_name]\n",
    "        )\n",
    "\n",
    "    rows.append(row)\n",
    "\n",
    "line_case_prior_summary = pd.DataFrame(rows)\n",
    "\n",
    "line_case_prior_summary = line_case_prior_summary.sort_values(\n",
    "    [\"line\", \"selected_gap_to_best_pp\"],\n",
    "    ascending=[True, False],\n",
    ")\n",
    "\n",
    "cols_to_show = [\n",
    "    \"line\",\n",
    "    \"case\",\n",
    "    \"n\",\n",
    "    \"old_mae_pp\",\n",
    "    \"takagi_local_mae_pp\",\n",
    "    \"takagi_remote_flipped_mae_pp\",\n",
    "    \"takagi_both_mean_mae_pp\",\n",
    "    \"selected_caseaware_mae_pp\",\n",
    "    \"best_prior\",\n",
    "    \"best_prior_mae_pp\",\n",
    "    \"selected_gap_to_best_pp\",\n",
    "]\n",
    "\n",
    "cols_to_show = [c for c in cols_to_show if c in line_case_prior_summary.columns]\n",
    "\n",
    "line_case_prior_summary[cols_to_show].round(2)"
   ]
  },
