    "    experiment_id: str,\n",
    "    run_root: Path,\n",
    ") -> list[Path]:\n",
    "    experiment_root = run_root / experiment_id\n",
    "\n",
    "    if not experiment_root.exists():\n",
    "        return []\n",
    "\n",
    "    return sorted(\n",
