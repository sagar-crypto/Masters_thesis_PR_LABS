    "def discover_files(root: Path) -> list[Path]:\n",
    "    discovered: list[Path] = []\n",
    "\n",
    "    def handle_walk_error(error: OSError) -> None:\n",
    "        warnings.warn(f\"Filesystem walk error: {error}\")\n",
    "\n",
    "    for current_root, directory_names, filenames in os.walk(\n",
    "        root,\n",
    "        topdown=True,\n",
    "        followlinks=False,\n",
    "        onerror=handle_walk_error,\n",
    "    ):\n",
    "        directory_names[:] = [\n",
    "            directory_name\n",
    "            for directory_name in directory_names\n",
    "            if directory_name not in EXCLUDED_DIRECTORY_NAMES\n",
    "        ]\n",
    "\n",
    "        current_path = Path(current_root)\n",
    "\n",
    "        for filename in filenames:\n",
    "            path = current_path / filename\n",
    "\n",
    "            if path.suffix.lower() not in INVENTORY_SUFFIXES:\n",
    "                continue\n",
    "\n",
    "            if is_excluded_path(path):\n",
    "                continue\n",
    "\n",
    "            discovered.append(path)\n",
    "\n",
    "    return sorted(set(discovered))\n",
    "\n",
    "\n",
    "chapter4_files = discover_files(CHAPTER4_ROOT)\n",
    "\n",
    "print(f\"Discovered {len(chapter4_files):,} candidate files.\")\n",
    "\n",
    "\n",
    "inventory_rows: list[dict[str, Any]] = []\n",
    "\n",
    "for path in chapter4_files:\n",
    "    try:\n",
    "        stat = path.stat()\n",
    "\n",
    "        inventory_rows.append(\n",
    "            {\n",
    "                \"root_label\": determine_root_label(path),\n",
    "                \"path\": str(path),\n",
    "                \"filename\": path.name,\n",
    "                \"suffix\": path.suffix.lower(),\n",
    "                \"size_bytes\": int(stat.st_size),\n",
    "                \"modified_utc\": utc_timestamp(stat.st_mtime),\n",
    "                \"artifact_roles\": \"|\".join(classify_artifact(path)),\n",
    "                \"experiment_tokens_in_path\": \"|\".join(\n",
    "                    experiments_in_path(path)\n",
    "                ),\n",
    "            }\n",
    "        )\n",
    "\n",
    "    except (FileNotFoundError, PermissionError, OSError) as exc:\n",
    "        inventory_rows.append(\n",
    "            {\n",
    "                \"root_label\": determine_root_label(path),\n",
    "                \"path\": str(path),\n",
    "                \"filename\": path.name,\n",
    "                \"suffix\": path.suffix.lower(),\n",
    "                \"size_bytes\": np.nan,\n",
    "                \"modified_utc\": None,\n",
    "                \"artifact_roles\": \"filesystem_error\",\n",
    "                \"experiment_tokens_in_path\": \"\",\n",
    "                \"inventory_error\": repr(exc),\n",
    "            }\n",
    "        )\n",
    "\n",
    "\n",
    "artifact_inventory = pd.DataFrame(inventory_rows)\n",
    "\n",
