    "from pathlib import Path\n",
    "import pandas as pd\n",
    "\n",
    "# --- set this to your run directory ---\n",
    "run_dir = Path(\n",
    "    \"/home/hpc/iwi5/iwi5305h/Masters_thesis_PR_LABS/outputs/MainLn1-2A__kol_operator_features_hv_double_line_110kv_both_i0res_seq_bothfix__ground_only_mul__single_fault_start__run_2026-04-10T19:46:56.083074Z\"\n",
    ")\n",
    "\n",
    "# Find all metrics_by_case.csv files under the run folder\n",
    "csv_files = sorted(run_dir.rglob(\"metrics_by_case.csv\"))\n",
    "\n",
    "print(f\"Found {len(csv_files)} metrics_by_case.csv files\")\n",
    "for f in csv_files:\n",
    "    print(f)\n",
    "\n",
    "rows = []\n",
    "for f in csv_files:\n",
    "    df = pd.read_csv(f).copy()\n",
    "\n",
    "    # try to infer fold from parent path or filename\n",
    "    fold = None\n",
    "    parts = f.parts\n",
    "    for p in parts:\n",
    "        if p.startswith(\"fold\"):\n",
    "            fold = p\n",
    "            break\n",
    "\n",
    "    if fold is None:\n",
    "        # fallback: use incremental index later if needed\n",
    "        fold = f\"unknown_{len(rows)}\"\n",
    "\n",
    "    df[\"fold\"] = fold\n",
    "    df[\"source_file\"] = str(f)\n",
    "    rows.append(df)\n",
    "\n",
    "all_cases = pd.concat(rows, ignore_index=True)\n",
    "\n",
    "# reorder columns a bit\n",
    "preferred_cols = [\n",
    "    \"fold\", \"case\", \"support\",\n",
    "    \"mae_pp\", \"rmse_pp\", \"bias_pp\", \"median_ae_pp\",\n",
    "    \"mae_rel\", \"rmse_rel\", \"bias_rel\", \"median_ae_rel\",\n",
    "]\n",
    "existing_cols = [c for c in preferred_cols if c in all_cases.columns]\n",
    "other_cols = [c for c in all_cases.columns if c not in existing_cols]\n",
    "all_cases = all_cases[existing_cols + other_cols]\n",
    "\n",
    "print(\"\\nCombined table:\")\n",
    "display(all_cases.sort_values([\"fold\", \"mae_pp\"], ascending=[True, False]).reset_index(drop=True))"
   ]
