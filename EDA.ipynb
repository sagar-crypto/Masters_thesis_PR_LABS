    "def should_inspect_schema(row: pd.Series) -> bool:\n",
    "    suffix = str(row[\"suffix\"]).lower()\n",
    "    roles = str(row[\"artifact_roles\"])\n",
    "\n",
    "    if suffix == \".parquet\":\n",
    "        return True\n",
    "\n",
    "    if suffix != \".csv\":\n",
    "        return False\n",
    "\n",
    "    important_role = any(\n",
    "        role in roles\n",
    "        for role in [\n",
    "            \"prediction_candidate\",\n",
    "            \"model_input_candidate\",\n",
    "            \"physics_or_prior_candidate\",\n",
    "            \"raw_physics_candidate\",\n",
    "            \"fold_or_split_candidate\",\n",
    "            \"existing_posthoc_artifact\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    filename = normalize_name(row[\"filename\"])\n",
    "\n",
    "    important_name = any(\n",
    "        keyword in filename\n",
    "        for keyword in [\n",
    "            \"prediction\",\n",
    "            \"oof\",\n",
    "            \"prior\",\n",
    "            \"physics\",\n",
    "            \"fold\",\n",
    "            \"split\",\n",
    "            \"mapping\",\n",
    "            \"metric\",\n",
    "            \"input\",\n",
    "            \"status\",\n",
    "            \"audit\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    return important_role or important_name\n",
    "\n",
    "\n",
    "schema_candidate_inventory = artifact_inventory.loc[\n",
    "    artifact_inventory.apply(\n",
    "        should_inspect_schema,\n",
    "        axis=1,\n",
    "    )\n",
    "].copy()\n",
    "\n",
    "print(\n",
    "    \"Files selected for schema inspection:\",\n",
    "    len(schema_candidate_inventory),\n",
    ")\n",
    "\n",
    "display(\n",
    "    schema_candidate_inventory[\n",
    "        [\n",
    "            \"root_label\",\n",
    "            \"path\",\n",
    "            \"suffix\",\n",
    "            \"artifact_roles\",\n",
    "        ]\n",
    "    ].head(100)\n",
    ")"
   ]
