   "source": [
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "csv_path = Path(\n",
    "    \"/home/vault/iwi5/iwi5305h/\"\n",
    "    \"kol_operator_features_hv_double_line_110kv_line_caseaware_mod_takagi_tf_only_prior_filled.csv\"\n",
    ")\n",
    "\n",
    "line = \"MainLn1-2A\"\n",
    "\n",
    "df = pd.read_csv(csv_path, low_memory=False)\n",
    "\n",
    "diag = df.loc[\n",
    "    (df[\"y_fault_line\"] == line)\n",
    "    & (df[\"status\"] == \"fault_start\")\n",
    "].copy()\n",
    "\n",
    "diag = (\n",
    "    diag.sort_values([\"sample_id\", \"window_idx\"])\n",
    "    .drop_duplicates(subset=[\"sample_id\"], keep=\"first\")\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "cols = [\n",
    "    \"y_fault_location\",\n",
    "    \"d_mod_takagi_tf_only_p_local_pct\",\n",
    "    \"d_mod_takagi_tf_only_p_remote_pct\",\n",
    "    \"d_mod_takagi_tf_only_p_remote_flipped_pct\",\n",
    "    \"d_mod_takagi_tf_only_p_both_mean_pct\",\n",
    "]\n",
    "\n",
    "for col in cols:\n",
    "    diag[col] = pd.to_numeric(diag[col], errors=\"coerce\")\n",
    "\n",
    "diag[\"reconstructed_both_mean\"] = 0.5 * (\n",
    "    diag[\"d_mod_takagi_tf_only_p_local_pct\"]\n",
    "    + diag[\"d_mod_takagi_tf_only_p_remote_flipped_pct\"]\n",
    ")\n",
    "\n",
    "diag[\"is_exact_50\"] = np.isclose(\n",
    "    diag[\"d_mod_takagi_tf_only_p_both_mean_pct\"],\n",
    "    50.0,\n",
