    "    \"manifest_version\": \"chapter4_posthoc_final_v1\",\n",
    "    \"generated_utc\": datetime.now(\n",
    "        timezone.utc\n",
    "    ).isoformat(),\n",
    "    \"prediction_mode\": \"threeph_add_ground_mul\",\n",
    "    \"final_output_directory\": str(FINAL_DIR),\n",
    "    \"canonical_columns\": CANONICAL_COLUMNS,\n",
    "    \"experiments\": {},\n",
    "}\n",
    "\n",
    "\n",
    "final_mapping_rows = []\n",
    "\n",
    "\n",
    "for experiment_id, config in EXPERIMENTS.items():\n",
    "    prediction_path = Path(\n",
    "        config[\"prediction_path\"]\n",
    "    )\n",
    "\n",
    "    diagnostic_row = (\n",
    "        diagnostic_availability.loc[\n",
    "            diagnostic_availability[\n",
    "                \"experiment_id\"\n",
    "            ] == experiment_id\n",
    "        ].iloc[0]\n",
    "    )\n",
    "\n",
    "    prior_audit_row = (\n",
    "        prior_provenance_audit.loc[\n",
    "            prior_provenance_audit[\n",
    "                \"experiment_id\"\n",
    "            ] == experiment_id\n",
    "        ].iloc[0]\n",
    "    )\n",
    "\n",
    "    manifest_entry = {\n",
    "        \"experiment_id\": experiment_id,\n",
    "        \"topology\": config[\"topology\"],\n",
    "        \"prior_view\": config[\"prior_view\"],\n",
    "        \"model_family\": config[\"model_family\"],\n",
    "\n",
    "        # Compatibility with earlier manifests\n",
    "        \"selected_prediction_artifact\": str(\n",
    "            prediction_path\n",
    "        ),\n",
    "        \"prediction_selection_status\": (\n",
    "            \"resolved_direct_experiment_id\"\n",
    "        ),\n",
    "        \"prediction_row_filter\": {\n",
    "            \"column\": \"experiment_id\",\n",
    "            \"operator\": \"equals\",\n",
    "            \"value\": experiment_id,\n",
    "        },\n",
    "        \"prediction_row_filters\": [\n",
    "            {\n",
    "                \"column\": \"experiment_id\",\n",
    "                \"operator\": \"equals\",\n",
    "                \"value\": experiment_id,\n",
    "            }\n",
    "        ],\n",
    "\n",
    "        \"canonical_columns\": CANONICAL_COLUMNS,\n",
    "\n",
    "        \"expected_cohort\": {\n",
    "            \"rows\": config[\"expected_rows\"],\n",
    "            \"events\": config[\"expected_events\"],\n",
    "            \"windows_per_event\": (\n",
    "                config[\"expected_windows_per_event\"]\n",
    "            ),\n",
    "        },\n",
    "\n",
    "        \"matched_prior\": {\n",
    "            \"status\": (\n",
    "                \"resolved_and_numerically_verified\"\n",
    "            ),\n",
    "            \"oof_column\": \"prior_pp\",\n",
    "            \"source_type\": (\n",
    "                \"original_model_input_csv\"\n",
    "            ),\n",
    "            \"source_path\": str(\n",
    "                config[\"model_input_path\"]\n",
    "            ),\n",
    "            \"column\": (\n",
    "                config[\n",
    "                    \"model_input_prior_column\"\n",
    "                ]\n",
    "            ),\n",
    "            \"join_keys\": [\n",
    "                \"sample_id\",\n",
    "                \"window_idx\",\n",
    "            ],\n",
    "            \"join_keys_status\": (\n",
    "                \"verified_one_to_one\"\n",
    "            ),\n",
    "            \"maximum_absolute_difference\": (\n",
    "                float(\n",
    "                    prior_audit_row[\n",
    "                        \"maximum_absolute_difference\"\n",
    "                    ]\n",
    "                )\n",
    "            ),\n",
    "            \"tolerance\": VALUE_TOLERANCE,\n",
    "        },\n",
    "\n",
    "        \"optional_internal_diagnostics\": {\n",
    "            \"alpha_source\": (\n",
    "                diagnostic_row[\"alpha_source\"]\n",
    "            ),\n",
    "            \"residual_source\": (\n",
    "                diagnostic_row[\"residual_source\"]\n",
    "            ),\n",
    "            \"per_fold_prediction_files\": (\n",
    "                json.loads(\n",
    "                    diagnostic_row[\n",
    "                        \"per_fold_files\"\n",
    "                    ]\n",
    "                )\n",
    "            ),\n",
    "        },\n",
    "    }\n",
    "\n",
    "    manifest[\"experiments\"][\n",
    "        experiment_id\n",
    "    ] = manifest_entry\n",
    "\n",
    "    final_mapping_rows.append(\n",
    "        {\n",
    "            \"experiment_id\": experiment_id,\n",
    "            \"topology\": config[\"topology\"],\n",
    "            \"prior_view\": config[\"prior_view\"],\n",
    "            \"model_family\": config[\"model_family\"],\n",
    "            \"prediction_path\": str(\n",
    "                prediction_path\n",
    "            ),\n",
    "            \"prediction_filter_column\": (\n",
    "                \"experiment_id\"\n",
    "            ),\n",
    "            \"prediction_filter_value\": (\n",
    "                experiment_id\n",
    "            ),\n",
    "            \"sample_id_column\": \"sample_id\",\n",
    "            \"fold_column\": \"fold\",\n",
    "            \"target_column\": \"y_true_pp\",\n",
    "            \"prediction_column\": \"y_pred_pp\",\n",
    "            \"saved_prior_column\": \"prior_pp\",\n",
    "            \"model_input_path\": str(\n",
    "                config[\"model_input_path\"]\n",
    "            ),\n",
    "            \"model_input_prior_column\": (\n",
    "                config[\n",
    "                    \"model_input_prior_column\"\n",
    "                ]\n",
    "            ),\n",
    "            \"fault_line_column\": \"y_fault_line\",\n",
    "            \"case_column\": \"case\",\n",
    "            \"event_type_column\": \"event_type\",\n",
    "            \"window_idx_column\": \"window_idx\",\n",
    "            \"alpha_source\": (\n",
    "                diagnostic_row[\"alpha_source\"]\n",
    "            ),\n",
    "            \"residual_source\": (\n",
    "                diagnostic_row[\"residual_source\"]\n",
    "            ),\n",
    "            \"mapping_status\": (\n",
    "                \"resolved_and_verified\"\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "final_mapping_table = pd.DataFrame(\n",
    "    final_mapping_rows\n",
    ")\n",
    "\n",
    "final_mapping_table.to_csv(\n",
    "    FINAL_MAPPING_PATH,\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "with FINAL_MANIFEST_PATH.open(\n",
    "    \"w\",\n",
    "    encoding=\"utf-8\",\n",
    ") as file:\n",
    "    json.dump(\n",
    "        manifest,\n",
    "        file,\n",
    "        indent=2,\n",
    "        ensure_ascii=False,\n",
    "        default=str,\n",
    "    )\n",
    "\n",
    "\n",
    "display(final_mapping_table)\n",
    "\n",
    "print(\"Saved:\", FINAL_MAPPING_PATH)\n",
    "print(\"Saved:\", FINAL_MANIFEST_PATH)"
   ]
  },
