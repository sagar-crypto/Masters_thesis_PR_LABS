    "prior_resolution_rows = []\n",
    "\n",
    "\n",
    "for experiment_id, experiment_info in EXPERIMENTS.items():\n",
    "    entry = manifest[\"experiments\"][experiment_id]\n",
    "\n",
    "    prediction_path = entry.get(\n",
    "        \"selected_prediction_artifact\"\n",
    "    )\n",
    "\n",
    "    prediction_row_filter = entry.get(\n",
    "        \"prediction_row_filter\"\n",
    "    )\n",
    "\n",
    "    prior_source_path = None\n",
    "    prior_column = None\n",
    "    prior_source_type = None\n",
    "    prior_status = \"unresolved\"\n",
    "\n",
    "    experiment_candidates = prior_candidates.loc[\n",
    "        prior_candidates[\"experiment_id\"]\n",
    "        == experiment_id\n",
    "    ].copy()\n",
    "\n",
    "    # -------------------------------------------------------------\n",
    "    # First preference: exact prior is already in prediction table\n",
    "    # -------------------------------------------------------------\n",
    "\n",
    "    prediction_candidates_for_prior = (\n",
    "        experiment_candidates.loc[\n",
    "            experiment_candidates[\n",
    "                \"candidate_type\"\n",
    "            ] == \"prediction_table\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    if len(prediction_candidates_for_prior) == 1:\n",
    "        row = prediction_candidates_for_prior.iloc[0]\n",
    "\n",
    "        matches = [\n",
    "            value\n",
    "            for value in str(\n",
    "                row[\"exact_prior_matches\"]\n",
    "            ).split(\"|\")\n",
    "            if value\n",
    "        ]\n",
    "\n",
    "        # For two-ended runs, prefer the explicitly documented column.\n",
    "        if (\n",
    "            experiment_info[\"prior_view\"] == \"2E\"\n",
    "            and KNOWN_TWO_ENDED_PRIOR in matches\n",
    "        ):\n",
    "            prior_source_path = row[\"path\"]\n",
    "            prior_column = KNOWN_TWO_ENDED_PRIOR\n",
    "            prior_source_type = \"prediction_table\"\n",
    "            prior_status = (\n",
    "                \"resolved_exact_documented_column\"\n",
    "            )\n",
    "\n",
    "        elif len(matches) == 1:\n",
    "            prior_source_path = row[\"path\"]\n",
    "            prior_column = matches[0]\n",
    "            prior_source_type = \"prediction_table\"\n",
    "            prior_status = (\n",
    "                \"resolved_single_exact_alias\"\n",
    "            )\n",
    "\n",
    "        elif len(matches) > 1:\n",
    "            prior_status = (\n",
    "                \"ambiguous_multiple_prediction_prior_columns\"\n",
    "            )\n",
    "\n",
    "    # -------------------------------------------------------------\n",
    "    # Second preference: input file explicitly referenced by this run\n",
    "    # -------------------------------------------------------------\n",
    "\n",
    "    if prior_source_path is None:\n",
    "        referenced_candidates = (\n",
    "            experiment_candidates.loc[\n",
    "                experiment_candidates[\n",
    "                    \"candidate_type\"\n",
    "                ]\n",
    "                == \"experiment_referenced_data_file\"\n",
    "            ].copy()\n",
    "        )\n",
    "\n",
    "        expected_rows = experiment_info[\n",
    "            \"expected_rows\"\n",
    "        ]\n",
    "\n",
    "        referenced_candidates = (\n",
    "            referenced_candidates.loc[\n",
    "                referenced_candidates[\"row_count\"]\n",
    "                == expected_rows\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        candidate_resolutions = []\n",
    "\n",
    "        for _, row in referenced_candidates.iterrows():\n",
    "            matches = [\n",
    "                value\n",
    "                for value in str(\n",
    "                    row[\"exact_prior_matches\"]\n",
    "                ).split(\"|\")\n",
    "                if value\n",
    "            ]\n",
    "\n",
    "            if (\n",
    "                experiment_info[\"prior_view\"] == \"2E\"\n",
    "                and KNOWN_TWO_ENDED_PRIOR in matches\n",
    "            ):\n",
    "                candidate_resolutions.append(\n",
    "                    {\n",
    "                        \"path\": row[\"path\"],\n",
    "                        \"column\": KNOWN_TWO_ENDED_PRIOR,\n",
    "                        \"source\": (\n",
    "                            row[\"source_log_or_config\"]\n",
    "                        ),\n",
    "                    }\n",
    "                )\n",
    "\n",
    "            elif len(matches) == 1:\n",
    "                candidate_resolutions.append(\n",
    "                    {\n",
    "                        \"path\": row[\"path\"],\n",
    "                        \"column\": matches[0],\n",
    "                        \"source\": (\n",
    "                            row[\"source_log_or_config\"]\n",
    "                        ),\n",
    "                    }\n",
    "                )\n",
    "\n",
    "        candidate_resolutions = [\n",
    "            dict(item)\n",
    "            for item in {\n",
    "                (\n",
    "                    item[\"path\"],\n",
    "                    item[\"column\"],\n",
    "                    item[\"source\"],\n",
    "                ): item\n",
    "                for item in candidate_resolutions\n",
    "            }.values()\n",
    "        ]\n",
    "\n",
    "        unique_path_column_pairs = {\n",
    "            (\n",
    "                item[\"path\"],\n",
    "                item[\"column\"],\n",
    "            )\n",
    "            for item in candidate_resolutions\n",
    "        }\n",
    "\n",
    "        if len(unique_path_column_pairs) == 1:\n",
    "            selected_pair = next(\n",
    "                iter(unique_path_column_pairs)\n",
    "            )\n",
    "\n",
    "            prior_source_path = selected_pair[0]\n",
    "            prior_column = selected_pair[1]\n",
    "            prior_source_type = (\n",
    "                \"experiment_referenced_model_input\"\n",
    "            )\n",
    "            prior_status = (\n",
    "                \"resolved_from_experiment_metadata\"\n",
    "            )\n",
    "\n",
    "        elif len(unique_path_column_pairs) > 1:\n",
    "            prior_status = (\n",
    "                \"ambiguous_multiple_referenced_prior_sources\"\n",
    "            )\n",
    "\n",
    "    entry[\"matched_prior\"] = {\n",
    "        \"status\": prior_status,\n",
    "        \"source_type\": prior_source_type,\n",
    "        \"source_path\": prior_source_path,\n",
    "        \"column\": prior_column,\n",
    "        \"prediction_row_filter\": prediction_row_filter,\n",
    "        \"join_keys\": None,\n",
    "        \"join_keys_status\": (\n",
    "            \"not_required_same_table\"\n",
    "            if (\n",
    "                prior_source_path is not None\n",
    "                and prediction_path is not None\n",
    "                and Path(prior_source_path)\n",
    "                == Path(prediction_path)\n",
    "            )\n",
    "            else \"to_be_verified_in_integrity_audit\"\n",
    "        ),\n",
    "    }\n",
    "\n",
    "    prior_resolution_rows.append(\n",
    "        {\n",
    "            \"experiment_id\": experiment_id,\n",
    "            \"status\": prior_status,\n",
    "            \"source_type\": prior_source_type,\n",
    "            \"source_path\": prior_source_path,\n",
    "            \"prior_column\": prior_column,\n",
    "            \"prediction_path\": prediction_path,\n",
    "            \"same_as_prediction_table\": (\n",
    "                prior_source_path is not None\n",
    "                and prediction_path is not None\n",
    "                and Path(prior_source_path)\n",
    "                == Path(prediction_path)\n",
    "            ),\n",
    "        }\n",
    "    )\n",
    "\n",
    "\n",
    "prior_resolution = pd.DataFrame(\n",
    "    prior_resolution_rows\n",
    ")\n",
    "\n",
    "display(prior_resolution)"
   ]
